diff --git a/src/inputactivation.h b/src/inputactivation.h
new file mode 100644
index 0000000000000000000000000000000000000000..9b2274cea5687512564a1d66e72c2c2dd9a033b7
--- /dev/null
+++ b/src/inputactivation.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "laptop/protocol.h"
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <functional>
+#include <unistd.h>
+
+namespace UkeKeyboard {
+// Ask the actual compositor parent, never an arbitrary session-bus owner.
+// Input context activation alone does not identify the triggering device.
+inline void requestTouchActivation(QObject *context, std::function<void(bool)> completed)
+{
+    auto bus = QDBusConnection::sessionBus();
+    auto *interface = bus.interface();
+    if (!interface) { completed(false); return; }
+    const auto owner = interface->serviceOwner(QLatin1String(service));
+    if (!owner.isValid() || owner.value().isEmpty()) { completed(false); return; }
+    const auto pid = interface->servicePid(owner.value());
+    if (!pid.isValid() || pid.value() != uint(getppid())) { completed(false); return; }
+    auto request = QDBusMessage::createMethodCall(owner.value(), QLatin1String(path),
+        QLatin1String(UkeKeyboard::interface), QStringLiteral("TouchActivationAllowed"));
+    request.setAutoStartService(false);
+    auto *watcher = new QDBusPendingCallWatcher(bus.asyncCall(request), context);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, context,
+        [completed = std::move(completed)](auto *call) {
+            QDBusPendingReply<bool> reply = *call;
+            call->deleteLater();
+            completed(!reply.isError() && reply.value());
+        });
+}
+}
diff --git a/src/inputcontentpolicy.h b/src/inputcontentpolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..4c66c3bb4c577d06deff13df8ca79c7bc313b2e9
--- /dev/null
+++ b/src/inputcontentpolicy.h
@@ -0,0 +1,34 @@
+/*
+    SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#pragma once
+
+#include "inputplugin.h"
+
+namespace InputContentPolicy
+{
+inline bool sensitive(InputPlugin::ContentHint hint, InputPlugin::ContentPurpose purpose)
+{
+    return (hint & (InputPlugin::content_hint_hidden_text | InputPlugin::content_hint_sensitive_data)) || purpose == InputPlugin::content_purpose_password;
+}
+
+// New contexts are untrusted until the compositor supplies their content type.
+// This check must precede reading/extracting text, not just showing candidates.
+inline bool predictionsAllowed(bool hasContext, bool contentTypeKnown, InputPlugin::ContentHint hint, InputPlugin::ContentPurpose purpose)
+{
+    return hasContext && contentTypeKnown && !sensitive(hint, purpose);
+}
+
+inline Qt::InputMethodHints privacyHints(InputPlugin::ContentHint hint, InputPlugin::ContentPurpose purpose)
+{
+    Qt::InputMethodHints result;
+    if (sensitive(hint, purpose)) {
+        result |= Qt::ImhSensitiveData | Qt::ImhNoPredictiveText | Qt::ImhNoAutoUppercase;
+    }
+    if ((hint & InputPlugin::content_hint_hidden_text) || purpose == InputPlugin::content_purpose_password) {
+        result |= Qt::ImhHiddenText;
+    }
+    return result;
+}
+}
