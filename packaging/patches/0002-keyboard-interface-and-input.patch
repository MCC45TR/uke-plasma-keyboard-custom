+                startKey = null;
+                return;
+            }
+            const trace = points;
+            dragging = false;
+            points = [];
+            trailPoints = [];
+            startKey = null;
+            swipeTrail.requestPaint();
+
+            if (trace.length < 3) {
+                return;
+            }
