+        function buildKeyMap() {
+            const map = [];
+            const keyboard = inputPanel.keyboard;
+            if (!keyboard) {
+                return map;
+            }
+            const stack = [keyboard];
+            while (stack.length > 0) {
+                const item = stack.pop();
+                for (let i = 0; i < item.children.length; i++) {
+                    stack.push(item.children[i]);
+                }
