+        }
+    }
+    SwipeController {
+        id: swipeController
+    }
+
+    Canvas {
+        id: swipeTrail
+        anchors.fill: parent
+        z: 2000
+        visible: swipeInput.dragging
+        onPaint: {
+            const ctx = getContext("2d");
+            ctx.clearRect(0, 0, width, height);
