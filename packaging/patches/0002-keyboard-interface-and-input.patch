diff --git a/src/restartwatcher.cpp b/src/restartwatcher.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..32f4fc4783c6046c545261cc2e567011756f553c
--- /dev/null
+++ b/src/restartwatcher.cpp
@@ -0,0 +1,232 @@
+/*
+    SPDX-FileCopyrightText: 2026 Plasma Keyboard contributors
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "restartwatcher.h"
+#include "logging.h"
+
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+#include <QCoreApplication>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusVariant>
+#include <QFile>
+#include <QGuiApplication>
+#include <QInputMethod>
+#include <QFileInfo>
+#include <QLockFile>
+#include <QProcess>
+#include <QStandardPaths>
+#include <QThread>
+#include <QTimer>
+#include <QFileSystemWatcher>
+#include <QSocketNotifier>
+#include <QDBusServiceWatcher>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <memory>
+
+namespace
+{
+//! How often the installed binary is compared with the one this process runs.
+
+//! Time KWin gets to tear the old input method down before starting a new one.
+constexpr int s_kwinRestartDelayMs = 1000;
+//! Longest the restart is postponed while the keyboard is on screen.
+constexpr int s_maxDeferMs = 2 * 60 * 1000;
+
+QString kwinInputMethod()
+{
+    auto config=KSharedConfig::openConfig(QStringLiteral("kwinrc"));
+    config->reparseConfiguration();
+    const KConfigGroup group(config, QStringLiteral("Wayland"));
+    return group.readEntry(QStringLiteral("InputMethod"));
+}
+
+bool customInputMethodIsConfigured()
+{
+    const QString desktopFile = QFileInfo(kwinInputMethod()).fileName();
+    return desktopFile.startsWith(QStringLiteral("org.uke.plasma.keyboard"));
+}
+
+void writeKwinInputMethod(const QString &value)
+{
+    QProcess::execute(QStringLiteral("kwriteconfig6"),
+                      {QStringLiteral("--notify"),
+                       QStringLiteral("--file"),
+                       QStringLiteral("kwinrc"),
+                       QStringLiteral("--group"),
+                       QStringLiteral("Wayland"),
+                       QStringLiteral("--key"),
+                       QStringLiteral("InputMethod"),
+                       value});
+}
+
+//! Ask KWin, whose state is the authoritative one (the window of this process
+//! keeps reporting itself as visible).
+bool keyboardVisible()
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),
+                                                      QStringLiteral("/VirtualKeyboard"),
+                                                      QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                      QStringLiteral("Get"));
+    msg << QStringLiteral("org.kde.kwin.VirtualKeyboard") << QStringLiteral("visible");
+    const QDBusMessage reply = QDBusConnection::sessionBus().call(msg);
+    if (reply.type() == QDBusMessage::ReplyMessage && !reply.arguments().isEmpty()) {
+        return reply.arguments().constFirst().value<QDBusVariant>().variant().toBool();
+    }
+    return false;
+}
+}
+
+int restartInputMethod()
+{
+    const QString inputMethod = kwinInputMethod();
+    if (!QFileInfo(inputMethod).fileName().startsWith(QStringLiteral("org.uke.plasma.keyboard"))) {
+        return 0;
+    }
+
+    qCInfo(PlasmaKeyboard) << "Restarting the keyboard, the installed binary changed";
+    // Emptying the setting kills the process that runs this helper, restoring
+    // it makes KWin start a fresh one.
+    writeKwinInputMethod(QString());
+    QThread::msleep(s_kwinRestartDelayMs);
+    // The blank value is the temporary state owned by this restart. Preserve
+    // a different choice made in System Settings while the old process exits.
+    if (kwinInputMethod().isEmpty()) {
+        writeKwinInputMethod(inputMethod);
+    }
+    return 0;
+}
+
+RestartWatcher::RestartWatcher(QObject *parent)
+    : QObject(parent)
+{
+    // /proc/self/exe follows symlinks, so this is the file a package update
+    // replaces.
+    m_binaryPath = QFile::symLinkTarget(QStringLiteral("/proc/self/exe"));
+    if (m_binaryPath.isEmpty()) {
+        m_binaryPath = QCoreApplication::applicationFilePath();
+    }
+
+    const QFileInfo info(m_binaryPath);
+    m_fileIdentity = UkeKeyboard::fileIdentity(m_binaryPath);
+    m_modified = info.lastModified();
+    m_size = info.size();
+    m_sinceDetection.start();
+
+    if (!customInputMethodIsConfigured()) {
+        // This process is not the configured input method, so KWin will not
+        // keep it alive: nothing to restart.
+        return;
+    }
+
+    m_timer = new QTimer(this);
+    m_timer->setSingleShot(true);
+    m_timer->setInterval(s_maxDeferMs);
+    connect(m_timer, &QTimer::timeout, this, &RestartWatcher::checkForUpdate);
+    auto *files=new QFileSystemWatcher(this);
+    files->addPath(m_binaryPath);
+    files->addPath(QFileInfo(m_binaryPath).absolutePath());
+    connect(files,&QFileSystemWatcher::fileChanged,this,[this,files]{if(QFile::exists(m_binaryPath)&&!files->files().contains(m_binaryPath))files->addPath(m_binaryPath);checkForUpdate();});
+    connect(files,&QFileSystemWatcher::directoryChanged,this,[this,files]{if(QFile::exists(m_binaryPath)&&!files->files().contains(m_binaryPath))files->addPath(m_binaryPath);checkForUpdate();});
+    connect(QGuiApplication::inputMethod(),&QInputMethod::visibleChanged,this,&RestartWatcher::checkForUpdate);
+}
+
+void RestartWatcher::checkForUpdate()
+{
+    const QFileInfo info(m_binaryPath);
+    const auto identity = UkeKeyboard::fileIdentity(m_binaryPath);
+    if (!identity) {
+        // The package manager is in the middle of replacing the file.
+        return;
+    }
+
+    // RPM timestamps are reproducible and two different executables can have
+    // equal sizes. Atomic replacement still changes the file's inode.
+    const bool changed = identity != m_fileIdentity || info.lastModified() != m_modified || info.size() != m_size;
+    if (!changed && !m_restartPending) {
+        return;
+    }
+
+    if (changed) {
+        m_fileIdentity = identity;
+        m_modified = info.lastModified();
+        m_size = info.size();
+        m_restartPending = true;
+        m_sinceDetection.start();
+        m_timer->start(s_maxDeferMs);
+    }
+
+    // Do not pull the keyboard away from under the user's fingers, but do not
+    // wait forever either: an update has to reach the running keyboard.
+    if (keyboardVisible() && m_sinceDetection.elapsed() < s_maxDeferMs) {
+        return;
+    }
+
+    m_restartPending = false;
+    restart();
+}
+
+void RestartWatcher::restart()
+{
+    qCInfo(PlasmaKeyboard) << "The installed binary changed, restarting the keyboard";
+    // The helper survives the toggle below; this process is killed by KWin as
+    // soon as the input method is torn down, so quit cleanly (which also
+    // releases the single instance lock) and let the helper finish the job.
+    if (!QProcess::startDetached(m_binaryPath, {QStringLiteral("--restart-input-method")})) {
+        qCWarning(PlasmaKeyboard) << "Could not start the restart helper";
+        return;
+    }
+    QCoreApplication::quit();
+}
+
+int runInputMethodWatchdog()
+{
+    int count=1;char name[]="uke-keyboard-watchdog";char *arguments[]={name,nullptr};
+    QCoreApplication application(count,arguments);
+    if(!customInputMethodIsConfigured())return 0;
+    const QString runtimeDir=QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    const QString instancePath=runtimeDir+QStringLiteral("/uke-plasma-keyboard-custom.lock");
+    QLockFile watchdog(runtimeDir+QStringLiteral("/uke-plasma-keyboard-custom-watchdog.lock"));
+    watchdog.setStaleLockTime(0);if(!watchdog.tryLock(0))return 0;
+    QFileSystemWatcher files;
+    const QString configPath=QStandardPaths::writableLocation(QStandardPaths::ConfigLocation)+QStringLiteral("/kwinrc");
+    files.addPath(configPath);files.addPath(QFileInfo(configPath).absolutePath());
+    QSocketNotifier *notifier=nullptr;int processFd=-1;qint64 watchedPid=-1;
+    bool restarting=false;
+    std::function<void()> observe;
+    observe=[&] {
+        if(!customInputMethodIsConfigured()){application.quit();return;}
+        QLockFile instance(instancePath);qint64 pid=0;QString host,app;
+        if(!instance.getLockInfo(&pid,&host,&app)||pid<=0){
+            if(!files.directories().contains(runtimeDir))files.addPath(runtimeDir);
+            return;
+        }
+        if(pid==watchedPid)return;
+        if(notifier){delete notifier;notifier=nullptr;}
+        if(processFd>=0)close(processFd);
+        processFd=int(syscall(SYS_pidfd_open,pid,0));
+        if(processFd<0)return;
+        watchedPid=pid;
+        files.removePath(runtimeDir);
+        notifier=new QSocketNotifier(processFd,QSocketNotifier::Read,&application);
+        QObject::connect(notifier,&QSocketNotifier::activated,&application,[&]{
+            notifier->setEnabled(false);watchedPid=-1;
+            if(restarting)return;restarting=true;
+            QTimer::singleShot(1000,&application,[&]{
+                if(customInputMethodIsConfigured())restartInputMethod();
+                restarting=false;observe();
+            });
+        });
+    };
+    QObject::connect(&files,&QFileSystemWatcher::fileChanged,&application,[&]{if(QFile::exists(configPath)&&!files.files().contains(configPath))files.addPath(configPath);observe();});
+    QObject::connect(&files,&QFileSystemWatcher::directoryChanged,&application,[&]{observe();});
+    QDBusServiceWatcher compositor(QStringLiteral("org.kde.KWin"),QDBusConnection::sessionBus(),QDBusServiceWatcher::WatchForUnregistration);
+    QObject::connect(&compositor,&QDBusServiceWatcher::serviceUnregistered,&application,&QCoreApplication::quit);
+    observe();const int result=application.exec();if(processFd>=0)close(processFd);return result;
+}
diff --git a/src/restartwatcher.h b/src/restartwatcher.h
new file mode 100644
index 0000000000000000000000000000000000000000..e2c313be3c43459787a8998fe8900c563090efed
--- /dev/null
+++ b/src/restartwatcher.h
@@ -0,0 +1,77 @@
+/*
+    SPDX-FileCopyrightText: 2026 Plasma Keyboard contributors
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include "fileidentity.h"
+#include <QDateTime>
+#include <QElapsedTimer>
+#include <QObject>
+#include <QString>
+
+class QTimer;
+
+/**
+ * Restarts the keyboard when the binary this process runs from is updated.
+ *
+ * KWin keeps one uke-plasma-keyboard-custom process running for the whole session,
+ * so after a package update that process keeps executing the old code until the
+ * session is restarted by hand. This class notices that the file on disk has
+ * changed and asks KWin to start the input method again, with the same
+ * configuration toggle a manual restart uses:
+ *
+ *     kwinrc [Wayland] InputMethod -> "" -> the previous value
+ *
+ * Emptying the setting makes KWin tear the running process down, restoring it
+ * makes KWin start a fresh one, which picks up the new binary. The restart is
+ * deferred while the panel is visible, so an update does not interrupt typing,
+ * but only for a couple of minutes - it must not stay unapplied just because
+ * the keyboard happens to be on screen. When this process is not the configured
+ * input method the watcher stays idle, as KWin keeps no process of ours around
+ * then anyway.
+ */
+class RestartWatcher : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit RestartWatcher(QObject *parent = nullptr);
+
+private:
+    void checkForUpdate();
+    void restart();
+
+    QString m_binaryPath;
+    std::optional<UkeKeyboard::FileIdentity> m_fileIdentity;
+    QDateTime m_modified;
+    qint64 m_size = -1;
+    bool m_restartPending = false;
+    QElapsedTimer m_sinceDetection;
+    QTimer *m_timer = nullptr;
+};
+
+/**
+ * Entry point of the detached helper (--restart-input-method): toggles the KWin
+ * setting and returns.
+ *
+ * It deliberately runs without a QGuiApplication: it must not become a Wayland
+ * client, and it has to survive the old input method process being killed by
+ * the very toggle it performs.
+ */
+int restartInputMethod();
+
+/**
+ * Entry point of the detached watchdog (--watchdog): keeps the input method
+ * process alive for the whole session.
+ *
+ * KWin starts the configured input method once but does not start a
+ * replacement when it exits. The global shortcut to show the keyboard is
+ * registered by that process, so once it is gone the shortcut stops working.
+ * The watchdog blocks on a pidfd and file notifications, then asks KWin
+ * to start the input method again. It stays idle while the virtual keyboard is
+ * disabled, and only one watchdog runs at a time.
+ */
+int runInputMethodWatchdog();
diff --git a/src/sessionlockstate.cpp b/src/sessionlockstate.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ec2a2fff65974f20e78939dcde7bf455efc902d4
--- /dev/null
+++ b/src/sessionlockstate.cpp
@@ -0,0 +1,106 @@
+/*
+    SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "sessionlockstate.h"
+
+#include <QCoreApplication>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusServiceWatcher>
+
+namespace
+{
+constexpr auto service = "org.freedesktop.ScreenSaver";
+constexpr auto path = "/ScreenSaver";
+constexpr auto interface = "org.freedesktop.ScreenSaver";
+}
+
+SessionLockState *SessionLockState::instance()
+{
+    static auto *state = new SessionLockState(QCoreApplication::instance());
+    return state;
+}
+
+SessionLockState::SessionLockState(QObject *parent)
+    : SessionLockState(QDBusConnection::sessionBus(), parent)
+{
+}
+
+SessionLockState::SessionLockState(const QDBusConnection &bus, QObject *parent)
+    : QObject(parent)
+    , m_bus(bus)
+{
+    m_bus.connect(QLatin1String(service), QLatin1String(path), QLatin1String(interface), QStringLiteral("ActiveChanged"), this, SLOT(activeChanged(bool)));
+    m_bus.connect(QLatin1String(service), QLatin1String(path), QStringLiteral("org.kde.screensaver"), QStringLiteral("AboutToLock"), this, SLOT(aboutToLock()));
+    auto *watcher = new QDBusServiceWatcher(QLatin1String(service), m_bus, QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(watcher, &QDBusServiceWatcher::serviceOwnerChanged, this, &SessionLockState::ownerChanged);
+    query();
+}
+
+void SessionLockState::query()
+{
+    const quint64 generation = ++m_generation;
+    const auto request = QDBusMessage::createMethodCall(QLatin1String(service), QLatin1String(path), QLatin1String(interface), QStringLiteral("GetActive"));
+    auto *pending = new QDBusPendingCallWatcher(m_bus.asyncCall(request, 1000), this);
+    connect(pending, &QDBusPendingCallWatcher::finished, this, [this, generation](QDBusPendingCallWatcher *call) {
+        const auto reply = call->reply();
+        call->deleteLater();
+        if (generation != m_generation || reply.type() != QDBusMessage::ReplyMessage || reply.signature() != QLatin1String("b")) {
+            return;
+        }
+        const bool active = reply.arguments().first().toBool();
+        // GetActive is false while the locker is still acquiring its grab.
+        // Neither an old nor a fresh false reply proves lock cancellation.
+        if (m_preparingLock && !active) {
+            return;
+        }
+        activeChanged(active);
+    });
+}
+
+void SessionLockState::aboutToLock()
+{
+    ++m_generation;
+    if (m_known && m_locked) {
+        return;
+    }
+    m_preparingLock = true;
+    setState(true, true); // Restrict content before the greeter becomes visible.
+}
+
+void SessionLockState::activeChanged(bool active)
+{
+    ++m_generation;
+    const bool wasPreparing = m_preparingLock;
+    m_preparingLock = false;
+    const bool stateUnchanged = m_known && m_locked == active;
+    setState(true, active);
+    if (wasPreparing && stateUnchanged) {
+        Q_EMIT stateChanged();
+    }
+}
+
+void SessionLockState::ownerChanged(const QString &, const QString &, const QString &newOwner)
+{
+    ++m_generation;
+    m_preparingLock = false;
+    setState(false, false);
+    if (!newOwner.isEmpty()) {
+        query();
+    }
+}
+
+void SessionLockState::setState(bool known, bool locked)
+{
+    if (known == m_known && locked == m_locked) {
+        return;
+    }
+    const bool didUnlock = m_known && m_locked && known && !locked;
+    m_known = known;
+    m_locked = locked;
+    if (didUnlock) {
+        Q_EMIT unlocked();
+    }
+    Q_EMIT stateChanged();
+}
diff --git a/src/sessionlockstate.h b/src/sessionlockstate.h
new file mode 100644
index 0000000000000000000000000000000000000000..f799f19fcb41dd0547188901db910bf932030b75
--- /dev/null
+++ b/src/sessionlockstate.h
@@ -0,0 +1,55 @@
+/*
+    SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#pragma once
+
+#include <QDBusConnection>
+#include <QObject>
+
+/** Cached lock state; never make an input handler wait for a D-Bus reply. */
+class SessionLockState : public QObject
+{
+    Q_OBJECT
+public:
+    static SessionLockState *instance();
+    explicit SessionLockState(QObject *parent = nullptr);
+    explicit SessionLockState(const QDBusConnection &bus, QObject *parent = nullptr);
+
+    bool isKnown() const
+    {
+        return m_known;
+    }
+    bool isLocked() const
+    {
+        return m_locked;
+    }
+    bool isPreparingLock() const
+    {
+        return m_preparingLock;
+    }
+    bool allowsPredictions() const
+    {
+        return m_known && !m_locked;
+    }
+
+Q_SIGNALS:
+    void stateChanged();
+    // Emitted before stateChanged so the old lock-screen panel can be hidden
+    // before any normal-field prediction is requested.
+    void unlocked();
+
+private Q_SLOTS:
+    void aboutToLock();
+    void activeChanged(bool active);
+    void ownerChanged(const QString &service, const QString &oldOwner, const QString &newOwner);
+
+private:
+    void query();
+    void setState(bool known, bool locked);
+    QDBusConnection m_bus;
+    quint64 m_generation = 0;
+    bool m_preparingLock = false;
+    bool m_known = false;
+    bool m_locked = false;
+};
diff --git a/src/settingsreloader.cpp b/src/settingsreloader.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..eecd17686829281b973bee57dd4c07e1827f71c7
--- /dev/null
+++ b/src/settingsreloader.cpp
@@ -0,0 +1,79 @@
+/*
+    SPDX-FileCopyrightText: 2026 Aleksandr Kvintilyanov <bednyj.mops@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "settingsreloader.h"
+
+#include "logging.h"
+#include "plasmakeyboardsettings.h"
+
+#include <QFileInfo>
+#include <QStandardPaths>
+
+namespace
+{
+//! Long enough to let KConfig finish writing the file, short enough to feel immediate.
+constexpr int s_reloadDelayMs = 200;
+
+//! The settings file as an absolute path: KConfig::name() returns the plain file name.
+QString settingsFilePath()
+{
+    const QString name = PlasmaKeyboardSettings::self()->sharedConfig()->name();
+    if (QFileInfo(name).isAbsolute()) {
+        return name;
+    }
+    return QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QLatin1Char('/') + name;
+}
+}
+
+SettingsReloader::SettingsReloader(QObject *parent)
+    : QObject(parent)
+    , m_path(settingsFilePath())
+    , m_lastModified(QFileInfo(m_path).lastModified())
+{
+    m_debounce.setSingleShot(true);
+    m_debounce.setInterval(s_reloadDelayMs);
+    connect(&m_debounce, &QTimer::timeout, this, &SettingsReloader::reload);
+
+    connect(&m_watcher, &QFileSystemWatcher::fileChanged, this, &SettingsReloader::scheduleReload);
+    connect(&m_watcher, &QFileSystemWatcher::directoryChanged, this, &SettingsReloader::scheduleReload);
+    watchPath();
+
+    qCDebug(PlasmaKeyboard) << "watching the keyboard settings file" << m_path << "watched:" << m_watcher.files() << m_watcher.directories();
+}
+
+void SettingsReloader::watchPath()
+{
+    const QString directory = QFileInfo(m_path).absolutePath();
+    if (!directory.isEmpty() && !m_watcher.directories().contains(directory)) {
+        m_watcher.addPath(directory);
+    }
+    if (QFileInfo::exists(m_path) && !m_watcher.files().contains(m_path)) {
+        m_watcher.addPath(m_path);
+    }
+}
+
+void SettingsReloader::scheduleReload()
+{
+    qCDebug(PlasmaKeyboard) << "keyboard settings file changed" << m_path;
+    m_debounce.start();
+}
+
+void SettingsReloader::reload()
+{
+    watchPath();
+
+    const QDateTime modified = QFileInfo(m_path).lastModified();
+    if (modified == m_lastModified) {
+        return;
+    }
+    m_lastModified = modified;
+
+    PlasmaKeyboardSettings::self()->sharedConfig()->reparseConfiguration();
+    PlasmaKeyboardSettings::self()->load();
+
+    qCDebug(PlasmaKeyboard) << "keyboard settings re-read from" << m_path;
+    Q_EMIT settingsReloaded();
+}
diff --git a/src/settingsreloader.h b/src/settingsreloader.h
new file mode 100644
index 0000000000000000000000000000000000000000..6d13a3aaf078115b2ffe12f2280853d38cd97875
--- /dev/null
+++ b/src/settingsreloader.h
@@ -0,0 +1,49 @@
+/*
+    SPDX-FileCopyrightText: 2026 Aleksandr Kvintilyanov <bednyj.mops@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QDateTime>
+#include <QFileSystemWatcher>
+#include <QObject>
+#include <QString>
+#include <QTimer>
+
+/*!
+ * Re-reads the keyboard settings as soon as the configuration file changes.
+ *
+ * KConfigWatcher does not deliver changes in this application (verified
+ * 2026-09-21), so the file and the directory it lives in are watched directly:
+ * KConfig writes the file through a rename, which makes the watched path stop
+ * being watched, so both paths are re-added after every event.
+ *
+ * The file time decides whether the settings are re-read, so that an unrelated
+ * change in the configuration directory does not reload them.
+ */
+class SettingsReloader : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit SettingsReloader(QObject *parent = nullptr);
+
+Q_SIGNALS:
+    //! The settings were re-read; the values may have changed.
+    void settingsReloaded();
+
+private:
+    //! Starts the debounce timer, so that a burst of file events causes one reload.
+    void scheduleReload();
+    //! Re-reads the settings, if the configuration file really changed.
+    void reload();
+    //! Keeps watching the file and its directory.
+    void watchPath();
+
+    QFileSystemWatcher m_watcher;
+    QTimer m_debounce;
+    QString m_path;
+    QDateTime m_lastModified;
+};
