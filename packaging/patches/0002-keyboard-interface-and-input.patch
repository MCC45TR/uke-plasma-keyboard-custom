+                    const c = item.mapToItem(null, item.width / 2, item.height / 2);
+                    map.push({
+                        "x": c.x,
+                        "y": c.y,
+                        "w": item.width,
+                        "h": item.height,
+                        "r": Math.min(item.width, item.height) / 2,
