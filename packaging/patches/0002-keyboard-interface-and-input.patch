+        Rectangle {
+            anchors.fill: parent
+            radius: width / 2
+            color: "#2e7d32"
+            border.color: "white"
+            border.width: 1
+
+            Text {
+                anchors.centerIn: parent
+                text: "A"
+                color: "white"
+                font.bold: true
+                font.pixelSize: 15
+            }
+        }
     }
 }
