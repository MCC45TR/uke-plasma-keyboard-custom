diff --git a/src/swipecontroller.cpp b/src/swipecontroller.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2811a29ee51aa3662a54ecbec5ddc219124358ec
--- /dev/null
+++ b/src/swipecontroller.cpp
@@ -0,0 +1,373 @@
+/*
+    SPDX-FileCopyrightText: 2026 Aleksandr Kvintilyanov <bednyj.mops@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "swipecontroller.h"
+
+#include <QDBusConnection>
+#include <QDir>
+#include <QElapsedTimer>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QLoggingCategory>
+#include <QSaveFile>
+#include <QStandardPaths>
+#include <QTimer>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <vector>
+
+#include "swipekb/language_engine.hpp"
+#include "swipekb/text.hpp"
+
+Q_LOGGING_CATEGORY(lcSwipe, "org.uke.plasma.keyboard.swipe")
+
+namespace
+{
+//! The languages with a generated word list. Keep in sync with _swipe_languages
+//! in src/swipekb/CMakeLists.txt.
+const QStringList supportedLanguages = {QStringLiteral("en"), QStringLiteral("ru")};
+
+QString installedPath(const QString &fileName)
+{
+    return QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("uke-plasma-keyboard-custom/swipe/") + fileName);
+}
+} // namespace
+
+SwipeController::SwipeController(QObject *parent)
+    : QObject(parent)
+    , m_saveTimer(new QTimer(this))
+{
+    m_saveTimer->setSingleShot(true);
+    m_saveTimer->setInterval(2000);
+    connect(m_saveTimer, &QTimer::timeout, this, [this] {
+        for (auto it = m_learned.cbegin(); it != m_learned.cend(); ++it) {
+            saveLearned(it.key());
+        }
+    });
+
+    // A small D-Bus hook for scripts and tests: replaying a path without the
+    // keyboard. The object is always reachable through the connection's unique
+    // name; the well-known one may be taken by another instance.
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    if (bus.isConnected() && qEnvironmentVariableIsSet("PLASMA_KEYBOARD_TEST_MODE")) {
+        bus.registerObject(QStringLiteral("/SwipeDebug"), this, QDBusConnection::ExportAllSlots);
+        if (!bus.registerService(QStringLiteral("org.uke.plasma.keyboard"))) {
+            qCDebug(lcSwipe) << "D-Bus name org.uke.plasma.keyboard is taken; SwipeDebug is on the unique name";
+        }
+    }
+}
+
+SwipeController::~SwipeController() = default;
+
+QString SwipeController::languageOf(const QString &locale)
+{
+    const int separator = locale.indexOf(QLatin1Char('_'));
+    const QString language = (separator > 0 ? locale.left(separator) : locale).toLower();
+    return supportedLanguages.contains(language) ? language : QString();
+}
+
+QString SwipeController::dataFile(const QString &name)
+{
+    return installedPath(name);
+}
+
+bool SwipeController::supports(const QString &locale) const
+{
+    const QString language = languageOf(locale);
+    if (language.isEmpty()) {
+        return false;
+    }
+    return QFileInfo::exists(installedPath(language + QStringLiteral(".combined")));
+}
+
+swipekb::LanguageEngine *SwipeController::engineFor(const QString &locale)
+{
+    const QString language = languageOf(locale);
+    if (language.isEmpty()) {
+        return nullptr;
+    }
+
+    const auto cached = m_engines.constFind(language);
+    if (cached != m_engines.constEnd()) {
+        return cached->get();
+    }
+
+    const QString dictionary = installedPath(language + QStringLiteral(".combined"));
+    if (dictionary.isEmpty()) {
+        qCWarning(lcSwipe) << "no swipe dictionary for" << language;
+        return nullptr;
+    }
+
+    auto engine = std::make_shared<swipekb::LanguageEngine>();
+    swipekb::LanguageEngineSetup setup;
+    setup.language = language.toStdString();
+    setup.dictionary = dictionary.toStdString();
+    // The neural model covers English. Russian is decoded by geometry over its
+    // word list, which needs no model.
+    const QString model = language == QLatin1String("en") ? installedPath(QStringLiteral("swipe-model.bin")) : QString();
+    if (!model.isEmpty()) {
+        setup.swipeModel = model.toStdString();
+    }
+
+    QElapsedTimer timer;
+    timer.start();
+    if (!engine->init(setup)) {
+        qCWarning(lcSwipe) << "cannot initialise the swipe engine for" << language << dictionary;
+        return nullptr;
+    }
+    loadLearned(language);
+    engine->setLearnedWords(learnedWordsFor(language));
+    qCDebug(lcSwipe) << "swipe engine ready for" << language << "mode" << engine->mode() << "in" << timer.elapsed() << "ms";
+
+    m_engines.insert(language, engine);
+    return engine.get();
+}
+
+QStringList SwipeController::recognize(const QString &locale, const QVariantList &trace, const QVariantList &keys, const QStringList &context, int limit)
+{
+    if (trace.size() < 2 || keys.size() < 2 || limit <= 0) {
+        return {};
+    }
+
+    swipekb::LanguageEngine *engine = engineFor(locale);
+    if (!engine) {
+        return {};
+    }
+
+    std::vector<swipekb::TracePoint> points;
+    points.reserve(trace.size());
+    const qint64 start = trace.first().toMap().value(QStringLiteral("t")).toLongLong();
+    for (const QVariant &item : trace) {
+        const QVariantMap point = item.toMap();
+        points.push_back({float(point.value(QStringLiteral("x")).toDouble()),
+                          float(point.value(QStringLiteral("y")).toDouble()),
+                          float(point.value(QStringLiteral("t")).toLongLong() - start)});
+    }
+
+    std::vector<swipekb::KeyRect> rects;
+    rects.reserve(keys.size());
+    for (const QVariant &item : keys) {
+        const QVariantMap key = item.toMap();
+        const QString letter = key.value(QStringLiteral("letter")).toString();
+        if (letter.isEmpty()) {
+            continue;
+        }
+        // QML gives the centre of a key; the engine wants its top-left corner
+        // (KeyRect::x/y are the corner, the centre is derived as x + w / 2).
+        const double width = key.value(QStringLiteral("w")).toDouble();
+        const double height = key.value(QStringLiteral("h")).toDouble();
+        rects.push_back({letter.at(0).toLower().unicode(),
+                         float(key.value(QStringLiteral("x")).toDouble() - width / 2),
+                         float(key.value(QStringLiteral("y")).toDouble() - height / 2),
+                         float(width),
+                         float(height)});
+    }
+    if (rects.size() < 2) {
+        return {};
+    }
+
+    std::vector<std::string> words;
+    words.reserve(context.size());
+    for (const QString &word : context) {
+        if (!word.isEmpty()) {
+            words.push_back(word.toStdString());
+        }
+    }
+
+    QElapsedTimer timer;
+    timer.start();
+    const std::vector<swipekb::Candidate> candidates = engine->recognize(points, rects, words, limit);
+    const qint64 elapsed = timer.elapsed();
+
+    // Debug aid: with the swipe logging category enabled, keep the last gesture
+    // so it can be replayed outside the keyboard (see .dsh/tmp/swipeprobe).
+    if (lcSwipe().isDebugEnabled()) {
+        QJsonObject dump;
+        dump.insert(QStringLiteral("locale"), locale);
+        QJsonArray traceArray;
+        for (const auto &point : points) {
+            traceArray.append(QJsonObject{{QStringLiteral("x"), point.x}, {QStringLiteral("y"), point.y}, {QStringLiteral("t"), point.t_ms}});
+        }
+        dump.insert(QStringLiteral("trace"), traceArray);
+        QJsonArray keyArray;
+        for (const auto &rect : rects) {
+            keyArray.append(QJsonObject{{QStringLiteral("letter"), QString::fromUcs4(&rect.letter, 1)},
+                                        {QStringLiteral("x"), rect.x},
+                                        {QStringLiteral("y"), rect.y},
+                                        {QStringLiteral("w"), rect.w},
+                                        {QStringLiteral("h"), rect.h}});
+        }
+        dump.insert(QStringLiteral("keys"), keyArray);
+
+        QFile file(QStringLiteral("/tmp/plasma-keyboard-swipe-last.json"));
+        if (file.open(QIODevice::WriteOnly)) {
+            file.write(QJsonDocument(dump).toJson(QJsonDocument::Compact));
+        }
+    }
+
+    QStringList result;
+    result.reserve(int(candidates.size()));
+    for (const swipekb::Candidate &candidate : candidates) {
+        result.append(QString::fromStdString(candidate.word));
+    }
+    qCDebug(lcSwipe) << "swipe decoded" << result.size() << "words in" << elapsed << "ms";
+    return result;
+}
+
+void SwipeController::reset()
+{
+    m_engines.clear();
+}
+
+QString SwipeController::learnedPath(const QString &language)
+{
+    const QString directory = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/uke-plasma-keyboard-custom/swipe");
+    return directory + QStringLiteral("/learned-") + language + QStringLiteral(".json");
+}
+
+void SwipeController::loadLearned(const QString &language)
+{
+    if (m_learned.contains(language)) {
+        return;
+    }
+
+    QHash<QString, int> words;
+    QFile file(learnedPath(language));
+    if (file.open(QIODevice::ReadOnly)) {
+        const QJsonObject stored = QJsonDocument::fromJson(file.readAll()).object().value(QStringLiteral("words")).toObject();
+        for (auto it = stored.begin(); it != stored.end(); ++it) {
+            const int count = it.value().toInt();
+            if (count > 0) {
+                words.insert(it.key(), count);
+            }
+        }
+        qCDebug(lcSwipe) << "learned words for" << language << words.size();
+    }
+    m_learned.insert(language, words);
+}
+
+void SwipeController::saveLearned(const QString &language)
+{
+    const QString path = learnedPath(language);
+    QDir().mkpath(QFileInfo(path).absolutePath());
+
+    QJsonObject words;
+    const auto known = m_learned.constFind(language);
+    if (known != m_learned.constEnd()) {
+        for (auto it = known->begin(); it != known->end(); ++it) {
+            words.insert(it.key(), it.value());
+        }
+    }
+
+    QSaveFile file(path);
+    if (!file.open(QIODevice::WriteOnly)) {
+        qCWarning(lcSwipe) << "cannot write the learned words" << path;
+        return;
+    }
+    file.write(QJsonDocument(QJsonObject{{QStringLiteral("version"), 1}, {QStringLiteral("words"), words}}).toJson(QJsonDocument::Compact));
+    if (file.commit()) {
+        // The words are personal: keep the file readable only by its owner.
+        QFile::setPermissions(path, QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+    }
+}
+
+std::vector<std::pair<std::string, int>> SwipeController::learnedWordsFor(const QString &language) const
+{
+    std::vector<std::pair<std::string, int>> words;
+    const auto known = m_learned.constFind(language);
+    if (known == m_learned.constEnd()) {
+        return words;
+    }
+    words.reserve(size_t(known->size()));
+    for (auto it = known->begin(); it != known->end(); ++it) {
+        // A typed word is worth more than a rare word of the list from the
+        // first use, and grows with every use, up to the top of the scale.
+        const int frequency = std::clamp(int(80 + 25 * std::log2(it.value() + 1)), 80, 255);
+        words.emplace_back(it.key().toStdString(), frequency);
+    }
+    return words;
+}
+
+void SwipeController::learnWord(const QString &word, const QString &locale)
+{
+    const QString language = languageOf(locale);
+    if (language.isEmpty() || word.isEmpty()) {
+        return;
+    }
+
+    // Only letters: the engine rejects anything else, and punctuation would
+    // make one word of «слово,» and «слово».
+    QString cleaned;
+    cleaned.reserve(word.size());
+    for (const QChar character : word.toLower()) {
+        if (character.isLetter()) {
+            cleaned.append(character);
+        }
+    }
+    if (cleaned.isEmpty()) {
+        return;
+    }
+
+    loadLearned(language);
+    QHash<QString, int> &words = m_learned[language];
+    words.insert(cleaned, std::min(words.value(cleaned) + 1, 255));
+
+    if (swipekb::LanguageEngine *engine = engineFor(locale)) {
+        engine->setLearnedWords(learnedWordsFor(language));
+    }
+    // Write once the person stops typing rather than on every word.
+    m_saveTimer->start();
+}
+
+void SwipeController::clearLearnedWords(const QString &locale)
+{
+    const QString language = languageOf(locale);
+    if (language.isEmpty()) {
+        return;
+    }
+    m_learned.remove(language);
+    QFile::remove(learnedPath(language));
+    if (swipekb::LanguageEngine *engine = engineFor(locale)) {
+        engine->setLearnedWords({});
+    }
+}
+
+QStringList SwipeController::recognizeJson(const QString &locale, const QString &request)
+{
+    const QJsonObject root = QJsonDocument::fromJson(request.toUtf8()).object();
+
+    QVariantList traceList;
+    for (const QJsonValue &point : root.value(QStringLiteral("trace")).toArray()) {
+        const QJsonArray values = point.toArray();
+        if (values.size() != 3) {
+            continue;
+        }
+        traceList.append(QVariantMap{{QStringLiteral("x"), values[0].toDouble()},
+                                     {QStringLiteral("y"), values[1].toDouble()},
+                                     {QStringLiteral("t"), qint64(values[2].toDouble())}});
+    }
+
+    QVariantList keyList;
+    for (const QJsonValue &key : root.value(QStringLiteral("keys")).toArray()) {
+        const QJsonArray values = key.toArray();
+        if (values.size() != 5) {
+            continue;
+        }
+        keyList.append(QVariantMap{{QStringLiteral("letter"), values[0].toString()},
+                                   {QStringLiteral("x"), values[1].toDouble()},
+                                   {QStringLiteral("y"), values[2].toDouble()},
+                                   {QStringLiteral("w"), values[3].toDouble()},
+                                   {QStringLiteral("h"), values[4].toDouble()}});
+    }
+
+    qCDebug(lcSwipe) << "SwipeDebug:" << traceList.size() << "points," << keyList.size() << "keys for" << locale;
+    return recognize(locale, traceList, keyList, {}, 5);
+}
diff --git a/src/swipecontroller.h b/src/swipecontroller.h
new file mode 100644
index 0000000000000000000000000000000000000000..a2a483bbc9f9202715d269959997353a2bd43051
--- /dev/null
+++ b/src/swipecontroller.h
@@ -0,0 +1,118 @@
+/*
+    SPDX-FileCopyrightText: 2026 Aleksandr Kvintilyanov <bednyj.mops@gmail.com>
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QHash>
+#include <QObject>
+#include <QStringList>
+#include <QVariantList>
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <qqmlintegration.h>
+
+class QTimer;
+
+namespace swipekb
+{
+class LanguageEngine;
+}
+
+/**
+ * Swipe (glide) typing: turns the finger path and the letter-key rectangles
+ * into ranked words with the vendored MIT engine (src/swipekb).
+ *
+ * One language engine per language, built on first use: English loads the
+ * neural swipe model, Russian is decoded by geometry over the Russian word
+ * list. The word lists are AOSP .combined files generated at build time from
+ * the predictive word lists and installed to
+ * <datadir>/uke-plasma-keyboard-custom/swipe/.
+ *
+ * The engine is not thread-safe; every call happens on the GUI thread and a
+ * decode takes a few milliseconds.
+ */
+class SwipeController : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+public:
+    explicit SwipeController(QObject *parent = nullptr);
+    ~SwipeController() override;
+
+    /**
+     * Whether a word list for @p locale is installed, so a swipe can be typed
+     * in that language.
+     */
+    Q_INVOKABLE bool supports(const QString &locale) const;
+
+    /**
+     * The words the finger path may have spelled, best first.
+     *
+     * @param locale The input locale ("ru_RU", "en_US", ...); a language
+     *               without an installed word list has no swipe typing.
+     * @param trace Points of the path: records with x, y (window pixels) and t
+     *              (milliseconds since the swipe started).
+     * @param keys  The letter keys of the current layout: records with letter,
+     *              x, y, w and h in the same pixels.
+     * @param context The previous word, when there is one (the engine's
+     *              sentence prior is not loaded yet, so it only matters later).
+     * @param limit At most this many words.
+     * @return Ranked words, or an empty list when nothing could be recognised.
+     */
+    Q_INVOKABLE QStringList recognize(const QString &locale, const QVariantList &trace, const QVariantList &keys, const QStringList &context, int limit);
+
+    /**
+     * Drops the engines of the languages that are no longer needed (the
+     * layout changed, the keyboard was hidden).
+     */
+    Q_INVOKABLE void reset();
+
+    /**
+     * Remembers that @p word was typed, so that the same words are preferred
+     * later. Only letters are kept; the words are stored per language in
+     * <datadir>/uke-plasma-keyboard-custom/swipe/learned-<lang>.json.
+     *
+     * The caller decides whether the field may be remembered at all (password
+     * fields are not); this method does not look at the focused field.
+     */
+    Q_INVOKABLE void learnWord(const QString &word, const QString &locale);
+
+    /**
+     * Forgets the words learned for the language of @p locale.
+     */
+    Q_INVOKABLE void clearLearnedWords(const QString &locale);
+
+public Q_SLOTS:
+    /**
+     * The same recognition, for scripts and tests over D-Bus
+     * (org.uke.plasma.keyboard /SwipeDebug), from one JSON string:
+     * {"trace": [[x, y, t], ...], "keys": [["letter", x, y, w, h], ...]},
+     * both in the window's pixels, the keys with their top-left corner, as the
+     * engine expects them.
+     */
+    QStringList recognizeJson(const QString &locale, const QString &request);
+
+private:
+    swipekb::LanguageEngine *engineFor(const QString &locale);
+
+    static QString languageOf(const QString &locale);
+    static QString dataFile(const QString &name);
+    static QString learnedPath(const QString &language);
+
+    void loadLearned(const QString &language);
+    void saveLearned(const QString &language);
+    std::vector<std::pair<std::string, int>> learnedWordsFor(const QString &language) const;
+
+    QHash<QString, std::shared_ptr<swipekb::LanguageEngine>> m_engines;
+    //! The words that were typed, with how many times, per language.
+    QHash<QString, QHash<QString, int>> m_learned;
+    QTimer *m_saveTimer = nullptr;
+};
diff --git a/src/systemlayoutsync.cpp b/src/systemlayoutsync.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..06397aa181ed98d6cd2ed30624473f6317df1af0
--- /dev/null
+++ b/src/systemlayoutsync.cpp
@@ -0,0 +1,227 @@
+/*
+    SPDX-FileCopyrightText: 2026 Chechulin Serhii
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "systemlayoutsync.h"
+#include "laptop/laptopcontroller.h"
+#include "logging.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QLocale>
+#include <QStandardPaths>
+
+namespace
+{
+constexpr auto s_service = "org.kde.keyboard";
+constexpr auto s_path = "/Layouts";
+constexpr auto s_iface = "org.kde.KeyboardLayouts";
+
+//! The Plasma OSD shows a popup on every layout change; the keyboard switches
+//! the layout itself, so the popup has to be kept out of the way while it is
+//! on screen. Key and group of that setting in plasmarc.
+constexpr auto s_plasmaConfig = "plasmarc";
+constexpr auto s_osdGroup = "OSD";
+constexpr auto s_osdKey = "kbdLayoutChangedEnabled";
+
+QDBusMessage layoutsCall(const QString &method)
+{
+    return QDBusMessage::createMethodCall(QLatin1String(s_service), QLatin1String(s_path), QLatin1String(s_iface), method);
+}
+}
+
+SystemLayoutSync::SystemLayoutSync(QObject *parent)
+    : QObject(parent)
+{
+    QDBusConnection::sessionBus()
+        .connect(QLatin1String(s_service), QLatin1String(s_path), QLatin1String(s_iface), QStringLiteral("layoutChanged"), this, SLOT(onLayoutChanged(uint)));
+
+    // A previous process may have died while the OSD was suppressed: the
+    // marker keeps the value the user had chosen, so put it back.
+    QFile marker(osdMarkerPath());
+    if (marker.exists() && marker.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        const QString saved = QString::fromUtf8(marker.readAll()).trimmed();
+        marker.close();
+        m_osdOriginal = saved != QLatin1String("false");
+        writeOsdEnabled(m_osdOriginal);
+        QFile::remove(osdMarkerPath());
+        qCWarning(PlasmaKeyboard) << "Restored the layout OSD setting after an unclean shutdown";
+    }
+}
+
+SystemLayoutSync::~SystemLayoutSync()
+{
+    restoreLayoutOsd();
+}
+
+bool SystemLayoutSync::readOsdEnabled() const
+{
+    KConfig config(QString::fromLatin1(s_plasmaConfig), KConfig::NoGlobals);
+    return KConfigGroup(&config, QString::fromLatin1(s_osdGroup)).readEntry(QString::fromLatin1(s_osdKey), true);
+}
+
+void SystemLayoutSync::writeOsdEnabled(bool enabled)
+{
+    KConfig config(QString::fromLatin1(s_plasmaConfig), KConfig::NoGlobals);
+    KConfigGroup group(&config, QString::fromLatin1(s_osdGroup));
+    // KConfig::Notify makes Plasma re-read the value at once instead of on the
+    // next restart, so the OSD is already gone when the layout is switched.
+    group.writeEntry(QString::fromLatin1(s_osdKey), enabled, KConfig::Notify);
+    config.sync();
+}
+
+QString SystemLayoutSync::osdMarkerPath()
+{
+    QString directory = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    if (directory.isEmpty()) {
+        directory = QDir::tempPath();
+    }
+    return directory + QStringLiteral("/uke-plasma-keyboard-custom/layout-osd-suppressed");
+}
+
+void SystemLayoutSync::suppressLayoutOsd()
+{
+    if (m_osdSuppressed) {
+        return;
+    }
+    m_osdOriginal = readOsdEnabled();
+    QDir().mkpath(QFileInfo(osdMarkerPath()).absolutePath());
+    QFile marker(osdMarkerPath());
+    if (marker.open(QIODevice::WriteOnly | QIODevice::Text)) {
+        marker.write(m_osdOriginal ? "true" : "false");
+        marker.close();
+    }
+    writeOsdEnabled(false);
+    m_osdSuppressed = true;
+}
+
+void SystemLayoutSync::restoreLayoutOsd()
+{
+    if (!m_osdSuppressed) {
+        return;
+    }
+    writeOsdEnabled(m_osdOriginal);
+    QFile::remove(osdMarkerPath());
+    m_osdSuppressed = false;
+}
+
+void SystemLayoutSync::setKeyboardVisible(bool visible)
+{
+    if (m_keyboardVisible == visible) {
+        return;
+    }
+    m_keyboardVisible = visible;
+    if (visible) {
+        suppressLayoutOsd();
+    } else {
+        restoreLayoutOsd();
+    }
+}
+
+namespace
+{
+QStringList parseLayouts(const QDBusMessage &reply)
+{
+    QStringList names;
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return names;
+    }
+    // a(sss): short name, variant, display name.
+    const QDBusArgument arg = reply.arguments().first().value<QDBusArgument>();
+    arg.beginArray();
+    while (!arg.atEnd()) {
+        QString shortName;
+        QString variant;
+        QString displayName;
+        arg.beginStructure();
+        arg >> shortName >> variant >> displayName;
+        arg.endStructure();
+        names.append(shortName);
+    }
+    arg.endArray();
+    return names;
+}
+}
+
+// Never block the GUI thread on the layout daemon: every call is asynchronous
+// and the continuation runs from the event loop.
+void SystemLayoutSync::fetchLayouts(std::function<void(const QStringList &)> done)
+{
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(layoutsCall(QStringLiteral("getLayoutsList"))), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [watcher, done = std::move(done)] {
+        done(parseLayouts(QDBusMessage(watcher->reply())));
+        watcher->deleteLater();
+    });
+}
+
+void SystemLayoutSync::fetchCurrentLayout(std::function<void(int)> done)
+{
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(layoutsCall(QStringLiteral("getLayout"))), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [watcher, done = std::move(done)] {
+        const QDBusMessage reply = watcher->reply();
+        done(reply.type() == QDBusMessage::ReplyMessage && !reply.arguments().isEmpty() ? static_cast<int>(reply.arguments().first().toUInt()) : -1);
+        watcher->deleteLater();
+    });
+}
+
+QString SystemLayoutSync::layoutForLocale(const QString &locale) const
+{
+    const QLocale qlocale(locale);
+    if (qlocale.language() == QLocale::C) {
+        return {};
+    }
+    if (qlocale.territory() != QLocale::AnyTerritory && locale.contains(QLatin1Char('_'))) {
+        return QLocale::territoryToCode(qlocale.territory()).toLower();
+    }
+    if (qlocale.language() == QLocale::English) {
+        return QStringLiteral("us");
+    }
+    return QLocale::languageToCode(qlocale.language()).toLower();
+}
+
+void SystemLayoutSync::syncToLocale(const QString &locale)
+{
+    if (auto *laptop=LaptopController::instance()) {
+        if (!laptop->options().value("syncLayout").toBool()) return;
+        if (laptop->backendReady() && laptop->options().value("nativePcLayout").toBool() && !laptop->complexLayout()) return;
+    }
+    const QString wanted = layoutForLocale(locale);
+    if (wanted.isEmpty()) {
+        return;
+    }
+    fetchLayouts([this, wanted, locale](const QStringList &names) {
+        const int index = names.indexOf(wanted);
+        if (index < 0) {
+            return;
+        }
+        fetchCurrentLayout([this, wanted, locale, index](int current) {
+            if (index == current) {
+                return;
+            }
+            qCDebug(PlasmaKeyboard) << "switching the system layout to" << wanted << "for" << locale;
+            QDBusMessage msg = layoutsCall(QStringLiteral("setLayout"));
+            msg << static_cast<uint>(index);
+            QDBusConnection::sessionBus().call(msg, QDBus::NoBlock);
+        });
+    });
+}
+
+void SystemLayoutSync::onLayoutChanged(uint index)
+{
+    fetchLayouts([this, index](const QStringList &names) {
+        if (index < static_cast<uint>(names.size())) {
+            Q_EMIT systemLayoutChanged(names.at(index));
+        }
+    });
+}
diff --git a/src/systemlayoutsync.h b/src/systemlayoutsync.h
new file mode 100644
index 0000000000000000000000000000000000000000..e1b301c39782201114a034d71bf5f35366a16298
--- /dev/null
+++ b/src/systemlayoutsync.h
@@ -0,0 +1,69 @@
+/*
+    SPDX-FileCopyrightText: 2026 Chechulin Serhii
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <QStringList>
+#include <functional>
+
+/**
+ * Keeps the system keyboard layout (org.kde.keyboard) and the language of the
+ * on-screen keyboard in step.
+ *
+ * For a window without text-input support (e.g. an XWayland application) KWin
+ * turns the committed text into key presses of the *current system layout*, so
+ * a Ukrainian letter typed while the system layout is "us" produces nothing.
+ * The layout matching a locale is found from its territory ("uk_UA" -> "ua",
+ * "en_US" -> "us"), falling back to its language code.
+ */
+class SystemLayoutSync : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit SystemLayoutSync(QObject *parent = nullptr);
+    ~SystemLayoutSync() override;
+
+    //! Switches the system layout to the one matching @p locale, if there is
+    //! one and it is not active already.
+    Q_INVOKABLE void syncToLocale(const QString &locale);
+
+    //! The system layout name @p locale corresponds to ("ua" for "uk_UA").
+    Q_INVOKABLE QString layoutForLocale(const QString &locale) const;
+
+    /**
+     * Suppresses the Plasma OSD for layout changes while the keyboard is on
+     * screen, and restores the user's setting once it is hidden.
+     *
+     * Switching the system layout from the keyboard would otherwise pop the
+     * "RU"/"EN" OSD over the keyboard on every language switch. The original
+     * value is kept in a runtime marker so a crash cannot leave the OSD off.
+     */
+    Q_INVOKABLE void setKeyboardVisible(bool visible);
+
+Q_SIGNALS:
+    //! The system layout was switched (by the user or by syncToLocale()).
+    void systemLayoutChanged(const QString &layout);
+
+private Q_SLOTS:
+    void onLayoutChanged(uint index);
+
+private:
+    void fetchLayouts(std::function<void(const QStringList &)> done);
+    void fetchCurrentLayout(std::function<void(int)> done);
+
+    bool readOsdEnabled() const;
+    void writeOsdEnabled(bool enabled);
+    void suppressLayoutOsd();
+    void restoreLayoutOsd();
+    static QString osdMarkerPath();
+
+    bool m_keyboardVisible = false;
+    bool m_osdSuppressed = false;
+    bool m_osdOriginal = true;
+};
diff --git a/src/touchdeliverypolicy.h b/src/touchdeliverypolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..de3ddf57502ebf17c461803e650ed69e9700db89
--- /dev/null
+++ b/src/touchdeliverypolicy.h
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QByteArray>
+#include <QtGlobal>
+
+namespace UkeKeyboard {
+inline void configureTouchDelivery()
+{
+    // Qt Quick normally holds touch updates until the next rendered frame.
+    // A virtual touchpad must forward input even while its surface is idle.
+    // This is process-local; no compositor or display settings are changed.
+    qputenv("QML_NO_TOUCH_COMPRESSION", QByteArrayLiteral("1"));
+}
+}
