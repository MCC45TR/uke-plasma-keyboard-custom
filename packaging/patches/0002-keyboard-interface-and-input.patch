+    function keyGeometry(code) {
+        for(let r=0;r<rowRepeater.count;r++){
+            const row=rowRepeater.itemAt(r);
+            if(!row)continue;
+            for(let k=0;k<row.keys.count;k++){
+                const key=row.keys.itemAt(k);
+                if(key&&key.code===code){const p=key.mapToItem(keyboard,0,0);return {width:key.width,x:p.x,viewport:keyboard.width};}
+            }
+        }
+        return null;
+    }
+    function feedback() {
+        if(click.item)click.item.play();
+        if(PlasmaKeyboardSettings.vibrationEnabled)Vibration.vibrate(PlasmaKeyboardSettings.vibrationMs,PlasmaKeyboardSettings.vibrationStrength);
+    }
+    Loader {
+        id: click
+        active: keyboard.visible && PlasmaKeyboardSettings.soundEnabled
+        sourceComponent: SoundEffect { source: "qrc:/sounds/keyboard_tick2_quiet.wav"; volume: 1; }
+    }
+    function emitKey(code,pressed,caption) {
+        if (localEditor && ![29,42,54,56,97,100,125,126].includes(code)) {
+            if (!pressed) return;
+            if(code===14){if(localEditor.selectionStart!==localEditor.selectionEnd)localEditor.remove(localEditor.selectionStart,localEditor.selectionEnd);else if(localEditor.cursorPosition>0)localEditor.remove(localEditor.cursorPosition-1,localEditor.cursorPosition);}
+            else if(code===105)localEditor.cursorPosition=Math.max(0,localEditor.cursorPosition-1);
+            else if(code===106)localEditor.cursorPosition=Math.min(localEditor.text.length,localEditor.cursorPosition+1);
+            else if(code===57)localEditor.insert(localEditor.cursorPosition," ");
+            else if(caption.length===1)localEditor.insert(localEditor.cursorPosition,caption);
+            return;
+        }
+        Keyboard.Laptop.key(code,pressed);
+    }
+    function tapKey(code,caption){emitKey(code,true,caption);emitKey(code,false,caption);}
+    function keyMap() {
+        const result = [];
+        for (let r=0;r<rowRepeater.count;r++) {
+            const row=rowRepeater.itemAt(r);
+            for(let k=0;k<row.keys.count;k++) {
+                const key=row.keys.itemAt(k);
+                const text=key.caption;
+                if(text.length===1 && text.toLowerCase()!==text.toUpperCase()) {
+                    const p=key.mapToItem(keyboard,0,0);
+                    result.push({letter:text.toLowerCase(),x:p.x,y:p.y,w:key.width,h:key.height});
+                }
+            }
+        }
+        return result;
+    }
+    Column {
+        anchors.fill: parent
+        spacing: keyboard.gap
+        Repeater {
+            id: rowRepeater
+            model: Keyboard.Laptop.rows
+            delegate: Row {
+                id: row
+                required property var modelData
+                property alias keys: keysRepeater
+                readonly property real units: modelData.reduce((sum,k)=>sum+k.units,0)
+                width: Math.min(keyboard.width, units*Keyboard.Laptop.options.keyWidthMm*keyboard.perMm + Math.max(0,modelData.length-1)*keyboard.gap)
+                x: (keyboard.width-width)/2
+                height: keyboard.keyHeight
+                spacing: keyboard.gap
+                Repeater {
+                    id: keysRepeater
+                    model: row.modelData
+                    delegate: Kirigami.ShadowedRectangle {
+                        id: keyItem
+                        required property var modelData
+                        objectName: "ukeKey_"+code
+                        readonly property int code: modelData.code
+                        readonly property string caption: { Keyboard.Laptop.keyRevision; return Keyboard.Laptop.keyLabel(code,modelData.dynamic ? "" : modelData.label); }
+                        readonly property bool isLatched: { Keyboard.Laptop.keyRevision; return Keyboard.Laptop.latched(code); }
+                        readonly property string category: modelData.modifier||code===58?"modifier":code===28?"accent":(code>=2&&code<=13)?"digit":(code===14||(code>=59&&code<=88)||code>=99)?"function":"normal"
+                        readonly property var outline: Keyboard.Theme.current.keyOutlineFor(category)
+                        readonly property real shadowStrength: Keyboard.Theme.current.keyShadowFor(category)
+                        property bool down: false
+                        property bool sent: false
+                        property bool moved: false
+                        property var editingTarget: null
+                        property bool editingWasLocal: false
+                        property bool popupUsed: false
+                        property real startX: 0
+                        property real lastStep: 0
+                        property var trace: []
+                        property real began: 0
+                        readonly property bool letter: caption.length===1 && caption.toLowerCase()!==caption.toUpperCase()
+                        readonly property bool deferred: letter || code===57 || code===14
+                        width: Math.max(1, (row.width-Math.max(0,row.modelData.length-1)*row.spacing)/row.units*modelData.units)
+                        height: row.height
+                        radius: Math.min(height/4,Keyboard.BreezeConstants.buttonRadius)
+                        color: down ? Keyboard.Theme.current.keyColorFor(category,"pressed") : (isLatched ? Keyboard.Theme.current.categoryActiveColorFor(category) : Keyboard.Theme.current.keyColorFor(category,"normal"))
+                        border.width: outline.width
+                        border.color: outline.color
+                        shadow.size: 3*shadowStrength
+                        shadow.yOffset: shadowStrength
+                        shadow.color: Qt.rgba(0,0,0,0.2*shadowStrength)
+                        Accessible.role: Accessible.Button
+                        Accessible.name: caption
+                        Accessible.onPressAction: {keyboard.feedback();keyboard.tapKey(code,caption);}
+                        Text {
+                            anchors.fill: parent
+                            anchors.margins: keyboard.perMm*0.8
+                            text: keyItem.caption
+                            color: Keyboard.Theme.current.keyTextColorFor(keyItem.category)
+                            font.family: Keyboard.BreezeConstants.fontFamily
+                            font.pixelSize: Math.max(7,Math.min(parent.height*0.36,keyboard.perMm*3.4))
+                            font.bold: keyItem.modelData.modifier
+                            horizontalAlignment: Text.AlignHCenter
+                            verticalAlignment: Text.AlignVCenter
+                            minimumPixelSize: 6
+                            fontSizeMode: Text.Fit
+                            elide: Text.ElideRight
+                        }
+                        QQC2.ToolTip.visible: down && Keyboard.Laptop.options.keyPreview && letter
+                        QQC2.ToolTip.text: caption
+                        Timer {
+                            id: hold
+                            interval: 450
+                            onTriggered: {
+                                if(!keyItem.down||keyItem.moved)return;
+                                if(keyItem.letter && PlasmaKeyboardSettings.diacriticsPopupEnabled) {
+                                    const variants=Keyboard.Laptop.alternatives(keyItem.caption);
+                                    if(variants.length>0){alternatePopup.choices=variants;alternatePopup.open();keyItem.popupUsed=true;}
+                                } else if(keyItem.code===14 || keyItem.code===57) {
+                                    keyItem.sent=true;keyboard.emitKey(keyItem.code,true,keyItem.caption);
+                                }
+                            }
+                        }
+                        QQC2.Popup {
+                            id: alternatePopup
+                            property var choices: []
+                            y: -height-keyboard.perMm
+                            x: Math.max(-keyItem.x,Math.min(0,keyboard.width-keyItem.x-implicitWidth))
+                            padding: keyboard.perMm
+                            contentItem: Row {
+                                spacing: keyboard.gap
+                                Repeater {
+                                    model: alternatePopup.choices
+                                    delegate: QQC2.Button {
+                                        required property string modelData
+                                        text: modelData
+                                        implicitWidth: Math.max(30,9*keyboard.perMm)
+                                        implicitHeight: Math.max(30,10*keyboard.perMm)
+                                        focusPolicy: Qt.NoFocus
+                                        onClicked: { if(keyItem.editingWasLocal){if(keyItem.editingTarget)keyItem.editingTarget.insert(keyItem.editingTarget.cursorPosition,modelData);}else if(keyboard.target)keyboard.target.commitText(modelData);alternatePopup.close(); }
+                                    }
+                                }
+                            }
+                        }
+                        MultiPointTouchArea {
+                            anchors.fill: parent
+                            minimumTouchPoints: 1
+                            maximumTouchPoints: 1
+                            mouseEnabled: true
+                            onGestureStarted: gesture => gesture.grab()
+                            onPressed: points => {
+                                const p=points[0];keyItem.down=true;keyItem.sent=false;keyItem.moved=false;keyItem.popupUsed=false;
+                                keyItem.editingTarget=keyboard.localEditor;
+                                keyItem.editingWasLocal=!!keyItem.editingTarget;
+                                keyboard.feedback();
+                                keyItem.startX=p.x;keyItem.lastStep=0;keyItem.began=Date.now();
+                                const q=keyItem.mapToItem(keyboard,p.x,p.y);keyItem.trace=[{x:q.x,y:q.y,t:0}];
+                                if(!keyItem.deferred){keyItem.sent=true;keyboard.emitKey(keyItem.code,true,keyItem.caption);}
+                                hold.restart();
+                            }
+                            onUpdated: points => {
+                                if(!keyItem.down||points.length===0)return;
+                                const p=points[0];const dx=(p.x-keyItem.startX)/keyboard.perMm;
+                                if(keyItem.code===57 && Keyboard.Laptop.options.spaceGesture && Math.abs(dx)>2) {
+                                    const step=Math.trunc(dx/2);if(keyItem.editingWasLocal){if(keyItem.editingTarget&&keyboard.target)keyboard.target.editCursor(step-keyItem.lastStep,keyItem.editingTarget);}else Keyboard.Laptop.moveCursor(step-keyItem.lastStep);keyItem.lastStep=step;keyItem.moved=true;hold.stop();
+                                } else if(keyItem.code===14 && Keyboard.Laptop.options.deleteGesture && dx < -3) {
+                                    const step=Math.max(keyItem.lastStep,Math.floor(-dx/5));if(step>keyItem.lastStep){if(keyItem.editingWasLocal){if(keyItem.editingTarget&&keyboard.target)keyboard.target.deleteWordGesture(step-keyItem.lastStep,keyItem.editingTarget);}else Keyboard.Laptop.deleteWords(step-keyItem.lastStep);}keyItem.lastStep=step;keyItem.moved=true;hold.stop();
+                                } else if(keyItem.letter) {
+                                    const q=keyItem.mapToItem(keyboard,p.x,p.y);keyItem.trace.push({x:q.x,y:q.y,t:Date.now()-keyItem.began});
+                                    if(Math.abs(dx)>5||Math.abs(p.y)/keyboard.perMm>10){keyItem.moved=true;hold.stop();}
+                                }
+                            }
+                            onReleased: {
+                                hold.stop();
+                                if(keyItem.sent)keyboard.emitKey(keyItem.code,false,keyItem.caption);
+                                else if(!keyItem.popupUsed) {
+                                    if(keyItem.letter && keyItem.moved && keyboard.auxiliaryAllowed && PlasmaKeyboardSettings.swipeTypingEnabled && keyboard.recognizer && keyboard.recognizer.supports(Keyboard.Laptop.locale)) {
+                                        const words=keyboard.recognizer.recognize(Keyboard.Laptop.locale,keyItem.trace,keyboard.keyMap(),[],5);
+                                        if(words.length>0){if(keyItem.editingWasLocal){if(keyItem.editingTarget)keyItem.editingTarget.insert(keyItem.editingTarget.cursorPosition,words[0]+" ");}else{keyboard.target.commitSwipeWord(words[0]);keyboard.swipeAccepted(words);}}
+                                    } else if(!keyItem.moved)keyboard.tapKey(keyItem.code,keyItem.caption);
+                                }
+                                keyItem.down=false;
+                            }
+                            onCanceled: {hold.stop();if(keyItem.sent)keyboard.emitKey(keyItem.code,false,keyItem.caption);keyItem.down=false;}
+                        }
+                        Component.onDestruction: { if(sent&&down)keyboard.emitKey(code,false,caption); }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/src/qml/Touchpad.qml b/src/qml/Touchpad.qml
new file mode 100644
index 0000000000000000000000000000000000000000..383cef83a6ff21b16a7efca4dd77632cbccf7932
--- /dev/null
+++ b/src/qml/Touchpad.qml
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kirigami as Kirigami
+import org.uke.plasma.keyboard.lib as Keyboard
+ColumnLayout {
+    id: root
+    property real perMm: Keyboard.Laptop.pixelsPerMm
+    spacing: perMm
+    Rectangle {
+        Layout.fillWidth: true
+        Layout.fillHeight: true
+        radius: Kirigami.Units.cornerRadius
+        color: Kirigami.Theme.alternateBackgroundColor
+        border.color: Qt.rgba(Kirigami.Theme.textColor.r,Kirigami.Theme.textColor.g,Kirigami.Theme.textColor.b,0.16)
+        border.width: 1
+        Accessible.role: Accessible.Pane
+        Accessible.name: i18nd("uke-plasma-keyboard-custom", "Touchpad")
+        QQC2.Label {
+            anchors.bottom: parent.bottom
+            anchors.bottomMargin: root.perMm*2
+            anchors.horizontalCenter: parent.horizontalCenter
+            text: i18nd("uke-plasma-keyboard-custom", "Touchpad")
+            font: Kirigami.Theme.smallFont
+            color: Kirigami.Theme.disabledTextColor
+        }
+        MultiPointTouchArea {
+            id: touch
+            anchors.fill: parent
+            mouseEnabled: false
+            minimumTouchPoints: 1
+            maximumTouchPoints: 5
+            touchPoints: [TouchPoint{id:a},TouchPoint{id:b},TouchPoint{id:c},TouchPoint{id:d},TouchPoint{id:e}]
+            property bool sequence: false
+            property bool blocked: false
+            property bool dragged: false
+            property bool moved: false
+            property int fingers: 0
+            property int maxFingers: 0
+            property string gesture: ""
+            property var previous: ({x:0,y:0,distance:0,angle:0})
+            property var origin: ({x:0,y:0,distance:0,angle:0})
+            property real started: 0
+            property real lastTap: 0
+            function angleDelta(current,previous) {return (current-previous+540)%360-180;}
+            function snapshot() {
+                const points=[a,b,c,d,e].filter(p=>p.pressed);
+                if(points.length===0)return {n:0,x:0,y:0,distance:0,angle:0};
+                let x=0,y=0;for(const p of points){x+=p.x;y+=p.y;}
+                const dx=points.length>1?points[1].x-points[0].x:0;
+                const dy=points.length>1?points[1].y-points[0].y:0;
+                return {n:points.length,x:x/points.length,y:y/points.length,distance:Math.hypot(dx,dy),angle:Math.atan2(dy,dx)*180/Math.PI};
+            }
+            function stopGesture(cancel) {
+                if(gesture==="swipe")Keyboard.Laptop.swipe(fingers,cancel?3:2,0,0);
+                if(gesture==="pinch")Keyboard.Laptop.pinch(cancel?3:2,1,0,0,0);
+                if(gesture==="scroll")Keyboard.Laptop.scroll(0,0);
+                gesture="";
+            }
+            function update() {
+                const p=snapshot();
+                if(p.n===0) {
+                    if(!sequence)return;
+                    Keyboard.Laptop.resetPadMotion();
+                    if(dragged)Keyboard.Laptop.button(272,false);
+                    else if(!blocked&&!moved&&Date.now()-started<300&&maxFingers<=2){const button=maxFingers===2?273:272;Keyboard.Laptop.button(button,true);Keyboard.Laptop.button(button,false);lastTap=maxFingers===1?Date.now():0;}
+                    stopGesture(false);sequence=false;fingers=0;return;
+                }
+                if(!sequence) {
+                    Keyboard.Laptop.resetPadMotion();
+                    sequence=true;started=Date.now();maxFingers=p.n;moved=false;gesture="";dragged=false;
+                    blocked=Keyboard.Laptop.options.palmGuard&&Keyboard.Laptop.typing&&!Keyboard.Laptop.modifierActive;
+                    if(!blocked&&p.n===1&&Date.now()-lastTap<300){Keyboard.Laptop.button(272,true);dragged=true;}
+                    fingers=p.n;origin=p;previous=p;return;
+                }
+                maxFingers=Math.max(maxFingers,p.n);
+                if(p.n!==fingers){stopGesture(true);Keyboard.Laptop.resetPadMotion();fingers=p.n;origin=p;previous=p;return;}
+                if(blocked)return;
+                const dx=p.x-previous.x,dy=p.y-previous.y;
+                if(Math.hypot(p.x-origin.x,p.y-origin.y)>1.5*root.perMm)moved=true;
+                if(p.n===1)Keyboard.Laptop.padMotion(dx/root.perMm,dy/root.perMm);
+                else if(p.n===2) {
+                    const ratio=origin.distance>0?p.distance/origin.distance:1;
+                    if(gesture===""&&(Math.abs(ratio-1)>0.06||Math.abs(angleDelta(p.angle,origin.angle))>7)){gesture="pinch";moved=true;Keyboard.Laptop.pinch(0,1,0,0,0);}
+                    if(gesture==="pinch")Keyboard.Laptop.pinch(1,ratio,angleDelta(p.angle,previous.angle),dx,dy);
+                    else if(moved){gesture="scroll";Keyboard.Laptop.scroll(dx,dy);}
+                } else if(p.n<=4 && moved) {
+                    if(gesture!=="swipe"){gesture="swipe";Keyboard.Laptop.swipe(p.n,0,0,0);}
+                    Keyboard.Laptop.swipe(p.n,1,dx,dy);
+                }
+                previous=p;
+            }
+            onPressed: update()
+            onUpdated: update()
+            onReleased: update()
+            onCanceled: {stopGesture(true);Keyboard.Laptop.resetPadMotion();if(dragged)Keyboard.Laptop.button(272,false);sequence=false;fingers=0;}
+            onGestureStarted: gesture => gesture.grab()
+            Component.onDestruction: {stopGesture(true);Keyboard.Laptop.resetPadMotion();if(dragged)Keyboard.Laptop.button(272,false);}
+        }
+    }
+    RowLayout {
+        Layout.fillWidth: true
+        visible: Keyboard.Laptop.options.leftButton||Keyboard.Laptop.options.middleButton||Keyboard.Laptop.options.rightButton
+        Repeater {
+            model: [{option:"leftButton",label:i18nd("uke-plasma-keyboard-custom", "Left"),code:272},{option:"middleButton",label:i18nd("uke-plasma-keyboard-custom", "Middle"),code:274},{option:"rightButton",label:i18nd("uke-plasma-keyboard-custom", "Right"),code:273}]
+            delegate: QQC2.ToolButton {
+                required property var modelData
+                visible: Keyboard.Laptop.options[modelData.option]
+                Layout.fillWidth: true
+                Layout.preferredHeight: root.perMm*9
+                text: modelData.label
+                focusPolicy: Qt.NoFocus
+                onPressed: Keyboard.Laptop.button(modelData.code,true)
+                onReleased: Keyboard.Laptop.button(modelData.code,false)
+                onCanceled: Keyboard.Laptop.button(modelData.code,false)
+            }
+        }
+    }
+}
diff --git a/src/qml/VoicePanel.qml b/src/qml/VoicePanel.qml
new file mode 100644
index 0000000000000000000000000000000000000000..fda9733cad641166ea88618655b4489e6bdfd2a2
--- /dev/null
+++ b/src/qml/VoicePanel.qml
@@ -0,0 +1,450 @@
+// SPDX-FileCopyrightText: 2026 Aleksandr Kvintilyanov <bednyj.mops@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+import org.uke.plasma.keyboard.lib as PlasmaKeyboard
+
+/**
+ * The voice input mode: while it is on, the keys are replaced by one big
+ * microphone button in the middle of the keyboard area, the way the phone
+ * keyboards show it.
+ *
+ * The first tap starts the recording, the second one stops it and recognises
+ * what was said. The recognised text is inserted by the keyboard, which also
+ * leaves this mode. The row under the button keeps the keys that are needed
+ * while dictating: the space bar, backspace and enter.
+ *
+ * A gamepad drives the page the same way it drives the ordinary keyboard: the
+ * directions move the highlight between the seven controls (the microphone, the
+ * four keys of the row under it and the two corner buttons), A activates the
+ * highlighted one, and every control carries the badge of the button that
+ * reaches it.
+ */
+Item {
+    id: root
+
+    /*! Whether the microphone is recording right now. */
+    property bool recording: false
+
+    /*! Whether a recorded phrase is being recognised. */
+    property bool busy: false
+
+    /*! Peak level of the recording, 0..1, for the pulsing ring. */
+    property real level: 0
+
+    /*! Message shown under the button, for example when the model is missing. */
+    property string message: ""
+
+    /*! Whether the gamepad navigation is on: the highlight is shown on the
+        element the gamepad selected. */
+    property bool highlighted: false
+
+    /*! Index of the element the gamepad selected, see the focus* properties. */
+    property int focusIndex: 0
+
+    /*! Name of the language of the active layout, shown on the space bar the
+        same way the ordinary keyboard shows it. */
+    property string languageName: ""
+
+    /*! Height of the keys in the row under the microphone. */
+    readonly property real keyHeight: Math.min(height * 0.17, width * 0.11)
+
+    // The controls the gamepad walks, in the order of the focus index: the
+    // microphone, then the row under it (language, space, enter, backspace),
+    // then the corner buttons (hide, back).
+    readonly property int microphoneIndex: 0
+    readonly property int actionRowFirstIndex: 1
+    readonly property int actionRowCount: 4
+    readonly property int hideIndex: actionRowFirstIndex + actionRowCount
+    readonly property int closeIndex: hideIndex + 1
+
+    signal toggleRequested()
+    signal closeRequested()
+    signal hideRequested()
+    signal languageRequested()
+    signal spaceRequested()
+    signal enterRequested()
+    signal backspaceRequested()
+
+    /*! First element of the group the gamepad walks inside. */
+    function groupFirstIndex(group) {
+        if (group === 0) {
+            return microphoneIndex;
+        }
+        return group === 1 ? actionRowFirstIndex : hideIndex;
+    }
+
+    /*! Number of elements in that group. */
+    function groupCount(group) {
+        if (group === 0) {
+            return 1;
+        }
+        return group === 1 ? actionRowCount : 2;
+    }
+
+    /*! Group of the given element: 0 — the microphone, 1 — the row under it,
+        2 — the corner buttons. */
+    function groupOf(index) {
+        if (index <= microphoneIndex) {
+            return 0;
+        }
+        return index < hideIndex ? 1 : 2;
+    }
+
+    /*! Whether the gamepad highlight is on the element with that index. */
+    function focused(index) {
+        return root.highlighted && root.focusIndex === index;
+    }
+
+    /*! Moves the highlight with a gamepad direction. Sideways it walks the
+        group the highlight is in, up and down it walks the groups. */
+    function navigate(key) {
+        const group = root.groupOf(root.focusIndex);
+        const first = root.groupFirstIndex(group);
+        const count = root.groupCount(group);
+
+        if (key === Qt.Key_Left || key === Qt.Key_Right) {
+            const offset = root.focusIndex - first;
+            const step = key === Qt.Key_Right ? 1 : count - 1;
+            root.focusIndex = first + (offset + step) % count;
+            return;
+        }
+
+        if (key === Qt.Key_Up || key === Qt.Key_Down) {
+            const nextGroup = (group + (key === Qt.Key_Down ? 1 : 2)) % 3;
+            root.focusIndex = root.groupFirstIndex(nextGroup);
+        }
+    }
+
+    /*! Activates the element the highlight is on, like A on the ordinary
+        keyboard types the highlighted key. */
+    function activate() {
+        switch (root.focusIndex) {
+        case root.microphoneIndex:
+            root.toggleRequested();
+            break;
+        case root.actionRowFirstIndex:
+            root.languageRequested();
+            break;
+        case root.actionRowFirstIndex + 1:
+            root.spaceRequested();
+            break;
+        case root.actionRowFirstIndex + 2:
+            root.enterRequested();
+            break;
+        case root.actionRowFirstIndex + 3:
+            root.backspaceRequested();
+            break;
+        case root.hideIndex:
+            root.hideRequested();
+            break;
+        case root.closeIndex:
+            root.closeRequested();
+            break;
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: PlasmaKeyboard.Theme.current.keyboardBackgroundColor
+    }
+
+    // Swallow the taps that land next to the controls: the keys below must not
+    // react while the voice mode covers them.
+    MouseArea {
+        anchors.fill: parent
+    }
+
+    // Corner buttons: hide the keyboard and go back to the ordinary keyboard.
+    // The arrow is deliberately large: leaving the voice mode has to be obvious.
+    Row {
+        id: cornerButtons
+        anchors.top: parent.top
+        anchors.right: parent.right
+        anchors.margins: PlasmaKeyboard.BreezeConstants.keyBackgroundMargin * 2
