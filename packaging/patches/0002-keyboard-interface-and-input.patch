new file mode 100644
index 0000000000000000000000000000000000000000..5e0a8ae6d7147fba5835b8b67c1e036a8728ec9c
--- /dev/null
+++ b/src/editingtext.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QObject>
+#include <QTextCursor>
+#include <QTextDocument>
+#include <QVariant>
+#include <algorithm>
+#include <cstdlib>
+namespace UkeKeyboard {
+// Local toolbar editors never fall through to the external input context.
+inline void editLocalText(QObject *editor,int amount,bool words) {
+    if(!editor||!editor->property("text").isValid()||!editor->property("cursorPosition").isValid())return;
+    const auto text=editor->property("text").toString();
+    const int position=std::clamp(editor->property("cursorPosition").toInt(),0,int(text.size()));
+    QTextDocument document;document.setPlainText(text);QTextCursor cursor(&document);cursor.setPosition(position);
+    if(words){
+        if(amount<=0)return;
+        int start=std::clamp(editor->property("selectionStart").toInt(),0,int(text.size()));
+        int end=std::clamp(editor->property("selectionEnd").toInt(),0,int(text.size()));
+        if(start==end){cursor.movePosition(QTextCursor::PreviousWord,QTextCursor::KeepAnchor,std::min(amount,32));start=cursor.selectionStart();end=cursor.selectionEnd();}
+        if(start>end)std::swap(start,end);
+        if(start!=end)QMetaObject::invokeMethod(editor,"remove",Q_ARG(int,start),Q_ARG(int,end));
+        editor->setProperty("cursorPosition",start);
+    }else{
+        const int count=std::abs(std::clamp(amount,-32,32));
+        cursor.movePosition(amount<0?QTextCursor::PreviousCharacter:QTextCursor::NextCharacter,QTextCursor::MoveAnchor,count);
+        editor->setProperty("cursorPosition",cursor.position());
+    }
+}
+}
diff --git a/src/fileidentity.h b/src/fileidentity.h
new file mode 100644
index 0000000000000000000000000000000000000000..e734db92334c9a3fce2b6d88f58e409b3c3dc437
--- /dev/null
+++ b/src/fileidentity.h
@@ -0,0 +1,24 @@
+// SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QFile>
+#include <optional>
+#include <sys/stat.h>
+
+namespace UkeKeyboard {
+struct FileIdentity {
+    quint64 device;
+    quint64 inode;
+    bool operator==(const FileIdentity &) const = default;
+};
+
+inline std::optional<FileIdentity> fileIdentity(const QString &path)
+{
+    struct stat status {};
+    if (::stat(QFile::encodeName(path).constData(), &status) != 0 || !S_ISREG(status.st_mode)) {
+        return std::nullopt;
+    }
+    return FileIdentity{quint64(status.st_dev), quint64(status.st_ino)};
+}
+}
diff --git a/src/focusededitabletracker.cpp b/src/focusededitabletracker.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3d73e29272792cbae407629b9d01e9e2d9bac936
--- /dev/null
+++ b/src/focusededitabletracker.cpp
@@ -0,0 +1,232 @@
+/*
+    SPDX-FileCopyrightText: 2026 Chechulin Serhii
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "focusededitabletracker.h"
+
+#include "logging.h"
+
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusVariant>
+#include <QGuiApplication>
+#include <QScreen>
+#include <QUuid>
+
+namespace
+{
+constexpr uint editableState = 7;
+constexpr uint screenCoordinates = 0;
+// Hit testing is optional: a slow application must never hold up key forwarding.
+constexpr int requestTimeoutMs = 1000;
+const QString focusedEvent = QStringLiteral("object:state-changed:focused");
+const QString registryService = QStringLiteral("org.a11y.atspi.Registry");
+const QString registryPath = QStringLiteral("/org/a11y/atspi/registry");
+
+QDBusMessage registryCall(const QString &method)
+{
+    return QDBusMessage::createMethodCall(registryService, registryPath, registryService, method);
+}
+
+bool hasState(const QList<uint> &words, uint state)
+{
+    const qsizetype word = state / 32;
+    return word < words.size() && (words.at(word) & (uint(1) << (state % 32)));
+}
+
+QPointF mapTouchToScreen(const QPointF &position, const QScreen *screen)
+{
+    QPointF mapped = position;
+    switch (screen->angleBetween(screen->nativeOrientation(), screen->orientation())) {
+    case 90:
+        mapped = QPointF(1.0 - position.y(), position.x());
+        break;
+    case 180:
+        mapped = QPointF(1.0 - position.x(), 1.0 - position.y());
+        break;
+    case 270:
+        mapped = QPointF(position.y(), 1.0 - position.x());
+        break;
+    default:
+        break;
+    }
+
+    const QRect geometry = screen->geometry();
+    return QPointF(geometry.x() + mapped.x() * geometry.width(), geometry.y() + mapped.y() * geometry.height());
+}
+}
+
+FocusedEditableTracker::FocusedEditableTracker(QObject *parent)
+    : QObject(parent)
+{
+    // QDBusInterface construction can itself introspect synchronously. Use raw
+    // messages throughout, including discovery, registration and teardown.
+    const auto request = QDBusMessage::createMethodCall(QStringLiteral("org.a11y.Bus"),
+                                                        QStringLiteral("/org/a11y/bus"),
+                                                        QStringLiteral("org.a11y.Bus"),
+                                                        QStringLiteral("GetAddress"));
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(request, requestTimeoutMs), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *pending) {
+        const QDBusPendingReply<QString> address = *pending;
+        pending->deleteLater();
+        if (address.isError() || address.value().isEmpty()) {
+            return;
+        }
+
+        m_connectionName = QStringLiteral("plasma-keyboard-atspi-%1").arg(QUuid::createUuid().toString(QUuid::Id128));
+        const auto bus = QDBusConnection::connectToBus(address.value(), m_connectionName);
+        if (!bus.isConnected()) {
+            QDBusConnection::disconnectFromBus(m_connectionName);
+            m_connectionName.clear();
+            return;
+        }
+        initialize(bus);
+    });
+}
+
+FocusedEditableTracker::FocusedEditableTracker(const QDBusConnection &bus, QObject *parent)
+    : QObject(parent)
+{
+    initialize(bus);
+}
+
+void FocusedEditableTracker::initialize(const QDBusConnection &bus)
+{
+    m_bus = std::make_unique<QDBusConnection>(bus);
+    if (!m_bus->connect(QString(),
+                        QString(),
+                        QStringLiteral("org.a11y.atspi.Event.Object"),
+                        QStringLiteral("StateChanged"),
+                        this,
+                        SLOT(stateChanged(QString, int, int, QDBusVariant, QVariantMap, QDBusMessage)))) {
+        m_bus.reset();
+        return;
+    }
+
+    auto request = registryCall(QStringLiteral("RegisterEvent"));
+    request << focusedEvent << QStringList() << m_bus->baseService();
+    auto *watcher = new QDBusPendingCallWatcher(m_bus->asyncCall(request, requestTimeoutMs), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *pending) {
+        const bool failed = pending->isError();
+        pending->deleteLater();
+        if (failed) {
+            ++m_focusGeneration;
+            m_focusedEditableRect = {};
+            if (m_bus) {
+                m_bus->disconnect(QString(),
+                                  QString(),
+                                  QStringLiteral("org.a11y.atspi.Event.Object"),
+                                  QStringLiteral("StateChanged"),
+                                  this,
+                                  SLOT(stateChanged(QString, int, int, QDBusVariant, QVariantMap, QDBusMessage)));
+            }
+            m_bus.reset();
+        }
+    });
+}
+
+FocusedEditableTracker::~FocusedEditableTracker()
+{
+    if (m_bus) {
+        auto request = registryCall(QStringLiteral("DeregisterEvent"));
+        request << focusedEvent << m_bus->baseService();
+        // No introspection or waiting while the input method is being removed.
+        m_bus->send(request);
+        m_bus.reset();
+    }
+    if (!m_connectionName.isEmpty()) {
+        QDBusConnection::disconnectFromBus(m_connectionName);
+    }
+}
+
+bool FocusedEditableTracker::containsNormalizedTouch(const QPointF &position) const
+{
+    if (!m_focusedEditableRect.isValid()) {
+        return false;
+    }
+    // AT-SPI reports global coordinates, so the touch has to be mapped onto the
+    // screen the field is on, not blindly onto the primary one. When no screen
+    // can be associated with the field the position is uncertain, and the
+    // keyboard is shown rather than hidden from a field the user is holding.
+    const QScreen *screen = QGuiApplication::screenAt(m_focusedEditableRect.center());
+    if (!screen) {
+        return true;
+    }
+    return m_focusedEditableRect.contains(mapTouchToScreen(position, screen).toPoint());
+}
+
+bool FocusedEditableTracker::hasFocusedEditable() const
+{
+    return m_focusedEditableRect.isValid();
+}
+
+void FocusedEditableTracker::stateChanged(const QString &state, int enabled, int, const QDBusVariant &, const QVariantMap &, const QDBusMessage &message)
+{
+    if (state.compare(QStringLiteral("focused"), Qt::CaseInsensitive) != 0 || !m_bus) {
+        return;
+    }
+
+    if (!enabled) {
+        if (message.service() == m_focusedService && message.path() == m_focusedPath) {
+            ++m_focusGeneration;
+            m_focusedService.clear();
+            m_focusedPath.clear();
+            m_focusedEditableRect = {};
+        }
+        return;
+    }
+
+    // Invalidate immediately, including when the new object is non-editable or
+    // fails to reply. Older replies must never restore another field's bounds.
+    const quint64 generation = ++m_focusGeneration;
+    m_focusedService = message.service();
+    m_focusedPath = message.path();
+    m_focusedEditableRect = {};
+    const auto request =
+        QDBusMessage::createMethodCall(m_focusedService, m_focusedPath, QStringLiteral("org.a11y.atspi.Accessible"), QStringLiteral("GetState"));
+    auto *watcher = new QDBusPendingCallWatcher(m_bus->asyncCall(request, requestTimeoutMs), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, generation](QDBusPendingCallWatcher *pending) {
+        const QDBusMessage reply = pending->reply();
+        pending->deleteLater();
+        if (!m_bus || generation != m_focusGeneration || reply.type() != QDBusMessage::ReplyMessage || reply.signature() != QLatin1String("au")) {
+            return;
+        }
+        QList<uint> states;
+        const QDBusArgument argument = reply.arguments().constFirst().value<QDBusArgument>();
+        argument >> states;
+        if (!hasState(states, editableState)) {
+            return;
+        }
+
+        auto request =
+            QDBusMessage::createMethodCall(m_focusedService, m_focusedPath, QStringLiteral("org.a11y.atspi.Component"), QStringLiteral("GetExtents"));
+        request << screenCoordinates;
+        auto *extentsWatcher = new QDBusPendingCallWatcher(m_bus->asyncCall(request, requestTimeoutMs), this);
+        connect(extentsWatcher, &QDBusPendingCallWatcher::finished, this, [this, generation](QDBusPendingCallWatcher *pending) {
+            const QDBusMessage reply = pending->reply();
+            pending->deleteLater();
+            if (!m_bus || generation != m_focusGeneration || reply.type() != QDBusMessage::ReplyMessage || reply.signature() != QLatin1String("(iiii)")) {
+                return;
+            }
+
+            int x = 0;
+            int y = 0;
+            int width = 0;
+            int height = 0;
+            const QDBusArgument extents = reply.arguments().constFirst().value<QDBusArgument>();
+            extents.beginStructure();
+            extents >> x >> y >> width >> height;
+            extents.endStructure();
+            const QRect rectangle(x, y, width, height);
+            if (rectangle.isValid()) {
+                m_focusedEditableRect = rectangle;
+                qCDebug(PlasmaKeyboard) << "Focused editable AT-SPI rectangle:" << rectangle;
+            }
+        });
+    });
+}
diff --git a/src/focusededitabletracker.h b/src/focusededitabletracker.h
new file mode 100644
index 0000000000000000000000000000000000000000..1764cf12769149db30b7853df6ba112cfebeb8df
--- /dev/null
+++ b/src/focusededitabletracker.h
@@ -0,0 +1,60 @@
+/*
+    SPDX-FileCopyrightText: 2026 Chechulin Serhii
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QRect>
+
+#include <memory>
+
+class QDBusConnection;
+class QDBusMessage;
+class QDBusVariant;
+
+/**
+ * Remembers the screen rectangle of the focused editable AT-SPI object.
+ *
+ * The input-method-v1 protocol does not expose the target widget geometry.
+ * AT-SPI fills that gap for a field which remains focused after the keyboard
+ * has been hidden, without treating an arbitrary hold in the same window as a
+ * request to show the keyboard.
+ */
+class FocusedEditableTracker : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit FocusedEditableTracker(QObject *parent = nullptr);
+    // Use an already connected accessibility bus (also useful for isolated tests).
+    explicit FocusedEditableTracker(const QDBusConnection &bus, QObject *parent = nullptr);
+    ~FocusedEditableTracker() override;
+
+    bool containsNormalizedTouch(const QPointF &position) const;
+
+    /**
+     * Whether the focused editable widget has a known screen rectangle.
+     *
+     * When it is unknown (no accessibility bus, an application that does not
+     * expose its objects, or a query that has not answered yet) a touch cannot
+     * be proven to belong to another widget, so callers must not use the hit
+     * test to veto showing the keyboard.
+     */
+    bool hasFocusedEditable() const;
+
+private Q_SLOTS:
+    void stateChanged(const QString &state, int enabled, int detail, const QDBusVariant &data, const QVariantMap &properties, const QDBusMessage &message);
+
+private:
+    void initialize(const QDBusConnection &bus);
+
+    quint64 m_focusGeneration = 0;
+    std::unique_ptr<QDBusConnection> m_bus;
+    QString m_connectionName;
+    QString m_focusedService;
+    QString m_focusedPath;
+    QRect m_focusedEditableRect;
+};
diff --git a/src/gamepadhandler.cpp b/src/gamepadhandler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8343ab4b5eab0015075325d5eec723731eb32979
--- /dev/null
+++ b/src/gamepadhandler.cpp
@@ -0,0 +1,466 @@
+/*
+    SPDX-FileCopyrightText: 2026 Plasma Keyboard contributors
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "gamepadhandler.h"
+#include "logging.h"
+#include "plasmakeyboardsettings.h"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusVariant>
+#include <QTimer>
+#include <Qt>
+
+namespace
+{
+constexpr auto s_service = "org.shadowblip.InputPlumber";
+constexpr auto s_interface = "org.shadowblip.Input.DBusDevice";
+constexpr auto s_signal = "InputEvent";
+
+// Turbo mode for the held backspace button: after this pause the deletion
+// repeats every s_backspaceRepeatMs, like a held key on a hardware keyboard.
+constexpr int s_backspaceInitialDelayMs = 350;
+constexpr int s_backspaceRepeatMs = 50;
+
+// Intercept modes of InputPlumber (see "inputplumber device intercept set").
+// "none" leaves the gamepad to the system, i.e. to games and to Steam's
+// mapping; "gamepad-only" routes it to us over D-Bus.
+constexpr uint s_interceptNone = 0;
+constexpr uint s_interceptGamepadOnly = 3;
+
+QString propertyStringList(const QString &path, const QString &interface, const QString &property, const QString &signature)
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(QLatin1String(s_service), path, QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+    msg << interface << property;
+    const QDBusMessage reply = QDBusConnection::systemBus().call(msg);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return {};
+    }
+    const QVariant value = reply.arguments().first().value<QDBusVariant>().variant();
+    if (signature == QLatin1String("as")) {
+        return value.toStringList().value(0);
+    }
+    return {};
+}
+
+uint propertyUint(const QString &path, const QString &interface, const QString &property)
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(QLatin1String(s_service), path, QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+    msg << interface << property;
+    const QDBusMessage reply = QDBusConnection::systemBus().call(msg);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return 0;
+    }
+    return reply.arguments().first().value<QDBusVariant>().variant().toUInt();
+}
+
+// Find the active composite device and the object path of its "dbus" target.
+QString findDbusDevicePath(QString *compositePathOut)
+{
+    const QString managerPath = QStringLiteral("/org/shadowblip/InputPlumber/Manager");
+    QString compositePath =
+        propertyStringList(managerPath, QStringLiteral("org.shadowblip.InputManager"), QStringLiteral("GamepadOrder"), QStringLiteral("as"));
+    if (compositePath.isEmpty()) {
+        compositePath = QStringLiteral("/org/shadowblip/InputPlumber/CompositeDevice0");
+    }
+
+    if (compositePathOut) {
+        *compositePathOut = compositePath;
+    }
+
+    return propertyStringList(compositePath, QStringLiteral("org.shadowblip.Input.CompositeDevice"), QStringLiteral("DbusDevices"), QStringLiteral("as"));
+}
+} // namespace
+
+GamepadHandler::GamepadHandler(QObject *parent)
+    : QObject(parent)
+{
+    m_repeatTimer = new QTimer(this);
+    m_repeatTimer->setInterval(180);
+    connect(m_repeatTimer, &QTimer::timeout, this, [this] {
+        if (m_repeatKey != 0) {
+            Q_EMIT navigate(m_repeatKey);
+        }
+    });
+
+    // X (backspace) keeps deleting while it is held; the first character is
+    // removed right away, then repeats start after a short delay.
+    m_backspaceTimer = new QTimer(this);
+    m_backspaceTimer->setSingleShot(true);
+    connect(m_backspaceTimer, &QTimer::timeout, this, [this] {
+        if (!m_backspaceHeld) {
+            return;
+        }
+        Q_EMIT backspace();
+        m_backspaceTimer->start(s_backspaceRepeatMs);
+    });
+
+    // A tapped activates the highlighted key; held past the configured delay it
+    // offers that key's alternate characters instead, and the list is then
+    // walked with the directions.
+    m_acceptHoldTimer = new QTimer(this);
+    m_acceptHoldTimer->setSingleShot(true);
+    connect(m_acceptHoldTimer, &QTimer::timeout, this, [this] {
+        qCDebug(PlasmaKeyboard) << "GamepadHandler: A hold timer fired, held" << m_acceptHeld << "armed" << m_pressedAlternates;
+        if (m_acceptHeld && !m_pressedAlternates.isEmpty()) {
+            // This press has done its job, so its release must not type the key.
+            m_acceptConsumed = true;
+            m_alternatesOpened = true;
+            qCDebug(PlasmaKeyboard) << "GamepadHandler: offering alternates" << m_pressedAlternates;
+            Q_EMIT showAlternates(m_pressedAlternates);
+        }
+    });
+
+    const QString path = findDbusDevicePath(&m_compositePath);
+    qCDebug(PlasmaKeyboard) << "GamepadHandler: InputPlumber dbus target" << (path.isEmpty() ? QStringLiteral("<not found>") : path);
+    if (path.isEmpty()) {
+        return;
+    }
+
+    const bool connected = QDBusConnection::systemBus().connect(QLatin1String(s_service),
+                                                                path,
+                                                                QLatin1String(s_interface),
+                                                                QLatin1String(s_signal),
+                                                                this,
+                                                                SLOT(onInputEvent(QString, double)));
+    if (connected) {
+        m_available = true;
+        Q_EMIT availableChanged();
+    }
+
+    // Interception follows the actual state of the panel as reported by KWin,
+    // which is more reliable than the window visibility of this process.
+    QDBusConnection::sessionBus().connect(QStringLiteral("org.kde.KWin"),
+                                          QStringLiteral("/VirtualKeyboard"),
+                                          QStringLiteral("org.kde.kwin.VirtualKeyboard"),
+                                          QStringLiteral("visibleChanged"),
+                                          this,
+                                          SLOT(refreshFromKWin()));
+    QDBusConnection::sessionBus().connect(QStringLiteral("org.kde.KWin"),
+                                          QStringLiteral("/VirtualKeyboard"),
+                                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                                          QStringLiteral("PropertiesChanged"),
+                                          this,
+                                          SLOT(onKWinPropertiesChanged(QString, QVariantMap, QStringList)));
+    refreshFromKWin();
+
+    // Visibility follows KWin signals; no healthy-idle polling.
+}
+
+void GamepadHandler::onKWinPropertiesChanged(const QString &interfaceName, const QVariantMap &changed, const QStringList &invalidated)
+{
+    Q_UNUSED(invalidated);
+    if (interfaceName != QLatin1String("org.kde.kwin.VirtualKeyboard")) {
+        return;
+    }
+    if (changed.contains(QStringLiteral("visible"))) {
+        setKwinVisible(changed.value(QStringLiteral("visible")).toBool());
+    }
+}
+
+void GamepadHandler::refreshFromKWin()
+{
+    QDBusMessage msg = QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),
+                                                      QStringLiteral("/VirtualKeyboard"),
+                                                      QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                      QStringLiteral("Get"));
+    msg << QStringLiteral("org.kde.kwin.VirtualKeyboard") << QStringLiteral("visible");
+    const QDBusMessage reply = QDBusConnection::sessionBus().call(msg);
+    if (reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+        return;
+    }
+    const bool visible = reply.arguments().first().value<QDBusVariant>().variant().toBool();
+
+    // A previous instance may have died before it could give the gamepad back
+    // (a crash, or a kill while the keyboard was up), which leaves the gamepad
+    // intercepted forever: it would neither reach the game nor Steam again.
+    if (!visible && !m_keyboardOnScreen && !m_active && interceptMode() == s_interceptGamepadOnly) {
+        qCDebug(PlasmaKeyboard) << "GamepadHandler: giving back a gamepad left intercepted by an earlier instance";
+        setInterceptMode(s_interceptNone);
+    }
+
+    setKwinVisible(visible);
+}
+
+void GamepadHandler::setKwinVisible(bool visible)
+{
+    m_kwinVisible = visible;
+    recomputeActive();
+}
+
+bool GamepadHandler::keyboardOnScreen() const
+{
+    return m_keyboardOnScreen;
+}
+
+void GamepadHandler::setKeyboardOnScreen(bool onScreen)
+{
+    if (onScreen == m_keyboardOnScreen) {
+        return;
+    }
+    m_keyboardOnScreen = onScreen;
+    Q_EMIT keyboardOnScreenChanged();
+    // The keyboard window can stay on screen after the text input went away, so
+    // the compositor no longer reports it as visible: the gamepad keeps driving
+    // the keyboard for as long as the window is there.
+    recomputeActive();
+}
+
+void GamepadHandler::recomputeActive()
+{
+    setActive(m_kwinVisible || m_keyboardOnScreen);
+}
+
+GamepadHandler::~GamepadHandler()
+{
+    if (m_active) {
+        setInterceptMode(m_savedInterceptMode);
+    }
+}
+
+bool GamepadHandler::isAvailable() const
+{
+    return m_available;
+}
+
+bool GamepadHandler::isActive() const
+{
+    return m_active;
+}
+
+uint GamepadHandler::interceptMode() const
+{
+    if (m_compositePath.isEmpty()) {
+        return 0;
+    }
+    return propertyUint(m_compositePath, QStringLiteral("org.shadowblip.Input.CompositeDevice"), QStringLiteral("InterceptMode"));
+}
+
+void GamepadHandler::setInterceptMode(uint mode)
+{
+    if (m_compositePath.isEmpty()) {
+        return;
+    }
+    QDBusMessage msg =
+        QDBusMessage::createMethodCall(QLatin1String(s_service), m_compositePath, QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Set"));
+    msg << QStringLiteral("org.shadowblip.Input.CompositeDevice") << QStringLiteral("InterceptMode")
+        << QVariant::fromValue(QDBusVariant(QVariant::fromValue(mode)));
+    QDBusConnection::systemBus().call(msg);
+}
+
+void GamepadHandler::setActive(bool active)
+{
+    if (!m_available || m_compositePath.isEmpty()) {
+        return;
+    }
+    if (active == m_active) {
+        return;
+    }
+
+    if (active) {
+        m_savedInterceptMode = interceptMode();
+        // Never remember an intercepted mode as the one to go back to: after a
+        // crash that left the gamepad intercepted, that would keep it grabbed
+        // for good.
+        if (m_savedInterceptMode == s_interceptGamepadOnly) {
+            m_savedInterceptMode = s_interceptNone;
+        }
+        // gamepad-only: gamepad input is routed over D-Bus and no longer
+        // reaches the game (or Steam's mapping).
+        setInterceptMode(s_interceptGamepadOnly);
+    } else {
+        setInterceptMode(m_savedInterceptMode);
+        // No release events arrive once the gamepad is no longer intercepted.
+        m_backspaceHeld = false;
+        m_backspaceTimer->stop();
+        m_repeatKey = 0;
+        m_repeatTimer->stop();
+        m_pressedDirections.clear();
+    }
+    m_active = active;
+    qCDebug(PlasmaKeyboard) << "GamepadHandler::setActive" << active << "saved mode" << m_savedInterceptMode << "now" << interceptMode();
+}
+
+void GamepadHandler::onInputEvent(const QString &event, double value)
+{
+    // The gamepad only drives the keyboard while it is on screen: anything
+    // arriving while it is hidden belongs to the system (a game, Steam).
+    if (!m_active) {
+        return;
+    }
+
+    qCDebug(PlasmaKeyboard) << "GamepadHandler: InputEvent" << event << value;
+    const bool pressed = value >= 0.5;
+
+    // InputPlumber's dbus target emits abstract UI actions, not capability
+    // names (see src/input/event/dbus.rs in InputPlumber).
+    if (event == QLatin1String("ui_up")) {
+        handleDirection(Qt::Key_Up, pressed);
+        return;
+    }
+    if (event == QLatin1String("ui_down")) {
+        handleDirection(Qt::Key_Down, pressed);
+        return;
+    }
+    if (event == QLatin1String("ui_left")) {
+        handleDirection(Qt::Key_Left, pressed);
+        return;
+    }
+    if (event == QLatin1String("ui_right")) {
+        handleDirection(Qt::Key_Right, pressed);
+        return;
+    }
+
+    // X: backspace. While held it works like turbo mode and keeps deleting.
+    if (event == QLatin1String("ui_context")) {
+        handleBackspace(pressed);
+        return;
+    }
+
+    // A: activates the highlighted key, or offers its alternate characters
+    // when it is held.
+    if (event == QLatin1String("ui_accept")) {
+        handleAccept(pressed);
+        return;
+    }
+
+    // All remaining mappings trigger on press only.
+    if (!pressed) {
+        return;
+    }
+
+    if (event == QLatin1String("ui_back")) {
+        // B: go back. The panel decides what that means where it stands: it
+        // leaves the voice page, or closes the keyboard when there is none.
+        Q_EMIT back();
+    } else if (event == QLatin1String("ui_action")) {
+        // Y: space.
+        Q_EMIT space();
+    } else if (event == QLatin1String("ui_l2")) {
+        // LT: shift.
+        Q_EMIT toggleShift();
+    } else if (event == QLatin1String("ui_l1")) {
+        // LB: symbols layer.
+        Q_EMIT toggleSymbols();
+    } else if (event == QLatin1String("ui_r1")) {
+        // RB: switch layout.
+        Q_EMIT switchLanguage();
+    } else if (event == QLatin1String("ui_r2")) {
+        // RT: Enter.
+        Q_EMIT enter();
+    } else if (event == QLatin1String("ui_select") || event == QLatin1String("ui_quick")) {
+        // Select (and the QuickAccess button of handhelds): reach the rows above
+        // the keyboard (clipboard entries, clear key, F1-F12), which are not
+        // part of the key grid.
+        Q_EMIT toggleExtraRows();
+    } else if (event == QLatin1String("ui_option")) {
+        // Start: close the keyboard.
+        Q_EMIT hideKeyboard();
+    }
+}
+
+void GamepadHandler::handleBackspace(bool pressed)
+{
+    if (pressed) {
+        if (m_backspaceHeld) {
+            return;
+        }
+        m_backspaceHeld = true;
+        Q_EMIT backspace();
+        m_backspaceTimer->start(s_backspaceInitialDelayMs);
+    } else {
+        m_backspaceHeld = false;
+        m_backspaceTimer->stop();
+    }
+}
+
+void GamepadHandler::handleAccept(bool pressed)
+{
+    if (pressed) {
+        if (m_acceptHeld) {
+            return;
+        }
+        m_acceptHeld = true;
+        m_acceptConsumed = false;
+
+        // A press while the list is already up means "take the highlighted
+        // character": the release that opened it is long gone, and the list
+        // stays on screen until something is picked or dismissed.
+        if (m_alternatesOpened) {
+            m_acceptConsumed = true;
+            qCDebug(PlasmaKeyboard) << "GamepadHandler: A pressed while the alternates list is open, confirming";
+            Q_EMIT confirmAlternates();
+            return;
+        }
+
+        // Fix the list now: the panel keeps polling the highlight while the
+        // button is down, and the key under it may change (or blink out for one
+        // poll) before the delay is over.
+        m_pressedAlternates = m_alternatesArmable ? m_alternates : QStringList();
+        qCDebug(PlasmaKeyboard) << "GamepadHandler: A pressed, armable" << m_alternatesArmable << "alternates" << m_pressedAlternates;
+        if (!m_pressedAlternates.isEmpty()) {
+            m_acceptHoldTimer->start(PlasmaKeyboardSettings::self()->gamepadAlternatesThresholdMs());
+        }
+        return;
+    }
+
+    if (!m_acceptHeld) {
+        return;
+    }
+    m_acceptHeld = false;
+    m_acceptHoldTimer->stop();
+    m_pressedAlternates.clear();
+
+    // The press that is ending already opened the list or took a character, so
+    // it must not type the highlighted key as well. Whether the list is still
+    // up makes no difference here: the next press picks from it.
+    const bool consumed = m_acceptConsumed;
+    m_acceptConsumed = false;
+    if (consumed) {
+        return;
+    }
+
+    Q_EMIT activate();
+}
+
+void GamepadHandler::setAlternatesArmable(bool armable, const QStringList &alternates)
+{
+    m_alternatesArmable = armable && !alternates.isEmpty();
+    m_alternates = alternates;
+
+    // The highlight moved away from a key before the button was held long
+    // enough: there is nothing to offer any more.
+    //
+    // The button being down keeps a running delay alive: the panel polls the
+    // highlight, and a poll that finds no key must not cancel the delay that
+    // was started for the characters fixed at press time.
+    if (!m_alternatesArmable && !m_acceptHeld) {
+        m_acceptHoldTimer->stop();
+    }
+}
+
+void GamepadHandler::clearAlternatesOpen()
+{
+    m_alternatesOpened = false;
+}
+
+void GamepadHandler::handleDirection(int key, bool pressed)
+{
+    if (pressed) {
+        if (!m_pressedDirections.contains(key)) {
+            m_pressedDirections.insert(key);
+            Q_EMIT navigate(key);
+        }
+        m_repeatKey = key;
+        m_repeatTimer->start();
+    } else {
+        m_pressedDirections.remove(key);
+        if (m_repeatKey == key) {
+            m_repeatKey = 0;
+            m_repeatTimer->stop();
+        }
+    }
+}
diff --git a/src/gamepadhandler.h b/src/gamepadhandler.h
new file mode 100644
index 0000000000000000000000000000000000000000..0159733cd1dda39b27acf53011ee270cc8add310
--- /dev/null
+++ b/src/gamepadhandler.h
@@ -0,0 +1,177 @@
+/*
+    SPDX-FileCopyrightText: 2026 Plasma Keyboard contributors
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+
+#include <qqmlintegration.h>
+
+class QTimer;
+
+/**
+ * Translates gamepad input into on-screen keyboard actions.
+ *
+ * On systems using InputPlumber, the built-in controller is owned by the
+ * InputPlumber daemon, which exposes its events on the system bus through an
+ * "dbus" target device (interface org.shadowblip.Input.DBusDevice, signal
+ * InputEvent(string, double)). This class subscribes to that stream and emits
+ * high level signals that the keyboard UI maps onto Qt Virtual Keyboard's
+ * navigation and input.
+ *
+ * When InputPlumber is not available the handler stays idle.
+ */
+class GamepadHandler : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+    /*! Whether an InputPlumber dbus target device was found. */
+    Q_PROPERTY(bool available READ isAvailable NOTIFY availableChanged)
+
+    /**
+     * Whether the keyboard is on screen, i.e. whether the gamepad should drive
+     * it. The compositor stops reporting the keyboard as visible as soon as the
+     * text input goes away, but with hideOnInputFocusLoss off the keyboard stays
+     * on screen and has to stay controllable: the panel binds this to the
+     * keyboard window rather than to what the compositor reports.
+     */
+    Q_PROPERTY(bool keyboardOnScreen READ keyboardOnScreen WRITE setKeyboardOnScreen NOTIFY keyboardOnScreenChanged)
+
+public:
+    explicit GamepadHandler(QObject *parent = nullptr);
+    ~GamepadHandler() override;
+
+    bool isAvailable() const;
+
+    /**
+     * While active (keyboard shown), gamepad input is intercepted by
+     * InputPlumber and no longer reaches the game/Steam, so that the buttons
+     * only drive the on-screen keyboard. The previous intercept mode is
+     * restored when deactivated.
+     */
+    Q_INVOKABLE void setActive(bool active);
+    bool isActive() const;
+
+    bool keyboardOnScreen() const;
+    void setKeyboardOnScreen(bool onScreen);
+
+    /**
+     * Whether an alternates overlay may be opened right now, together with the
+     * characters it would offer.
+     *
+     * The panel calls this whenever the highlight moves: the decision has to be
+     * made while the button is on its way down, because holding A only starts
+     * the delay when the highlighted key has something to choose from.
+     */
+    Q_INVOKABLE void setAlternatesArmable(bool armable, const QStringList &alternates);
+
+    /**
+     * The alternates list is no longer on screen (a character was taken or the
+     * list was dismissed), so A goes back to typing the highlighted key.
+     */
+    Q_INVOKABLE void clearAlternatesOpen();
+
+Q_SIGNALS:
+    /*! Move the keyboard focus in the given direction (Qt::Key_Up/Down/Left/Right). */
+    void navigate(int key);
+    /*! Type the currently highlighted key. */
+    void activate();
+    /*! Offer the given alternate characters of the key the highlight is on. */
+    void showAlternates(const QStringList &alternates);
+    /*! Take the character highlighted in the alternates list. */
+    void confirmAlternates();
+    /*! Delete the character before the cursor. */
+    void backspace();
+    /*! Insert a space. */
+    void space();
+    /*! Press Enter/Return. */
+    void enter();
+    /*! Toggle the shift state. */
+    void toggleShift();
+    /*! Toggle the symbols (&123) layer. */
+    void toggleSymbols();
+    /*! Switch to the next keyboard layout. */
+    void switchLanguage();
+    /*! Go back: leave the voice page, or close the keyboard when it is not up
+        (B). */
+    void back();
+    /*! Hide the keyboard (Start). */
+    void hideKeyboard();
+    /*! Move the focus between the keyboard and the rows above it (Select). */
+    void toggleExtraRows();
+
+    void availableChanged();
+    void keyboardOnScreenChanged();
+
+private Q_SLOTS:
+    void onInputEvent(const QString &event, double value);
+    void onKWinPropertiesChanged(const QString &interfaceName, const QVariantMap &changed, const QStringList &invalidated);
+    void refreshFromKWin();
+
+private:
+    void handleDirection(int key, bool pressed);
+    void handleBackspace(bool pressed);
+    void handleAccept(bool pressed);
+    void setKwinVisible(bool visible);
+    void recomputeActive();
+    uint interceptMode() const;
+    void setInterceptMode(uint mode);
+
+    bool m_available = false;
+    QString m_compositePath;
+    bool m_active = false;
+    uint m_savedInterceptMode = 0;
+    /*! Whether the compositor reports the keyboard as visible. */
+    bool m_kwinVisible = false;
+    /*! Whether the keyboard window is on screen (see the keyboardOnScreen property). */
+    bool m_keyboardOnScreen = false;
+    QSet<int> m_pressedDirections;
+    QTimer *m_repeatTimer = nullptr;
+    QTimer *m_backspaceTimer = nullptr;
+    QTimer *m_acceptHoldTimer = nullptr;
+    QTimer *m_kwinPollTimer = nullptr;
+    int m_repeatKey = 0;
+    bool m_backspaceHeld = false;
+
+    /*! Whether the A button is being held right now. */
+    bool m_acceptHeld = false;
+
+    /**
+     * Whether the A press that is being held has already done its job (it
+     * opened the alternates list or took a character out of it), so its
+     * release must not type the highlighted key as well.
+     */
+    bool m_acceptConsumed = false;
+
+    /**
+     * Whether the alternates overlay was opened for the A press that is still
+     * being held, so the release must not activate the highlighted key.
+     */
+    bool m_alternatesOpened = false;
+
+    /**
+     * Whether an alternates overlay may be opened at all: the panel reports
+     * that a key with alternate characters is highlighted and that gamepad
+     * alternates are enabled.
+     */
+    bool m_alternatesArmable = false;
+
+    /*! Alternate characters of the highlighted key. */
+    QStringList m_alternates;
+
+    /**
+     * Alternates the overlay is offered for, fixed when A went down.
+     *
+     * The panel keeps polling the highlight while the button is held, so the
+     * key under it may change (or blink out for a single poll) before the hold
+     * delay is over; the characters have to survive that.
+     */
+    QStringList m_pressedAlternates;
+};
