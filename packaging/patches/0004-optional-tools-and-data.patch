+++ b/src/swipekb/src/nwp_predictor.cpp
@@ -0,0 +1,136 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+#include "swipekb/nwp_predictor.hpp"
+#include "swipekb/prediction.hpp"
+
+#include <QString>
+#include <algorithm>
+#include <cmath>
+#include <unordered_set>
+
+namespace swipekb {
+namespace {
+constexpr size_t kCandidates = 32;   // per side: the n-gram's best and the neural model's best
+}
+
+std::string NwpPredictor::siblingPath(const std::string &model)
+{
+    static const std::string tail = ".ngram";
+    if (model.size() < tail.size() || model.compare(model.size() - tail.size(), tail.size(), tail) != 0) return {};
+    return model.substr(0, model.size() - tail.size()) + ".nwp.bin";
+}
+
+bool NwpPredictor::load(const std::string &ngramModel, const std::string &vocab, const std::string &nwp, bool siblingFallback)
+{
+    useLm_ = false;
+    if (!ngram_.load(ngramModel, vocab)) return false;
+    const std::string path = !nwp.empty() ? nwp : (siblingFallback ? siblingPath(ngramModel) : std::string());
+    // WHY a failed neural load is not an error: the pack still works as before (n-gram only).
+    if (path.empty() || !lm_.load(path)) return true;
+    const auto &words = ngram_.vocabulary();
+    lmApostrophes_ = false;
+    for (uint32_t t = 3; t < lm_.vocabSize() && !lmApostrophes_; ++t) lmApostrophes_ = lm_.word(t).find('\'') != std::string::npos;
+    tokenToIndex_.assign(lm_.vocabSize(), -1);
+    indexToToken_.assign(words.size(), NwpModel::kUnk);
+    nextSameToken_.assign(words.size(), -1);
+    std::vector<int32_t> lastOfToken(lm_.vocabSize(), -1);
+    size_t shared = 0;
+    for (uint32_t i = 0; i < words.size(); ++i) {
+        const uint32_t t = lm_.token(lmApostrophes_ ? ngram_.model().form(words[i]) : ngram_.alphaOf(i));
+        if (t == NwpModel::kUnk) continue;
+        // WHY every word of the token, not only the first: with an apostrophe n-gram and a letters-only neural model,
+        // "were" and "we're" both take the neural score of "were", split between them by the n-gram (predict()).
+        indexToToken_[i] = t;
+        if (tokenToIndex_[t] < 0) { tokenToIndex_[t] = int32_t(i); ++shared; }
+        else nextSameToken_[size_t(lastOfToken[t])] = int32_t(i);
+        lastOfToken[t] = int32_t(i);
+    }
+    // WHY a floor on overlap: a model built for another language/word list would only add noise.
+    if (shared * 2 < size_t(lm_.vocabSize())) return true;
+    lambda_ = lm_.lambda(); oovBonus_ = lm_.oovBonus();
+    cachedSeq_.clear(); state_ = lm_.start(); logpValid_ = false;
+    useLm_ = true;
+    return true;
+}
+
+std::string NwpPredictor::lmForm(const std::string &word) const
+{
+    // WHY: a neural model with apostrophes reads "we're" as written; a letters-only one as "were".
+    return lmApostrophes_ ? NgramLM::apostropheForm(word) : NgramLM::alphaForm(word);
+}
+
+std::vector<std::string> NwpPredictor::predict(const std::vector<std::string> &context, int topK,
+                                               const std::string &prefix) const
+{
+    if (!useLm_) return ngram_.predict(context, topK, prefix);
+    if (!ready() || topK <= 0) return {};
+    topK = std::min(topK, 64);
+    // The sentence as the model reads it: <s>, then each word (0 = unknown to the model). WHY <s> only when the
+    // context is shorter than the 20-word cap: a capped context starts mid-sentence, as in training.
+    const auto bounded = boundedContext(context);
+    std::vector<uint32_t> seq;
+    if (bounded.size() < 20) seq.push_back(NwpModel::kBos);
+    for (const auto &word : bounded) {
+        const auto form = lmForm(word);
+        if (!form.empty()) seq.push_back(lm_.token(form));
+    }
+    // WHY reuse: while a word is typed, and as a sentence grows by one word, only the new tokens are read.
+    const bool extends = cachedSeq_.size() <= seq.size() && std::equal(cachedSeq_.begin(), cachedSeq_.end(), seq.begin());
+    if (!extends) { state_ = lm_.start(); cachedSeq_.clear(); logpValid_ = false; }
+    if (cachedSeq_.size() != seq.size() || !logpValid_) {
+        for (size_t i = cachedSeq_.size(); i < seq.size(); ++i) lm_.step(state_, seq[i]);
+        cachedSeq_ = seq;
+        lm_.logProbs(state_, logp_);
+        logpValid_ = true;
+    }
+
+    const auto ng = ngram_.rank(context, kCandidates, prefix);
+    const std::string typed = prefix.empty() ? std::string() : NgramLM::alphaForm(prefix);
+    if (!prefix.empty() && typed.empty()) return {};
+    // The neural model's own best words (matching the typed letters), so a word the n-gram ranks low can still win.
+    // WHY a small heap instead of sorting the 24k matching words: all but a handful are rejected by one compare.
+    std::vector<std::pair<float, uint32_t>> lmTop;
+    const auto worse = [](const auto &a, const auto &b) { return a.first > b.first; };   // min-heap on score
+    for (uint32_t t = 3; t < lm_.vocabSize(); ++t) {
+        if (lmTop.size() == kCandidates && logp_[t] <= lmTop.front().first) continue;
+        if (tokenToIndex_[t] < 0) continue;
+        if (!typed.empty() && ngram_.alphaOf(uint32_t(tokenToIndex_[t])).compare(0, typed.size(), typed) != 0) continue;
+        if (lmTop.size() == kCandidates) { std::pop_heap(lmTop.begin(), lmTop.end(), worse); lmTop.pop_back(); }
+        lmTop.emplace_back(logp_[t], t);
+        std::push_heap(lmTop.begin(), lmTop.end(), worse);
+    }
+    const size_t keep = lmTop.size();
+
+    constexpr float kLog10 = 2.30258509f;
+    std::unordered_set<uint32_t> seen;
+    std::vector<std::pair<float, uint32_t>> blended;
+    const auto add = [&](uint32_t index) {
+        if (!seen.insert(index).second) return;
+        const float n = ngram_.score(ng.state, index);
+        const uint32_t t = indexToToken_[index];
+        float neural = t >= 3 ? logp_[t] / kLog10 : 0.f;
+        if (t >= 3 && (tokenToIndex_[t] != int32_t(index) || nextSameToken_[index] >= 0)) {
+            // Several words share this neural word: each gets its share by the n-gram's odds in this context
+            // (log10 of its probability over the group's total), so the shares add up to the neural score.
+            float total = 0;
+            for (int32_t j = tokenToIndex_[t]; j >= 0; j = nextSameToken_[size_t(j)]) total += std::pow(10.f, ngram_.score(ng.state, uint32_t(j)));
+            if (total > 0) neural += n - std::log10(total);
+        }
+        // Words the neural model knows: blend both opinions. Others: the n-gram alone (plus a tuned offset).
+        blended.emplace_back(t >= 3 ? lambda_ * neural + (1.f - lambda_) * n : n + oovBonus_, index);
+    };
+    for (const auto &[score, index] : ng.top) add(index);
+    for (size_t k = 0; k < keep; ++k)
+        for (int32_t j = tokenToIndex_[lmTop[k].second]; j >= 0; j = nextSameToken_[size_t(j)]) add(uint32_t(j));
+    const auto &words = ngram_.vocabulary();
+    std::sort(blended.begin(), blended.end(), [&](const auto &a, const auto &b) {
+        return a.first == b.first ? words[a.second] < words[b.second] : a.first > b.first;
+    });
+    std::vector<std::pair<std::string, float>> shown;
+    for (const auto &[score, index] : blended) shown.emplace_back(words[index], score);
+    return filterPredictedWords(shown, topK);
+}
+
+}
diff --git a/src/swipekb/src/prediction.cpp b/src/swipekb/src/prediction.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7e59b168051034aea7468c573158628d09430bef
--- /dev/null
+++ b/src/swipekb/src/prediction.cpp
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+#include "swipekb/prediction.hpp"
+#include "swipekb/nwp_predictor.hpp"
+#include <algorithm>
+#include <fstream>
+
+namespace swipekb {
+// WHY only the project's own n-gram pack ("SWKBNG2", plus LANG.nwp.bin when it sits beside it): it predicts the next
+// word and completes half-typed words for every language. Any other file is refused, so a stale or foreign model
+// can never be loaded; the keyboard then simply shows no next-word suggestions.
+struct Predictor::Impl {
+    NwpPredictor ngram;
+};
+Predictor::Predictor() = default;
+Predictor::~Predictor() = default;
+bool Predictor::ready() const { return m_impl && m_impl->ngram.ready(); }
+bool Predictor::init(const std::string &model, const std::string &vocab, const std::string &nwp, bool siblingFallback)
+{
+    m_impl.reset();
+    if (model.empty() || vocab.empty() || !std::ifstream(model).good() || !std::ifstream(vocab).good()) return false;
+    try {
+        std::ifstream probe(model, std::ios::binary);
+        char magic[8]{}; probe.read(magic, sizeof magic);
+        if (probe.gcount() != sizeof magic || std::string(magic, sizeof magic) != std::string("SWKBNG2\0", 8)) return false;
+        auto impl = std::make_unique<Impl>();
+        if (!impl->ngram.load(model, vocab, nwp, siblingFallback)) return false;
+        m_impl = std::move(impl); return true;
+    } catch (...) { return false; }
+}
+std::vector<std::string> Predictor::predict(const std::vector<std::string> &context, int topK, const std::string &prefix)
+{
+    if (!ready() || topK <= 0) return {};
+    try {
+        return m_impl->ngram.predict(context, std::min(topK, 64), prefix);
+    } catch (...) { return {}; }
+}
+}
diff --git a/src/swipekb/src/spelling.cpp b/src/swipekb/src/spelling.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b18fcb0249f2b91ca9b6d20fbbee80221291d95a
--- /dev/null
+++ b/src/swipekb/src/spelling.cpp
@@ -0,0 +1,188 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Spellings — the dictionary's other spellings of one swipe shape (see spellings.hpp).
+
+#include "swipekb/spellings.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <QString>
+#include <QRegularExpression>
+
+namespace swipekb {
+
+namespace {
+
+// WHY 80 points (AOSP's 0-255 scale, ~27.5 points per step of ten in how often a word is used): close enough to
+// offer "we're" when "were" is typed (186 vs 106) or "we'll" for "well" (168 vs 94), far enough to never offer
+// junk like "wa's" for "was" (201 vs 50) or "doe's" for "does" (151 vs 27).
+constexpr int kOfferWithin = 80;
+
+// Letters with single ' or - between them ("don't", "o'clock", "full-time"). WHY so strict: the guess is typed
+// as-is, so "us$", "states'" or "'tis" style entries must never replace a clean word.
+bool wellFormed(const std::string &w)
+{
+    // WHY Unicode letters and interior punctuation only: retain display forms without accepting control/markup entries.
+    static const QRegularExpression valid(QString::fromUtf8(R"(^\p{L}+(?:['’\-]\p{L}+)*$)"));
+    return valid.match(QString::fromStdString(w).normalized(QString::NormalizationForm_C)).hasMatch();
+}
+
+std::string lower(const std::string &w)
+{
+    return QString::fromStdString(w).normalized(QString::NormalizationForm_C).toLower().toStdString();
+}
+
+std::string lettersOf(const std::string &w)
+{
+    std::string out;
+    for (char32_t c : QString::fromStdString(lower(w)).toUcs4())
+        if (QChar::isLetter(c)) out += QString::fromUcs4(&c,1).toStdString();
+    return out;
+}
+
+} // namespace
+
+std::vector<std::string> Spellings::recognitionAliases(const std::string &word, const std::string &language)
+{
+    // WHY: the physical œ/æ/ß popup shares a base key, while many users draw the
+    // conventional oe/ae/ss digraph. Neither should erase the dictionary's display form.
+    const QString source=QString::fromStdString(lettersOf(word));
+    QString base=source, digraph=source;
+    if (language=="fr") {
+        base.replace(QStringLiteral("œ"),QStringLiteral("o")).replace(QStringLiteral("æ"),QStringLiteral("a"));
+        digraph.replace(QStringLiteral("œ"),QStringLiteral("oe")).replace(QStringLiteral("æ"),QStringLiteral("ae"));
+    } else if (language=="de") {
+        base.replace(QStringLiteral("ß"),QStringLiteral("s"));
+        digraph.replace(QStringLiteral("ß"),QStringLiteral("ss"));
+    }
+    std::vector<std::string> out;
+    if (base!=source) out.push_back(base.toStdString());
+    if (digraph!=source && digraph!=base) out.push_back(digraph.toStdString());
+    return out;
+}
+
+Spellings Spellings::fromCombinedText(const std::string &text, const std::string &language)
+{
+    // letters -> (lower-case spelling -> best frequency)
+    std::unordered_map<std::string, std::vector<std::pair<std::string, int>>> groups;
+    Spellings out;
+    std::istringstream in(text);
+    std::string line;
+    while (std::getline(in, line)) {
+        const size_t p = line.find(" word=");
+        if (p != 0)
+            continue;   // header, shortcut lines
+        const size_t e = line.find(',', p + 6);
+        if (e == std::string::npos)
+            continue;
+        const std::string word = line.substr(p + 6, e - p - 6);
+        const size_t fp = line.find(",f=", e);
+        if (fp == std::string::npos)
+            continue;
+        const int freq = std::atoi(line.c_str() + fp + 3);
+        // WHY skip these: AOSP lists "im", "alot", "whats" only so its autocorrect can replace them; they are
+        // not spellings anyone means.
+        if (freq <= 0 || line.find("not_a_word=true") != std::string::npos
+            || line.find("nonword") != std::string::npos || !wellFormed(word))
+            continue;
+        const std::string spelled = language=="de" ? QString::fromStdString(word).normalized(QString::NormalizationForm_C).toStdString() : lower(word);
+        const auto add=[&](const std::string &key) {
+            auto &g=groups[key];
+            auto it=std::find_if(g.begin(),g.end(),[&](const auto &x) { return x.first==spelled; });
+            if (it==g.end()) g.push_back({spelled,freq});
+            else it->second=std::max(it->second,freq);
+        };
+        add(lettersOf(word));
+        const auto aliases=recognitionAliases(word,language);
+        for (const auto &key:aliases) add(key);
+        if (!aliases.empty()) out.otherKeys_[lower(word)]=aliases.front();
+    }
+    for (auto &[letters, g] : groups) {
+        // Most frequent first; on a tie the plain letters-only spelling first (the form a swipe spells).
+        std::stable_sort(g.begin(), g.end(), [&](const auto &a, const auto &b) {
+            if (a.second != b.second)
+                return a.second > b.second;
+            return a.first == letters && b.first != letters;
+        });
+        // WHY skip: most words have one spelling, the letters themselves; storing them would only cost memory.
+        if (g.size() == 1 && g.front().first == letters)
+            continue;
+        std::vector<std::string> list;
+        for (const auto &[w, f] : g)
+            if (f >= g.front().second - kOfferWithin)
+                list.push_back(w);
+        out.byLetters_.emplace(letters, std::move(list));
+    }
+    return out;
+}
+
+Spellings Spellings::fromCombinedFile(const std::string &path, const std::string &language)
+{
+    std::ifstream f(path, std::ios::binary);
+    if (!f)
+        return {};
+    std::ostringstream ss;
+    ss << f.rdbuf();
+    return fromCombinedText(ss.str(), language);
+}
+
+std::string Spellings::spell(const std::string &letters) const
+{
+    const auto it = byLetters_.find(letters);
+    return it == byLetters_.end() ? letters : it->second.front();
+}
+
+std::vector<std::string> Spellings::others(const std::string &word) const
+{
+    const std::string me = lower(word);
+    const auto alias=otherKeys_.find(me);
+    const auto it = byLetters_.find(alias==otherKeys_.end() ? lettersOf(word) : alias->second);
+    if (it == byLetters_.end())
+        return {};
+    std::vector<std::string> out;
+    for (const std::string &w : it->second)
+        if (lower(w) != me)
+            out.push_back(w);
+    return out;
+}
+
+namespace {
+std::string capitalsKey(const std::string &w)
+{
+    return QString::fromStdString(w).normalized(QString::NormalizationForm_C).toLower().replace(QChar(0x2019), QLatin1Char('\'')).toStdString();
+}
+}
+
+std::shared_ptr<const Capitals> Capitals::fromTsv(const std::string &text)
+{
+    auto out = std::make_shared<Capitals>();
+    std::istringstream in(text);
+    for (std::string line; std::getline(in, line);) {
+        if (line.empty() || line[0] == '#') continue;
+        const size_t tab = line.find('\t');
+        if (tab == std::string::npos || tab == 0) continue;
+        const size_t end = line.find('\t', tab + 1);
+        const std::string word = line.substr(0, tab), form = line.substr(tab + 1, end == std::string::npos ? end : end - tab - 1);
+        // WHY: a form must be the same word ("paris" -> "Paris"), never a different one.
+        if (form.empty() || capitalsKey(form) != capitalsKey(word)) continue;
+        out->forms_[capitalsKey(word)] = QString::fromStdString(form).normalized(QString::NormalizationForm_C).toStdString();
+    }
+    // WHY nullptr for an empty list (German, an unknown language): callers then keep words exactly as they are.
+    return out->forms_.empty() ? nullptr : out;
+}
+
+std::string Capitals::apply(const std::string &word) const
+{
+    const QString w = QString::fromStdString(word).normalized(QString::NormalizationForm_C);
+    const auto it = forms_.find(capitalsKey(word));
+    if (it == forms_.end()) return w.toLower().toStdString();
+    QString form = QString::fromStdString(it->second);
+    if (w.contains(QChar(0x2019))) form.replace(QLatin1Char('\''), QChar(0x2019));   // French lists use ’
+    return form.toStdString();
+}
+
+} // namespace swipekb
diff --git a/src/swipekb/src/swipe_beam.cpp b/src/swipekb/src/swipe_beam.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7657428545fc20c2848283f758cc9b0506a89802
--- /dev/null
+++ b/src/swipekb/src/swipe_beam.cpp
@@ -0,0 +1,193 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+#include "swipekb/swipe_beam.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <limits>
+#include <numeric>
+
+namespace swipekb {
+
+namespace {
+constexpr float kNegInf = -1e30f;
+inline float lae(float a, float b) {   // log(exp(a)+exp(b))
+    if (a < b) std::swap(a, b);
+    return b <= kNegInf ? a : a + std::log1p(std::exp(b - a));
+}
+}
+
+void SwipeLexicon::add(std::string_view word, int freq, const SwipeLayout &layout) {
+    int raw = 0;
+    const auto k = layout.wordKeys(word, &raw);
+    if (k.empty() || k.size() > 40 || layout.size() > 255) return;
+    Pending p;
+    p.keys.assign(k.begin(), k.end());
+    // WHY the lower-cased spelling (accents kept) is the identity: "que" and "qu\u00e9", "ou" and "o\u00f9", "see" and "se" are
+    // different words that share a key path, and the sentence prior must be able to choose between them.
+    p.lower = lowerUtf8(word);
+    p.text = std::string(word); p.freq = std::clamp(freq, 0, 255);
+    pending_.push_back(std::move(p));
+}
+
+size_t SwipeLexicon::loadTsv(const std::string &path, const SwipeLayout &layout) {
+    std::ifstream in(path);
+    if (!in) return 0;
+    std::string line;
+    size_t n = 0;
+    while (std::getline(in, line)) {
+        const auto tab = line.find('\t');
+        if (tab == std::string::npos || tab == 0) continue;
+        add(std::string_view(line).substr(0, tab), std::atoi(line.c_str() + tab + 1), layout);
+        ++n;
+    }
+    return n;
+}
+
+void SwipeLexicon::finish() {
+    // Dedupe by lower-cased spelling, keeping the most frequent capitalisation ("The"/"the").
+    std::sort(pending_.begin(), pending_.end(), [](const Pending &a, const Pending &b) {
+        if (a.keys != b.keys) return a.keys < b.keys;
+        if (a.lower != b.lower) return a.lower < b.lower;
+        if (a.freq != b.freq) return a.freq > b.freq;
+        return a.text < b.text;
+    });
+    words_.clear(); nodes_.clear();
+    nodes_.emplace_back();   // root
+    const Pending *last = nullptr;
+    // Stack of (node, depth) along the current key string to attach new branches without searching.
+    std::vector<int32_t> path{0};
+    std::vector<int32_t> lastChild{-1};   // last child added under path[i]
+    for (const auto &p : pending_) {
+        if (last && last->keys == p.keys && last->lower == p.lower) continue;   // same word, lower frequency
+        last = &p;
+        // Longest shared prefix with the previous word's path.
+        size_t shared = 0;
+        const auto &prevKeys = words_.empty() ? std::vector<uint8_t>{} : words_.back().keys;
+        while (shared < prevKeys.size() && shared < p.keys.size() && prevKeys[shared] == p.keys[shared]) ++shared;
+        path.resize(shared + 1); lastChild.resize(shared + 1);
+        for (size_t d = shared; d < p.keys.size(); ++d) {
+            const int32_t id = int32_t(nodes_.size());
+            Node n; n.key = p.keys[d];
+            nodes_.push_back(n);
+            const int32_t parent = path.back();
+            if (lastChild.back() < 0) nodes_[parent].firstChild = id; else nodes_[lastChild.back()].nextSibling = id;
+            lastChild.back() = id;
+            path.push_back(id); lastChild.push_back(-1);
+        }
+        words_.push_back({p.text, p.keys, p.freq});
+        Node &term = nodes_[path.back()];
+        if (term.wordEnd == term.wordBegin) term.wordBegin = uint32_t(words_.size() - 1);
+        term.wordEnd = uint32_t(words_.size());
+        // bestFreq for all nodes on this path (words are visited in key order, any order within a node is fine here).
+        for (int32_t id : path) nodes_[id].bestFreq = uint8_t(std::max<int>(nodes_[id].bestFreq, p.freq));
+    }
+    // Words at a node are sorted by raw key string then frequency; the search wants the best prior first, which it
+    // computes itself, so no re-sort is needed. Pending data is no longer needed.
+    pending_.clear(); pending_.shrink_to_fit();
+}
+
+int32_t SwipeLexicon::find(const std::vector<int> &keys) const {
+    int32_t cur = 0;
+    for (int k : keys) {
+        int32_t c = nodes_[cur].firstChild;
+        while (c >= 0 && nodes_[c].key != k) c = nodes_[c].nextSibling;
+        if (c < 0) return -1;
+        cur = c;
+    }
+    return cur;
+}
+
+std::vector<SwipeCandidate> SwipeBeamSearch::decode(const float *lp, int steps, int K, const BeamParams &p, int topN,
+                                                   const std::function<float(uint32_t)> &prior,
+                                                   const std::vector<uint32_t> &hints) {
+    std::vector<SwipeCandidate> result;
+    if (steps <= 0 || K <= 0 || lex_.nodeCount() <= 1) return result;
+    if (stamp_.size() != lex_.nodeCount()) {   // scratch sized to the lexicon (stamps avoid clearing 1.6M entries)
+        stamp_.assign(lex_.nodeCount(), 0); slot_.assign(lex_.nodeCount(), 0);
+        bonusStamp_.assign(lex_.nodeCount(), 0); bonus_.assign(lex_.nodeCount(), 0.f);
+        generation_ = 0;
+    }
+    // Context hints: walk each favoured word's path and mark its nodes with a pruning bonus.
+    const uint32_t hintGen = ++generation_;
+    for (uint32_t w : hints) {
+        if (w >= lex_.wordCount()) continue;
+        int32_t cur = 0;
+        for (uint8_t k : lex_.keys(w)) {
+            int32_t c = lex_.node(cur).firstChild;
+            while (c >= 0 && lex_.node(c).key != k) c = lex_.node(c).nextSibling;
+            if (c < 0) break;
+            cur = c;
+            bonusStamp_[cur] = hintGen; bonus_[cur] = p.hintBonus;
+        }
+    }
+    auto look = [&](int32_t n) {
+        float v = p.lookahead * lex_.node(n).bestFreq;
+        if (bonusStamp_[n] == hintGen) v += bonus_[n];
+        return v;
+    };
+    struct Beam { int32_t node; float pb, pnb; };
+    std::vector<Beam> beams{{0, 0.f, kNegInf}}, next;
+    std::vector<int> order(K);
+    std::vector<uint8_t> allowed(K);
+    for (int t = 0; t < steps; ++t) {
+        const float *row = lp + size_t(t) * (K + 1);
+        std::iota(order.begin(), order.end(), 0);
+        const int keep = std::min(p.keysPerStep, K);
+        std::partial_sort(order.begin(), order.begin() + keep, order.end(), [&](int a, int b) { return row[1 + a] > row[1 + b]; });
+        std::fill(allowed.begin(), allowed.end(), 0);
+        for (int i = 0; i < keep; ++i) allowed[order[i]] = 1;
+        const uint32_t gen = ++generation_;
+        next.clear();
+        auto touch = [&](int32_t node) -> Beam & {
+            if (stamp_[node] != gen) { stamp_[node] = gen; slot_[node] = int32_t(next.size()); next.push_back({node, kNegInf, kNegInf}); }
+            return next[slot_[node]];
+        };
+        for (const Beam &b : beams) {
+            const float tot = lae(b.pb, b.pnb);
+            Beam &same = touch(b.node);
+            same.pb = lae(same.pb, tot + row[0]);                       // blank: stay on this prefix
+            if (b.node != 0) {
+                const float stay = b.pnb + row[1 + lex_.node(b.node).key];   // same key held over several steps
+                touch(b.node).pnb = lae(touch(b.node).pnb, stay);
+            }
+            for (int32_t c = lex_.node(b.node).firstChild; c >= 0; c = lex_.node(c).nextSibling) {
+                const int k = lex_.node(c).key;
+                if (!allowed[k]) continue;
+                Beam &nb = touch(c);
+                nb.pnb = lae(nb.pnb, tot + row[1 + k]);
+            }
+        }
+        const size_t B = size_t(std::max(1, p.beam));
+        if (next.size() > B) {
+            std::vector<std::pair<float, uint32_t>> sc(next.size());
+            for (size_t i = 0; i < next.size(); ++i) sc[i] = {lae(next[i].pb, next[i].pnb) + look(next[i].node), uint32_t(i)};
+            std::nth_element(sc.begin(), sc.begin() + B, sc.end(), [](auto &a, auto &b) { return a.first > b.first; });
+            beams.clear();
+            for (size_t i = 0; i < B; ++i) beams.push_back(next[sc[i].second]);
+        } else {
+            beams = next;
+        }
+    }
+    // Finished words: key-sequence probability plus the word prior.
+    for (const Beam &b : beams) {
+        const auto &n = lex_.node(b.node);
+        if (n.wordBegin == n.wordEnd) continue;
+        const float ctc = lae(b.pb, b.pnb);
+        for (uint32_t w = n.wordBegin; w < n.wordEnd; ++w) {
+            const float pr = prior ? prior(w) : p.freqWeight * lex_.freq(w);
+            result.push_back({w, ctc + pr, ctc});
+        }
+    }
+    const size_t n = std::min<size_t>(result.size(), size_t(std::max(1, topN)));
+    std::partial_sort(result.begin(), result.begin() + n, result.end(), [](const SwipeCandidate &a, const SwipeCandidate &b) {
+        return a.score != b.score ? a.score > b.score : a.word < b.word; });
+    result.resize(n);
+    return result;
+}
+
+}
diff --git a/src/swipekb/src/swipe_engine.cpp b/src/swipekb/src/swipe_engine.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..19fab890b0a46742143e46b2399ad3d46fdf39d9
--- /dev/null
+++ b/src/swipekb/src/swipe_engine.cpp
@@ -0,0 +1,82 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+#include "swipekb/swipe_engine.hpp"
+
+#include <algorithm>
+
+namespace swipekb {
+
+SwipeEngine::SwipeEngine(const SwipeEngine &o) : params(o.params), d_(o.d_), prior_(o.prior_), hints_(o.hints_) {
+    if (d_) search_ = std::make_unique<SwipeBeamSearch>(d_->lex);
+}
+
+void SwipeEngine::rebuild() {
+    if (!d_) return;
+    d_->geo = std::make_unique<GeoDecoder>(d_->lex, d_->layout);
+    search_ = std::make_unique<SwipeBeamSearch>(d_->lex);
+}
+
+void SwipeEngine::setLayout(SwipeLayout layout) {
+    if (!d_) d_ = std::make_shared<Data>();
+    d_->layout = std::move(layout);
+}
+
+bool SwipeEngine::loadLayout(const std::string &tsv) {
+    SwipeLayout l;
+    if (!l.loadTsv(tsv)) return false;
+    setLayout(std::move(l));
+    return true;
+}
+
+size_t SwipeEngine::loadWords(const std::string &tsv) {
+    if (!d_) d_ = std::make_shared<Data>();
+    d_->lex = SwipeLexicon();
+    const size_t n = d_->lex.loadTsv(tsv, d_->layout);
+    d_->lex.finish();
+    rebuild();
+    return n;
+}
+
+size_t SwipeEngine::setWords(const std::vector<std::pair<std::string, int>> &words) {
+    if (!d_) d_ = std::make_shared<Data>();
+    d_->lex = SwipeLexicon();
+    for (const auto &[w, f] : words) d_->lex.add(w, f, d_->layout);
+    d_->lex.finish();
+    rebuild();
+    return words.size();
+}
+
+bool SwipeEngine::loadModel(const std::string &path) {
+    if (!d_) d_ = std::make_shared<Data>();
+    return d_->net.load(path);
+}
+
+void SwipeEngine::setPrior(std::function<float(uint32_t)> prior, std::vector<uint32_t> hints) {
+    prior_ = std::move(prior); hints_ = std::move(hints);
+}
+
+std::vector<SwipeCandidate> SwipeEngine::decode(const std::vector<SwipePoint> &trace, float aspect, int topN) {
+    if (!ready() || trace.empty() || topN <= 0) return {};
+    if (d_->net.ready() && d_->net.buildInput(trace, d_->layout, aspect, in_) && d_->net.forward(in_, lp_)) {
+        BeamParams bp = params.beam;
+        bp.freqWeight = params.freqWeight;
+        const bool blend = params.geoWeight > 0;
+        auto res = search_->decode(lp_.data(), in_.steps, in_.keyCount, bp, blend ? std::max(topN, params.rerank) : topN, prior_, hints_);
+        if (!res.empty()) {
+            if (blend) {
+                // WHY: swipers unlike the training data confuse the network more than they confuse plain geometry;
+                // subtracting the geometric cost keeps its best words from losing to near-misses.
+                const auto prepared = d_->geo->prepare(trace, aspect, params.geo);
+                for (auto &c : res) c.score -= params.geoWeight * d_->geo->cost(prepared, c.word, aspect, params.geo);
+                std::stable_sort(res.begin(), res.end(), [](const SwipeCandidate &a, const SwipeCandidate &b) { return a.score > b.score; });
+                if (res.size() > size_t(topN)) res.resize(size_t(topN));
+            }
+            return res;
+        }
+    }
+    return d_->geo->decode(trace, aspect, topN, params.geo);
+}
+
+}
diff --git a/src/swipekb/src/swipe_geo.cpp b/src/swipekb/src/swipe_geo.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..06a98047a2a36919c79aba4568aa537583f8d6ec
--- /dev/null
+++ b/src/swipekb/src/swipe_geo.cpp
@@ -0,0 +1,195 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+#include "swipekb/swipe_geo.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <numeric>
+
+namespace swipekb {
+
+namespace {
+
+struct Pt { float x, y; };
+
+// Equal arc-length resample of a polyline into n points; `length` receives its total length.
+void resample(const std::vector<Pt> &in, int n, std::vector<Pt> &out, float &length) {
+    out.resize(n);
+    std::vector<float> cum(in.size(), 0.f);
+    for (size_t i = 1; i < in.size(); ++i) cum[i] = cum[i - 1] + std::hypot(in[i].x - in[i - 1].x, in[i].y - in[i - 1].y);
+    length = cum.back();
+    if (length < 1e-6f) { std::fill(out.begin(), out.end(), in[0]); return; }
+    size_t seg = 1;
+    for (int j = 0; j < n; ++j) {
+        const float s = length * float(j) / float(n - 1);
+        while (seg + 1 < in.size() && cum[seg] < s) ++seg;
+        const float d = cum[seg] - cum[seg - 1];
+        const float f = d > 0 ? std::clamp((s - cum[seg - 1]) / d, 0.f, 1.f) : 1.f;
+        out[j] = {in[seg - 1].x + f * (in[seg].x - in[seg - 1].x), in[seg - 1].y + f * (in[seg].y - in[seg - 1].y)};
+    }
+}
+
+// Banded DTW between two n-point paths. Point cost = max(0, distance - radius). Returns the summed cost along the
+// best warp path, or +inf as soon as every cell of a row exceeds `abandonAbove` (the cost can only grow).
+float dtw(const Pt *u, const Pt *t, int n, int band, float radius, float abandonAbove) {
+    constexpr float kInf = 1e30f;
+    float prevRow[128], curRow[128];
+    if (n > 128) return kInf;
+    int plo = 0, phi = -1;
+    for (int i = 0; i < n; ++i) {
+        const float ctr = float(i);   // both paths have n points, so the band follows the diagonal
+        const int lo = std::max(0, int(std::floor(ctr - band))), hi = std::min(n - 1, int(std::ceil(ctr + band)));
+        float rowMin = kInf;
+        for (int j = lo; j <= hi; ++j) {
+            const float d = std::max(0.f, std::hypot(u[i].x - t[j].x, u[i].y - t[j].y) - radius);
+            float best;
+            if (i == 0 && j == 0) best = 0.f;
+            else {
+                best = kInf;
+                if (i > 0 && j >= plo && j <= phi) best = std::min(best, prevRow[j]);
+                if (j > lo) best = std::min(best, curRow[j - 1]);
+                if (i > 0 && j > 0 && j - 1 >= plo && j - 1 <= phi) best = std::min(best, prevRow[j - 1]);
+            }
+            curRow[j] = best + d;
+            rowMin = std::min(rowMin, curRow[j]);
+        }
+        if (rowMin > abandonAbove) return kInf;
+        std::memcpy(prevRow + lo, curRow + lo, sizeof(float) * size_t(hi - lo + 1));
+        plo = lo; phi = hi;
+    }
+    return prevRow[n - 1];
+}
+
+}
+
+GeoDecoder::GeoDecoder(const SwipeLexicon &lex, const SwipeLayout &layout) : lex_(lex), layout_(layout) {
+    const size_t K = layout.size();
+    bucket_.assign(K * K, {});
+    for (uint32_t w = 0; w < lex.wordCount(); ++w) {
+        const auto &k = lex.keys(w);
+        if (!k.empty() && k.front() < K && k.back() < K) bucket_[size_t(k.front()) * K + k.back()].push_back(w);
+    }
+}
+
+std::vector<SwipeCandidate> GeoDecoder::decode(const std::vector<SwipePoint> &trace, float aspect, int topN, const GeoParams &p) const {
+    std::vector<SwipeCandidate> result;
+    const size_t K = layout_.size();
+    if (trace.empty() || K == 0 || topN <= 0 || p.steps < 2 || p.steps > 128) return result;
+    const float u = layout_.unit();
+    std::vector<Pt> keyC(K);
+    for (size_t k = 0; k < K; ++k) keyC[k] = {layout_.keys()[k].cx * u, layout_.keys()[k].cy * u * aspect};
+    // Finger path in key-width units without repeated points.
+    std::vector<Pt> pts;
+    for (const auto &q : trace) {
+        const Pt c{q.x * u, q.y * u * aspect};
+        if (pts.empty() || std::hypot(c.x - pts.back().x, c.y - pts.back().y) > 1e-4f) pts.push_back(c);
+    }
+    std::vector<Pt> U;
+    float L = 0;
+    resample(pts, p.steps, U, L);
+    // Nearest keys to the first and last touch.
+    auto nearest = [&](const Pt &q) {
+        std::vector<int> idx(K);
+        std::iota(idx.begin(), idx.end(), 0);
+        const size_t m = std::min<size_t>(size_t(p.endKeys), K);
+        std::partial_sort(idx.begin(), idx.begin() + m, idx.end(), [&](int a, int b) {
+            return std::hypot(keyC[a].x - q.x, keyC[a].y - q.y) < std::hypot(keyC[b].x - q.x, keyC[b].y - q.y); });
+        idx.resize(m);
+        return idx;
+    };
+    const auto firstKeys = nearest(pts.front()), lastKeys = nearest(pts.back());
+    // Per key: how close did the path come (letter coverage).
+    std::vector<float> miss(K);
+    for (size_t k = 0; k < K; ++k) {
+        float best = 1e30f;
+        for (const auto &q : U) best = std::min(best, std::hypot(q.x - keyC[k].x, q.y - keyC[k].y));
+        miss[k] = std::max(0.f, best - p.coverRadius);
+    }
+    struct Cand { float cheap; uint32_t word; };
+    std::vector<Cand> cands;
+    for (int a : firstKeys) for (int b : lastKeys) for (uint32_t w : bucket_[size_t(a) * K + b]) {
+        const auto &k = lex_.keys(w);
+        float len = 0, cov = 0;
+        for (size_t i = 0; i < k.size(); ++i) {
+            cov += miss[k[i]];
+            if (i) len += std::hypot(keyC[k[i]].x - keyC[k[i - 1]].x, keyC[k[i]].y - keyC[k[i - 1]].y);
+        }
+        if (L > 1.f && !(len > p.lenLo * L - 1.f && len < p.lenHi * L + 1.5f)) continue;
+        cands.push_back({p.coverWeight * cov - p.freqWeight * float(lex_.freq(w)), w});
+    }
+    if (cands.empty()) return result;
+    // Cheapest terms first: the DTW can only add cost, so once the cheap part alone is worse than the current
+    // topN-th best total, nothing later can enter (exact), and abandoned DTWs are skipped early.
+    std::sort(cands.begin(), cands.end(), [](const Cand &x, const Cand &y) { return x.cheap < y.cheap; });
+    const float norm = float(2 * p.steps);
+    std::vector<std::pair<float, uint32_t>> best;   // (total cost, word), sorted ascending, size <= topN
+    std::vector<Pt> poly, T;
+    for (const auto &c : cands) {
+        float worst = best.size() >= size_t(topN) ? best.back().first : 1e30f;
+        if (c.cheap >= worst) break;
+        const auto &k = lex_.keys(c.word);
+        poly.clear();
+        for (uint8_t kk : k) poly.push_back(keyC[kk]);
+        float tl;
+        resample(poly, p.steps, T, tl);
+        const float limit = worst >= 1e29f ? 1e30f : (worst - c.cheap) * norm;
+        const float d = dtw(U.data(), T.data(), p.steps, p.band, p.radius, limit);
+        if (d >= 1e29f) continue;
+        const float total = d / norm + c.cheap;
+        if (total >= worst) continue;
+        best.insert(std::upper_bound(best.begin(), best.end(), std::make_pair(total, c.word)), {total, c.word});
+        if (best.size() > size_t(topN)) best.pop_back();
+    }
+    for (const auto &b : best) result.push_back({b.second, -b.first, -b.first});
+    return result;
+}
+
+}
+
+namespace swipekb {
+
+GeoPrepared GeoDecoder::prepare(const std::vector<SwipePoint> &trace, float aspect, const GeoParams &p) const {
+    GeoPrepared out;
+    const size_t K = layout_.size();
+    if (trace.empty() || K == 0 || p.steps < 2 || p.steps > 128) return out;
+    const float u = layout_.unit();
+    std::vector<Pt> pts;
+    for (const auto &q : trace) {
+        const Pt c{q.x * u, q.y * u * aspect};
+        if (pts.empty() || std::hypot(c.x - pts.back().x, c.y - pts.back().y) > 1e-4f) pts.push_back(c);
+    }
+    std::vector<Pt> U;
+    resample(pts, p.steps, U, out.length);
+    out.path.reserve(U.size());
+    for (const auto &q : U) out.path.push_back({q.x, q.y});
+    out.miss.resize(K);
+    for (size_t k = 0; k < K; ++k) {
+        const Pt c{layout_.keys()[k].cx * u, layout_.keys()[k].cy * u * aspect};
+        float best = 1e30f;
+        for (const auto &q : U) best = std::min(best, std::hypot(q.x - c.x, q.y - c.y));
+        out.miss[k] = std::max(0.f, best - p.coverRadius);
+    }
+    out.valid = true;
+    return out;
+}
+
+float GeoDecoder::cost(const GeoPrepared &swipe, uint32_t word, float aspect, const GeoParams &p) const {
+    if (!swipe.valid || word >= lex_.wordCount()) return 1e9f;
+    const float u = layout_.unit();
+    const auto &k = lex_.keys(word);
+    std::vector<Pt> poly, T, U(swipe.path.size());
+    float cov = 0, tl;
+    for (uint8_t kk : k) {
+        poly.push_back({layout_.keys()[kk].cx * u, layout_.keys()[kk].cy * u * aspect});
+        cov += swipe.miss[kk];
+    }
+    for (size_t i = 0; i < U.size(); ++i) U[i] = {swipe.path[i].x, swipe.path[i].y};
+    resample(poly, p.steps, T, tl);
+    const float d = dtw(U.data(), T.data(), p.steps, p.band, p.radius, 1e30f);
+    return d / float(2 * p.steps) + p.coverWeight * cov;
+}
+
+}
