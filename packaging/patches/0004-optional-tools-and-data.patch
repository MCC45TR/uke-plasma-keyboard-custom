diff --git a/src/swipekb/include/swipekb/spellings.hpp b/src/swipekb/include/swipekb/spellings.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..762faf9bb497c482925573b1f55f880183fddf97
--- /dev/null
+++ b/src/swipekb/include/swipekb/spellings.hpp
@@ -0,0 +1,63 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Spellings — the dictionary's real spellings of a swipe shape ("its" / "it's", "lets" / "let's").
+//
+// WHY: a swipe never carries apostrophes or hyphens, so one finger path can mean several dictionary words. The guess
+// bar offers the other spelling of the best guess (one tap to switch), and tap-to-swap lists it too.
+// Spellings are lower case except in German, where noun capitals are part of the spelling; Capitals (below) puts
+// back the capitals a word nearly always has ("I'm", "Paris") in the other languages.
+#pragma once
+
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace swipekb {
+
+class Spellings {
+public:
+    // Reads a `.combined` dictionary. Words marked not-a-word (f=0, "nonword", "not_a_word") are ignored, as are
+    // spellings with anything but letters and inner ' or - ("us$", "states'"). German keeps the supplied case.
+    static Spellings fromCombinedFile(const std::string &path, const std::string &language = "en");
+    static Spellings fromCombinedText(const std::string &text, const std::string &language = "en");   // the same, from text (tests)
+    // Physical-key alternatives only (œ drawn through o, or as "oe"); the dictionary spelling stays the shown one.
+    static std::vector<std::string> recognitionAliases(const std::string &word, const std::string &language);
+
+    // The usual spelling of a letters-only form: its most frequent spelling ("lets" -> "let's",
+    // "its" -> "its"); the input itself when the dictionary knows no other.
+    std::string spell(const std::string &letters) const;
+    // The same swipe's other real spellings worth offering in the guess bar, most frequent first ("its" ->
+    // {"it's"}, "let's" -> {"lets"}). Excludes `word` itself; empty for most words.
+    std::vector<std::string> others(const std::string &word) const;
+    bool empty() const { return byLetters_.empty(); }
+
+private:
+    // letters-only, lower case -> real spellings, most frequent first (only where some spelling differs).
+    std::unordered_map<std::string, std::vector<std::string>> byLetters_;
+    std::unordered_map<std::string, std::string> otherKeys_;
+};
+
+// Capitals — which words are shown with a capital letter in English, Spanish and French (packaging/capitals/LANG.tsv:
+// "i\tI", "paris\tParis", "iphone\tiPhone"; counted from web text by scripts/lm/capitals.py).
+//
+// WHY a list of words nearly always capitalised, not the dictionary's most frequent form: web text capitalises many
+// ordinary words inside names ("Banco Santander", "Hall of Fame"), so "Banco" can be a word's most common form while
+// someone typing "el banco" wants lower case. Sentence-start and Shift capitals stay the keyboard's job.
+class Capitals {
+public:
+    // "word<TAB>Form[<TAB>...]" lines; '#' lines are comments. A Form whose letters differ from the word is skipped.
+    // nullptr when no line is usable (an empty list).
+    static std::shared_ptr<const Capitals> fromTsv(const std::string &text);
+    // The listed form of `word` ("i'm" or "I'M" -> "I'm"), otherwise `word` in lower case. Keeps the word's own
+    // apostrophe (' or ’).
+    std::string apply(const std::string &word) const;
+    size_t size() const { return forms_.size(); }
+
+private:
+    std::unordered_map<std::string, std::string> forms_;   // lower case, ' apostrophes -> form
+};
+
+} // namespace swipekb
diff --git a/src/swipekb/include/swipekb/swipe_beam.hpp b/src/swipekb/include/swipekb/swipe_beam.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..cc2521427a4ca1611f31a7358b0ffc893993db0b
--- /dev/null
+++ b/src/swipekb/include/swipekb/swipe_beam.hpp
@@ -0,0 +1,93 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Lexicon trie + CTC prefix beam search: turns the network's per-step key probabilities into ranked words.
+//
+// WHY a trie-constrained search (the published standard for CTC gesture typing): only prefixes of real dictionary
+// words are ever extended, so the search is cheap and can never output a non-word; a word prior (dictionary
+// frequency, or a sentence-context language model) is added when a word is finished, and a cheap optimistic
+// "best word below this prefix" bonus keeps likely words alive while the beam is pruned.
+// Written for this project from its design doc, without reference to other swipe engines' code.
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "swipekb/swipe_layout.hpp"
+
+namespace swipekb {
+
+class SwipeLexicon {
+public:
+    // Adds a word (UTF-8) with a 0..255 frequency score. Words are matched by their folded key sequence; a word that
+    // maps to no key is ignored. Call finish() once after the last add().
+    void add(std::string_view word, int freq, const SwipeLayout &layout);
+    // "word<TAB>freq" lines. Returns the number of words added (0 = unreadable).
+    size_t loadTsv(const std::string &path, const SwipeLayout &layout);
+    void finish();
+
+    size_t wordCount() const { return words_.size(); }
+    const std::string &text(uint32_t w) const { return words_[w].text; }
+    int freq(uint32_t w) const { return words_[w].freq; }
+    const std::vector<uint8_t> &keys(uint32_t w) const { return words_[w].keys; }
+    size_t nodeCount() const { return nodes_.size(); }
+
+    struct Node {
+        int32_t firstChild = -1, nextSibling = -1;
+        uint32_t wordBegin = 0, wordEnd = 0;   // words ending exactly here (best frequency first)
+        uint8_t key = 0;                       // key that leads into this node
+        uint8_t bestFreq = 0;                  // best frequency of any word at or below this node
+    };
+    const Node &node(int32_t i) const { return nodes_[i]; }
+    // Words in trie order, so a node's words are the contiguous range [wordBegin, wordEnd).
+    uint32_t wordAt(uint32_t slot) const { return slot; }
+    // Node reached by a key sequence, or -1.
+    int32_t find(const std::vector<int> &keys) const;
+
+private:
+    struct Word { std::string text; std::vector<uint8_t> keys; int freq; };
+    std::vector<Word> words_;
+    std::vector<Node> nodes_;
+    struct Pending { std::string lower; std::vector<uint8_t> keys; std::string text; int freq; };
+    std::vector<Pending> pending_;
+};
+
+struct BeamParams {
+    int beam = 48;           // prefixes kept per step
+    int keysPerStep = 8;     // only the most likely keys at a step may start a new letter
+    float lookahead = 0.03f; // nats per frequency point of the best word below a prefix (pruning only)
+    float freqWeight = 0.03f;// nats per frequency point added when a word is finished (when no scorer is given)
+    float hintBonus = 4.0f;  // extra pruning bonus for words the sentence context makes likely
+};
+
+struct SwipeCandidate {
+    uint32_t word = 0;
+    float score = 0;   // ctc + prior, nats, higher is better
+    float ctc = 0;     // log-probability of the key sequence alone
+};
+
+// Thread-confined: owns reusable scratch arrays sized to the lexicon.
+class SwipeBeamSearch {
+public:
+    explicit SwipeBeamSearch(const SwipeLexicon &lex) : lex_(lex) {}
+    // logProbs: steps x (1 + keyCount), blank first. `prior` (optional) returns the natural-log prior of a lexicon word
+    // (language model in context + frequency); without it dictionary frequency is used. `hints` are words the context
+    // favours; they get a pruning bonus so the beam does not drop them early.
+    std::vector<SwipeCandidate> decode(const float *logProbs, int steps, int keyCount, const BeamParams &p, int topN,
+                                       const std::function<float(uint32_t)> &prior = {},
+                                       const std::vector<uint32_t> &hints = {});
+
+private:
+    const SwipeLexicon &lex_;
+    std::vector<uint32_t> stamp_;
+    std::vector<int32_t> slot_;
+    std::vector<uint32_t> bonusStamp_;
+    std::vector<float> bonus_;
+    uint32_t generation_ = 0;
+};
+
+}
diff --git a/src/swipekb/include/swipekb/swipe_engine.hpp b/src/swipekb/include/swipekb/swipe_engine.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c4781eaa97512e30350103f126bea82e4cd566a1
--- /dev/null
+++ b/src/swipekb/include/swipekb/swipe_engine.hpp
@@ -0,0 +1,84 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// The swipe engine: trace in, ranked words out. Network + lexicon search + (optional) sentence prior + geometric
+// cross-check, with the geometric decoder as the fallback when no usable model file is installed.
+//
+// WHY one entry point: the keyboard plugin should not know which parts are present. Swiping must never break, so a
+// missing/damaged model, or a search that finds nothing, silently falls back to the geometry-only decoder.
+// Written for this project from its design doc, without reference to other swipe engines' code.
+#pragma once
+
+#include <functional>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "swipekb/swipe_beam.hpp"
+#include "swipekb/swipe_geo.hpp"
+#include "swipekb/swipe_layout.hpp"
+#include "swipekb/swipe_net.hpp"
+
+namespace swipekb {
+
+struct EngineParams {
+    BeamParams beam;
+    GeoParams geo;
+    // How much the geometric cost is subtracted from the network score (nats per cost unit). 0 = network only. 40 was best on clean validation (flat between 30 and 45).
+    float geoWeight = 40.f;
+    // The network's best N words are re-scored with the geometric cost (only matters when geoWeight > 0).
+    int rerank = 20;
+    // Dictionary frequency prior used by the beam search when no sentence prior is set (nats per point).
+    float freqWeight = 0.06f;
+};
+
+class SwipeEngine {
+public:
+    SwipeEngine() = default;
+    // Engines made by copying share the (read-only) layout, lexicon and network; each copy has its own search
+    // scratch, so give every thread its own copy.
+    SwipeEngine(const SwipeEngine &other);
+    SwipeEngine &operator=(const SwipeEngine &) = delete;
+
+    bool loadLayout(const std::string &tsv);
+    void setLayout(SwipeLayout layout);
+    // "word<TAB>freq" lines; returns the number of lines used (0 = unreadable). Builds the lexicon.
+    size_t loadWords(const std::string &tsv);
+    // The same from memory (word, 0..255 frequency); returns the number of words offered. WHY: the language engine
+    // builds its word list from the parsed dictionary plus learned words, with no temporary file.
+    size_t setWords(const std::vector<std::pair<std::string, int>> &words);
+    // False leaves the engine in geometric-only mode.
+    bool loadModel(const std::string &path);
+    bool hasModel() const { return d_ && d_->net.ready(); }
+    bool ready() const { return d_ && d_->lex.wordCount() > 0 && d_->layout.size() > 0; }
+
+    const SwipeLexicon &lexicon() const { return d_->lex; }
+    const SwipeLayout &layout() const { return d_->layout; }
+    EngineParams params;
+
+    // Natural-log prior of a lexicon word in the current sentence (replaces the plain frequency prior), plus the
+    // words the context favours. Pass empty functions to go back to frequency.
+    void setPrior(std::function<float(uint32_t)> prior, std::vector<uint32_t> hints = {});
+
+    // Best first; score is higher-is-better. Network + search when a model is loaded, else geometry.
+    std::vector<SwipeCandidate> decode(const std::vector<SwipePoint> &trace, float aspect, int topN);
+
+private:
+    struct Data {
+        SwipeLayout layout;
+        SwipeLexicon lex;
+        SwipeNet net;
+        std::unique_ptr<GeoDecoder> geo;
+    };
+    void rebuild();
+    std::shared_ptr<Data> d_;
+    std::unique_ptr<SwipeBeamSearch> search_;
+    std::function<float(uint32_t)> prior_;
+    std::vector<uint32_t> hints_;
+    SwipeInput in_;
+    std::vector<float> lp_;
+};
+
+}
diff --git a/src/swipekb/include/swipekb/swipe_geo.hpp b/src/swipekb/include/swipekb/swipe_geo.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..14e092592bcd4033a25d524019300b5f37e05887
--- /dev/null
+++ b/src/swipekb/include/swipekb/swipe_geo.hpp
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Geometric swipe decoder: the fallback used when no network file is installed (and a sanity check for tests).
+//
+// WHY keep it: swiping must never break because a model file is missing, damaged or from a newer version. This
+// decoder needs only the key positions and the word list. Method (published ideas: SHARK2 location channel,
+// dynamic time warping): compare the finger path with each candidate word's path through its key centres by banded
+// DTW (touches inside a key's core cost nothing), add a "every letter was visited" term and a frequency prior.
+// Measured on real English swipes: ~82% first guess / ~90% top 3. Written for this project from its design doc, without reference to other swipe engines' code.
+#pragma once
+
+#include <vector>
+
+#include "swipekb/swipe_beam.hpp"
+#include "swipekb/swipe_layout.hpp"
+#include "swipekb/swipe_net.hpp"
+
+namespace swipekb {
+
+struct GeoParams {
+    int steps = 40;            // equal-length resample points for path and templates
+    int band = 8;              // DTW half band (in steps)
+    float radius = 0.45f;      // key widths: distance inside this costs nothing
+    float coverRadius = 0.4f;  // key widths: letter counts as visited inside this
+    float coverWeight = 0.01f; // per key width of a missed letter
+    float freqWeight = 0.0005f;// per frequency point (0..255)
+    int endKeys = 6;           // nearest keys to the first / last touch that may start / end a word
+    float lenLo = 0.55f, lenHi = 1.8f;   // allowed word-path length relative to the swipe length (with slack)
+};
+
+// A swipe prepared once so many candidate words can be costed against it cheaply.
+struct GeoPoint { float x, y; };
+struct GeoPrepared {
+    std::vector<GeoPoint> path;   // resampled finger path, key-width units
+    std::vector<float> miss;      // per key: how far the path stayed from it, beyond the cover radius
+    float length = 0;
+    bool valid = false;
+};
+
+class GeoDecoder {
+public:
+    // Both must outlive the decoder. Builds the (first key, last key) word index once.
+    GeoDecoder(const SwipeLexicon &lex, const SwipeLayout &layout);
+    // Ranked words, best first; score = -(geometric cost), higher is better. Empty for an empty trace.
+    std::vector<SwipeCandidate> decode(const std::vector<SwipePoint> &trace, float aspect, int topN, const GeoParams &p = {}) const;
+
+    // Cost (lower is better) of one lexicon word against a prepared swipe: DTW + coverage, no frequency term. Used to
+    // sanity-check the network's candidates (a blend of both is more robust to swipers unlike the training data).
+    GeoPrepared prepare(const std::vector<SwipePoint> &trace, float aspect, const GeoParams &p = {}) const;
+    float cost(const GeoPrepared &swipe, uint32_t word, float aspect, const GeoParams &p = {}) const;
+
+private:
+    const SwipeLexicon &lex_;
+    const SwipeLayout &layout_;
+    std::vector<std::vector<uint32_t>> bucket_;   // words by first * keyCount + last
+};
+
+}
diff --git a/src/swipekb/include/swipekb/swipe_layout.hpp b/src/swipekb/include/swipekb/swipe_layout.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..252d4697b47536fe4ba572c70fe09c245a8555ba
--- /dev/null
+++ b/src/swipekb/include/swipekb/swipe_layout.hpp
@@ -0,0 +1,54 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Key geometry for swipe decoding: which keys exist, where they are, and which key a typed character belongs to.
+//
+// WHY a plain list of rectangles: nothing in the swipe engine is QWERTY-specific. AZERTY, QWERTZ, Spanish (with
+// its own n-tilde key) and so on are different lists; accented letters in a word list fold onto their base key
+// unless the layout has a key for them. Written for this project from its design doc, without reference to other swipe engines' code.
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace swipekb {
+
+struct SwipeKey {
+    char32_t label;          // lower-case character printed on the key
+    float cx, cy, hw, hh;    // centre and half size, 0..1 of the letter area (x right, y down)
+};
+
+class SwipeLayout {
+public:
+    SwipeLayout() = default;
+    explicit SwipeLayout(std::vector<SwipeKey> keys);
+    // Reads "letter<TAB>cx<TAB>cy<TAB>half_w<TAB>half_h" lines (first line is a header). False if unreadable/empty.
+    bool loadTsv(const std::string &path);
+
+    const std::vector<SwipeKey> &keys() const { return keys_; }
+    size_t size() const { return keys_.size(); }
+    // 1 / key pitch (distance between neighbouring key centres), in layout units: multiply layout x by this to
+    // measure in key widths (10 on a 10-key row, even when the keys are drawn with gaps).
+    float unit() const { return unit_; }
+    // Key index for a character (accents fold to the base key when this layout has no key for the accent), or -1.
+    int keyOf(char32_t c) const;
+    // Key sequence of a UTF-8 word with consecutive repeats merged ("see" -> s,e) and unmapped characters
+    // (apostrophes, digits, hyphens) dropped. `rawLen` receives the number of mapped letters before merging.
+    std::vector<int> wordKeys(std::string_view utf8, int *rawLen = nullptr) const;
+
+private:
+    std::vector<SwipeKey> keys_;
+    float unit_ = 10.f;
+    std::vector<int> byCodepoint_;   // index by code point < 0x180, -1 if none
+};
+
+// UTF-8 decoding helpers shared by the swipe code.
+std::u32string decodeUtf8(std::string_view s);
+// Lower-case + strip the accent when the result is a plain Latin letter ("É" -> 'e'); other characters lower-cased.
+char32_t foldChar(char32_t c);
+// Lower-case a UTF-8 string keeping accents (ASCII and Latin-1 letters): the identity used to dedupe a word list.
+std::string lowerUtf8(std::string_view s);
+
+}
diff --git a/src/swipekb/include/swipekb/swipe_lm.hpp b/src/swipekb/include/swipekb/swipe_lm.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..9509b51b7e4640fc6637b1f1a6c57176808a9644
--- /dev/null
+++ b/src/swipekb/include/swipekb/swipe_lm.hpp
@@ -0,0 +1,45 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Sentence-context word prior for the swipe search, from the project's own n-gram model (ngram.hpp).
+//
+// WHY a prior object instead of baking the language model into the search: the same decoder then runs with no
+// model (dictionary frequency), with the n-gram file, or with any future scorer; and "the previous words" are
+// fixed per swipe, so the context is prepared once and each candidate word costs a couple of table lookups.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "swipekb/ngram.hpp"
+#include "swipekb/swipe_beam.hpp"
+
+namespace swipekb {
+
+class NgramWordPrior {
+public:
+    // Both must outlive this object. Resolves every lexicon word to its model number once (slow-ish: do it at load).
+    NgramWordPrior(const NgramLM &lm, const SwipeLexicon &lex);
+    // Previous words of the current sentence, oldest first; empty = sentence start. Cheap; call once per swipe.
+    void setContext(const std::vector<std::string> &previousWords);
+    // Natural-log prior of a lexicon word in the current context: weight * ln P_ngram + freqWeight * frequency.
+    float operator()(uint32_t word) const;
+    // Lexicon words the model has seen right after the context (at most maxHints), for the search's pruning bonus.
+    std::vector<uint32_t> hints(size_t maxHints = 200) const;
+
+    // True: ignore the previous words and use the plain word frequency from the model (single-word swipes, benchmarks).
+    bool unigramOnly = false;
+    float lmWeight = 1.0f;     // multiplies ln P from the n-gram file
+    float freqWeight = 0.0f;   // extra nats per dictionary-frequency point (the model already contains frequency)
+
+private:
+    const NgramLM &lm_;
+    const SwipeLexicon &lex_;
+    NgramLM::Context ctx_;
+    std::vector<uint32_t> ids_;                                // model number per lexicon word
+    std::vector<uint32_t> wordsOfId_, idSlot_;                 // lexicon words grouped by model number (CSR rows)
+};
+
+}
diff --git a/src/swipekb/include/swipekb/swipe_net.hpp b/src/swipekb/include/swipekb/swipe_net.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..bdcac1558973a7299e5dca65da71f65708a79e41
--- /dev/null
+++ b/src/swipekb/include/swipekb/swipe_net.hpp
@@ -0,0 +1,65 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Our own small swipe network and its plain-C++ runner (no ML runtime): trace -> per-step key probabilities.
+//
+// WHY this shape: the standard published design for gesture typing is a small neural encoder that gives, for each
+// moment of the swipe, the probability of each letter (trained with CTC, Graves et al. 2006), followed by a
+// lexicon search (swipe_beam.hpp). Keys are given as positions, not as a fixed alphabet, so one network serves
+// any layout. Written for this project without reference to other swipe engines' code;
+// trained only on openly licensed swipes (scripts/swipe/).
+//
+// Model file ("SKNN" v1, little endian) is produced by scripts/swipe/swipelib.py:export_model; its layout is read
+// in swipe_net.cpp. Input building must match scripts/swipe/swipelib.py:trace_to_input exactly (tested).
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "swipekb/swipe_layout.hpp"
+
+namespace swipekb {
+
+struct SwipePoint {
+    float x, y;     // 0..1 of the letter area (may fall slightly outside)
+    double t;       // milliseconds
+};
+
+// What the network sees for one swipe (all float32, row-major).
+struct SwipeInput {
+    int steps = 0, keyCount = 0;
+    std::vector<float> feats;   // steps x 8
+    std::vector<float> pos;     // steps x 2, key-width units
+    std::vector<float> keys;    // keyCount x 4: centre x, centre y, width, height in key-width units
+};
+
+class SwipeNet {
+public:
+    static constexpr int kInFeatures = 8, kKeyFeatures = 4;
+    // False (net stays empty) when missing, truncated or an unknown version; the keyboard then uses the geometric
+    // decoder, so a bad file never breaks swiping.
+    bool load(const std::string &path);
+    bool loadBytes(const std::vector<uint8_t> &bytes);
+    bool ready() const { return steps_ > 0; }
+    int steps() const { return steps_; }
+    size_t parameterCount() const { return params_; }
+
+    // Resample to `steps()` points by arc length and describe each (position, motion, time spent). aspect = canvas
+    // height / width. Returns false for an empty trace or layout.
+    bool buildInput(const std::vector<SwipePoint> &trace, const SwipeLayout &layout, float aspect, SwipeInput &out) const;
+    // Log-probabilities, steps x (1 + keyCount): index 0 is the CTC blank, key k is index k + 1.
+    bool forward(const SwipeInput &in, std::vector<float> &logProbs) const;
+
+private:
+    struct Conv { int cin, cout; std::vector<float> w /* [k][cin][cout] */, b; };
+    struct Dir { std::vector<float> wih /* [in][3H] */, whh /* [H][3H] */, bih, bhh; };
+    int steps_ = 0, kernel_ = 0, hidden_ = 0, layers_ = 0, pointer_ = 0;
+    size_t params_ = 0;
+    std::vector<Conv> convs_;
+    std::vector<Dir> dirs_;   // layer-major: layer0 forward, layer0 reverse, layer1 forward, ...
+    std::vector<float> A_ /* [2H][P] */, Ab_, B_ /* [4][P] */, Bb_, w_, wb_, blankW_, blankB_;
+};
+
+}
diff --git a/src/swipekb/include/swipekb/text.hpp b/src/swipekb/include/swipekb/text.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..93c1acc52bf2e4a3ab7bcc5318f79f62fe0ffd53
--- /dev/null
+++ b/src/swipekb/include/swipekb/text.hpp
@@ -0,0 +1,57 @@
+// SPDX-FileCopyrightText: 2026 Destin Moss <https://youcoded.ai>
+//
+// SPDX-License-Identifier: MIT
+
+// Plain value types shared by every part of the engine and its callers (keyboard plugin, Gaming Mode daemon,
+// tools): a finger path, the on-screen key rectangles, a ranked guess, and the "previous words" rule.
+//
+// WHY a header of its own: callers that only pass swipes and words around (the session logic, the daemon's
+// protocol) should not have to include the whole language engine.
+#pragma once
+
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace swipekb {
+
+struct TracePoint {
+    float x, y;   // pixels, keyboard coordinates
+    float t_ms;   // milliseconds since the swipe started
+};
+
+struct KeyRect {
+    char32_t letter;      // Unicode scalar, lower-cased without changing the measured key center
+    float x, y, w, h;     // top-left corner and size, same pixel space as the trace
+};
+
+struct Candidate {
+    std::string word;
+    float score;          // higher is better; only comparable within one answer
+};
+
+// Key centres and trace in 0..1 coordinates of the letter area (left edge of the leftmost letter key = 0, right
+// edge of the rightmost = 1; the same for rows).
+struct NormalizedInput {
+    std::string letters;                 // UTF-8 profile alphabet (one index per Unicode scalar)
+    std::vector<float> key_cx, key_cy;   // [alphabet code point count], never UTF-8 byte count
+    std::vector<float> x, y, t;          // trace, same length
+};
+
+// nullopt unless every alphabet symbol has measured geometry (or an explicit measured popup base),
+// rectangles/trace are finite and well formed, and the trace has at least 2 points.
+// WHY the keyboard uses it: before a stock key press is turned into a swipe, it checks that the layout really has
+// every letter of the language, so an incomplete layout stays ordinary tapping.
+std::optional<NormalizedInput> normalize(const std::vector<TracePoint> &trace, const std::vector<KeyRect> &keys,
+                                         const std::string &alphabet = "abcdefghijklmnopqrstuvwxyz",
+                                         const std::unordered_map<char32_t, char32_t> &popupAliases = {});
+
+// The words before the cursor that the sentence model should see: only the current sentence (a . ! or ?
+// starts a fresh one), split on whitespace, punctuation trimmed off both ends of each word, last `max` kept,
+// oldest first. Input and output are UTF-8.
+// WHY in the engine and not in the plugin: the live keyboard and the benchmarks must build context with the very
+// same rules, or the benchmarks stop measuring what ships.
+std::vector<std::string> contextWords(const std::string &textBeforeCursor, int max = 20);
+
+} // namespace swipekb
