+// SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+import QtQuick
+import QtQuick.Window
+
+// Observe the actual password control, not an ancestor whose child may consume
+// the event before an ancestor handler sees it.
+// Do not derive native-window activation from global keyboard-visible state.
+PointHandler {
+    required property Item screenRoot
+    required property Item targetItem
+    onTargetItemChanged: if (targetItem) parent = targetItem
+    Component.onCompleted: if (targetItem) parent = targetItem
+    required property Window viewWindow
+    objectName: "localTouchFocus"
+    signal activationRequested()
+    acceptedDevices: PointerDevice.TouchScreen
+    onActiveChanged: {
+        if (active && viewWindow) {
+            screenRoot.uiVisible = true;
+            activationRequested();
+            viewWindow.requestActivate();
+        }
+    }
+}
diff --git a/tools/measure-idle.sh b/tools/measure-idle.sh
new file mode 100755
index 0000000000000000000000000000000000000000..97538c7e4dc78e5784aadb1b0d7379f62af15090
--- /dev/null
+++ b/tools/measure-idle.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/bash
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Bounded, read-only process measurement after the keyboard's physical trial.
+set -Eeuo pipefail
+pid=${1:?Pass the PID of the selected keyboard process}
+seconds=${2:-30}
+[[ $pid =~ ^[1-9][0-9]*$ && $seconds =~ ^[0-9]+$ && $seconds -ge 5 && $seconds -le 60 ]] || exit 2
+exe=$(readlink "/proc/$pid/exe")
+[[ $exe == /usr/bin/uke-plasma-keyboard-custom ]] || { printf 'The PID is not the installed Uke keyboard.\n' >&2; exit 2; }
+stat_line=$(cat "/proc/$pid/stat")
+start_id=$(awk '{sub(/^[0-9]+ \(.*\) /, ""); print $20}' <<<"$stat_line")
+cpu_before=$(awk '{sub(/^[0-9]+ \(.*\) /, ""); print $12+$13}' <<<"$stat_line")
+context_count(){ awk '/^(voluntary_ctxt_switches|nonvoluntary_ctxt_switches):/ {n+=$2} END {print n+0}' /proc/"$pid"/task/*/status; }
+context_before=$(context_count)
+tasks_before=$(printf '%s\n' /proc/"$pid"/task/[0-9]*)
+t0=$(awk '{print $1}' /proc/uptime)
+sleep "$seconds"
+[[ $(readlink "/proc/$pid/exe") == "$exe" ]] || exit 3
+stat_line=$(cat "/proc/$pid/stat")
+[[ $(awk '{sub(/^[0-9]+ \(.*\) /, ""); print $20}' <<<"$stat_line") == "$start_id" ]] || { printf 'The process restarted; discard this sample.\n' >&2; exit 3; }
+cpu_after=$(awk '{sub(/^[0-9]+ \(.*\) /, ""); print $12+$13}' <<<"$stat_line")
+context_after=$(context_count)
+tasks_after=$(printf '%s\n' /proc/"$pid"/task/[0-9]*)
+context_delta=$((context_after-context_before))
+if [[ $tasks_before != "$tasks_after" ]]; then context_delta=null; fi
+t1=$(awk '{print $1}' /proc/uptime)
+hz=$(getconf CLK_TCK)
+pss=$(awk '$1=="Pss:" {print $2}' "/proc/$pid/smaps_rollup")
+rss=$(awk '$1=="VmRSS:" {print $2}' "/proc/$pid/status")
+threads=$(awk '$1=="Threads:" {print $2}' "/proc/$pid/status")
+jq -n --argjson pid "$pid" --argjson before "$cpu_before" --argjson after "$cpu_after" --argjson hz "$hz" --argjson t0 "$t0" --argjson t1 "$t1" --argjson pss "$pss" --argjson rss "$rss" --argjson threads "$threads" --argjson switches "$context_delta" \
+ '{pid:$pid,elapsed_seconds:($t1-$t0),cpu_core_percent:(100*($after-$before)/$hz/($t1-$t0)),pss_kib:$pss,rss_kib:$rss,threads:$threads,context_switch_delta:$switches}'
diff --git a/tools/patch-series.mjs b/tools/patch-series.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c41dce33a8ae6fa33990a4f4a75ba71f5e8869e2
--- /dev/null
+++ b/tools/patch-series.mjs
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: MIT
+// Source maintenance only. Never compiles or changes the installed keyboard.
+import fs from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import crypto from 'node:crypto';
+import {fileURLToPath} from 'node:url';
+import {execFileSync} from 'node:child_process';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const manifestPath = path.join(root, 'packaging/upstream.json');
+const patchDir = path.join(root, 'packaging/patches');
+const hash = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
+const run = (program, args, cwd = root) => execFileSync(program, args, {cwd, maxBuffer: 16 * 1024 * 1024});
+const safe = name => typeof name === 'string' && !path.isAbsolute(name) && !name.split('/').some(p => p === '..' || p === '') && !name.includes('\0');
+const names = [
+    '0001-build-settings-and-identity.patch',
+    '0002-keyboard-interface-and-input.patch',
+    '0003-laptop-and-native-integration.patch',
+    '0004-optional-tools-and-data.patch',
+    '0005-native-regression-coverage.patch',
+];
+const production = name => ['src/', 'kcm/', 'kwin/', 'autotests/', 'tests/', 'tools/', 'plasmoid/', 'data/', 'po/', 'LICENSES/'].some(p => name.startsWith(p)) || ['CMakeLists.txt', 'LICENSE', 'REUSE.toml'].includes(name);
+const group = name => {
+    if (name.startsWith('autotests/') || name.startsWith('tests/')) return 4;
+    if (name.startsWith('kwin/') || name.startsWith('src/laptop/') || name.startsWith('plasmoid/')) return 2;
+    if (name === 'CMakeLists.txt' || name.endsWith('/CMakeLists.txt') || name.startsWith('kcm/') || /src\/org\..*\.(desktop|xml)$/.test(name)) return 0;
+    if (name.startsWith('src/')) {
+        if (/^src\/(clipboard|prediction|swipekb|stt|theme)\//.test(name)) return 3;
+        return 1;
+    }
+    if (production(name)) return 3;
+    throw Error('Unclassified source path: ' + name);
+};
+
+function readManifest() {
+    const m = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+    if (m.schema !== 1 || !/^6\.[0-9]+\.[0-9]+$/.test(m.upstream.version) || !/^[a-f0-9]{40}$/.test(m.upstream.commit) || !/^[a-f0-9]{64}$/.test(m.upstream.sha256)) throw Error('Invalid upstream pin');
+    if (m.patches && JSON.stringify(m.patches.map(p => p.name)) !== JSON.stringify(names)) throw Error('Unexpected patch order');
+    return m;
+}
+
+function check(m) {
+    if (!m.patches || !m.production_files) throw Error('Refresh the reviewed patch series first');
+    const series = fs.readFileSync(path.join(patchDir, 'series'), 'utf8').trim().split('\n');
+    if (JSON.stringify(series) !== JSON.stringify(names)) throw Error('Series order differs');
+    for (const patch of m.patches) {
+        if (!safe(patch.name) || hash(fs.readFileSync(path.join(patchDir, patch.name))) !== patch.sha256) throw Error('Patch digest differs: ' + patch.name);
+    }
+    for (const file of [...m.production_files, ...m.assets]) {
+        if (!safe(file.path) || !fs.lstatSync(path.join(root, file.path)).isFile()) throw Error('Unsafe source path');
+        if (hash(fs.readFileSync(path.join(root, file.path))) !== file.sha256) throw Error('Refresh the patch after reviewing: ' + file.path);
+    }
+    const actual = [];
+    const walk = (directory, prefix) => {
+        for (const item of fs.readdirSync(directory, {withFileTypes: true})) {
+            const name = path.posix.join(prefix, item.name);
+            if (item.isDirectory()) walk(path.join(directory, item.name), name);
+            else if (item.isFile()) actual.push(name);
+            else throw Error('Non-regular production source: ' + name);
+        }
+    };
+    for (const name of ['src', 'kcm', 'kwin', 'autotests', 'tests', 'tools', 'plasmoid', 'data', 'po', 'LICENSES']) {
+        if (fs.existsSync(path.join(root, name))) walk(path.join(root, name), name);
+    }
+    for (const name of ['CMakeLists.txt', 'LICENSE', 'REUSE.toml']) if (fs.existsSync(path.join(root, name))) actual.push(name);
+    const expected = [...m.production_files, ...m.assets].map(f => f.path).sort();
+    if (JSON.stringify(actual.sort()) !== JSON.stringify(expected)) throw Error('Production file set changed; review and refresh the series');
+    const spec = fs.readFileSync(path.join(root, 'packaging/uke-plasma-keyboard-custom.spec'), 'utf8');
+    if (!spec.includes('%global upstream_version ' + m.upstream.version) || !spec.includes('%autosetup -S git -n plasma-keyboard-%{upstream_version} -p1')) throw Error('Recipe must use the original pinned source and Git patches');
+    const recipePatches = [...spec.matchAll(/^Patch[0-9]+:\s+(\S+)$/gm)].map(p => p[1]);
+    if (JSON.stringify(recipePatches) !== JSON.stringify(names)) throw Error('Recipe patch order differs');
+    console.log('Upstream pin, five ordered patches, production sources and retained asset digests passed');
+}
+
+function unpack(m, archive, task) {
+    if (hash(fs.readFileSync(archive)) !== m.upstream.sha256) throw Error('Official archive digest differs');
+    const prefix = `plasma-keyboard-${m.upstream.version}`;
+    const members = run('tar', ['-tJf', archive]).toString().trim().split('\n');
+    if (members.some(n => !n.startsWith(prefix + '/') || !safe(n.replace(/\/$/, '')))) throw Error('Unsafe upstream archive member');
+    const temp = fs.mkdtempSync(path.join(os.tmpdir(), 'uke-keyboard-source-'));
+    fs.chmodSync(temp, 0o700);
+    try {
+        run('tar', ['--no-same-owner', '--no-same-permissions', '-xJf', archive, '-C', temp]);
+        return task(path.join(temp, prefix));
+    } finally {
+        fs.rmSync(temp, {recursive: true, force: true});
+    }
+}
+
+const mode = process.argv[2] || '--check';
+const m = readManifest();
+if (mode === '--check') {
+    check(m);
+} else if (mode === '--verify-base') {
+    check(m);
+    const archive = path.resolve(process.argv[3] || '');
+    unpack(m, archive, base => {
+        for (const patch of m.patches) {
+            const file = path.join(patchDir, patch.name);
+            run('git', ['apply', '--check', '--whitespace=nowarn', file], base);
+            run('git', ['apply', '--whitespace=nowarn', file], base);
+        }
+        for (const file of m.production_files) {
+            const target = path.join(base, file.path);
+            if (!fs.existsSync(target) || hash(fs.readFileSync(target)) !== file.sha256) throw Error('Patch round trip differs: ' + file.path);
+        }
+        console.log('Official source plus the ordered series reproduces every reviewed production file');
+    });
+} else if (mode === '--refresh') {
+    const archive = path.resolve(process.argv[3] || '');
+    const assetPaths = new Set(m.assets.map(a => a.path));
+    for (const file of m.assets) {
+        if (!safe(file.path) || hash(fs.readFileSync(path.join(root, file.path))) !== file.sha256) throw Error('Retained asset changed: ' + file.path);
+    }
+    const files = run('git', ['ls-files', '--cached', '--others', '--exclude-standard', '-z']).toString().split('\0').filter(Boolean).filter(production).filter(n => !assetPaths.has(n)).sort();
+    if (new Set(files).size !== files.length || files.some(n => !safe(n))) throw Error('Duplicate or unsafe source paths');
+    unpack(m, archive, base => {
+        run('git', ['init', '-q', '--initial-branch=source'], base);
+        run('git', ['add', '-f', '--', '.'], base);
+        const baseline = run('git', ['write-tree'], base).toString().trim();
+        for (const name of files) {
+            const from = path.join(root, name), to = path.join(base, name);
+            const stat = fs.lstatSync(from);
+            if (!stat.isFile()) throw Error('Only regular production files are accepted: ' + name);
+            fs.mkdirSync(path.dirname(to), {recursive: true});
+            fs.copyFileSync(from, to); fs.chmodSync(to, stat.mode & 0o777);
+        }
+        run('git', ['add', '-f', '--', ...files], base);
+        fs.mkdirSync(patchDir, {recursive: true});
+        m.patches = names.map((name, index) => {
+            const paths = files.filter(file => group(file) === index);
+            const bytes = run('git', ['diff', '--cached', '--binary', '--full-index', baseline, '--', ...paths], base);
+            if (!bytes.length) throw Error('Empty feature patch: ' + name);
+            fs.writeFileSync(path.join(patchDir, name), bytes);
+            return {name, sha256: hash(bytes)};
+        });
+        m.production_files = files.map(name => ({path: name, sha256: hash(fs.readFileSync(path.join(root, name)))}));
+        fs.writeFileSync(path.join(patchDir, 'series'), names.join('\n') + '\n');
+        fs.writeFileSync(manifestPath, JSON.stringify(m, null, 2) + '\n');
+        console.log('Refreshed five feature patches from the reviewed expanded source');
+    });
+} else {
+    throw Error('Use --check, --refresh ARCHIVE, or --verify-base ARCHIVE');
+}
diff --git a/tools/screenshots.sh b/tools/screenshots.sh
new file mode 100755
index 0000000000000000000000000000000000000000..eefa9e3aee5ff6ce4f22564093fc4d757d53a825
--- /dev/null
+++ b/tools/screenshots.sh
@@ -0,0 +1,175 @@
+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: 2026 Aleksandr Kvintilyanov <bednyj.mops@gmail.com>
+# SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+#
+# Development helper for the landing-page screenshots.
+#
+# The workflow is deliberately split: this script changes the keyboard
+# settings and takes the picture, while the keyboard panel itself is opened by
+# the person at the machine (a tap on a text field or the "Show Virtual
+# Keyboard" shortcut). The panel is an on-screen keyboard, so letting a human
+# open it keeps the frames honest and avoids driving the session from a script.
+#
+# Usage:
+#   tools/screenshots.sh backup                  save the current settings
+#   tools/screenshots.sh restore                 put the saved settings back
+#   tools/screenshots.sh set KEY VALUE [KEY VALUE ...]
+#   tools/screenshots.sh restart                 restart the keyboard (needed for themes)
+#   tools/screenshots.sh wait [SECONDS]          wait until the panel is visible
+#   tools/screenshots.sh shot OUT [--crop WxH+X+Y]
+#   tools/screenshots.sh click X Y
+#   tools/screenshots.sh type TEXT
+#   tools/screenshots.sh key KEYS
+#   tools/screenshots.sh kcm OUT [--click X,Y]... [--crop WxH+X+Y]
+#
+# Environment: SHOTS_OUT (output directory), KB_BIN (keyboard binary),
+# SCREEN_WIDTH/SCREEN_HEIGHT (screen size).
+
+set -euo pipefail
+
+script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+repo_root=$(dirname "$script_dir")
+
+out_dir=${SHOTS_OUT:-$repo_root/.dsh/tmp/landing/raw}
+kb_bin=${KB_BIN:-$HOME/.local/bin/uke-plasma-keyboard-custom}
+kcm_plugin_path=${KCM_PLUGIN_PATH:-$HOME/.local/lib/plugins}
+screen_width=${SCREEN_WIDTH:-1920}
+screen_height=${SCREEN_HEIGHT:-1200}
+runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
+settings_file=${KB_SETTINGS_FILE:-$HOME/.config/uke-plasma-keyboard-customrc}
+settings_backup=$out_dir/settings-backup
+
+export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime_dir/bus}
+export YDOTOOL_SOCKET=${YDOTOOL_SOCKET:-$runtime_dir/.ydotool_socket}
+export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
+
+log() { printf '%s\n' "$*" >&2; }
+die() { printf 'error: %s\n' "$*" >&2; exit 1; }
+
+kwin_prop() {
+    qdbus6 org.kde.KWin /VirtualKeyboard \
+        org.freedesktop.DBus.Properties.Get org.kde.kwin.VirtualKeyboard "$1" 2>/dev/null
+}
+
+panel_visible() { [ "$(kwin_prop visible)" = "true" ]; }
+
+# --- settings -------------------------------------------------------------
+
+cmd_backup() {
+    mkdir -p "$out_dir"
+    cp "$settings_file" "$settings_backup"
+    log "settings saved to $settings_backup"
+}
+
+cmd_restore() {
+    [ -f "$settings_backup" ] || die "no saved settings at $settings_backup"
+    cp "$settings_backup" "$settings_file"
+    log "settings restored from $settings_backup"
+}
+
+cmd_set() {
+    [ $# -ge 2 ] || die "set needs KEY VALUE pairs"
+    while [ $# -gt 0 ]; do
+        kwriteconfig6 --file uke-plasma-keyboard-customrc --group General --key "$1" "$2"
+        log "General/$1 = $2"
+        shift 2
+    done
+    sleep 1
+}
+
+cmd_restart() {
+    "$kb_bin" --restart-input-method >/dev/null 2>&1 || true
+    sleep 3
+    log "keyboard restarted; open the panel again"
+}
+
+cmd_wait() {
+    local seconds=${1:-120} waited=0
+    while [ "$waited" -lt "$seconds" ]; do
+        if panel_visible; then
+            log "panel is visible"
+            return 0
+        fi
+        sleep 1
+        waited=$((waited + 1))
+    done
+    die "the panel did not appear within ${seconds}s"
+}
+
+# --- capture and input ----------------------------------------------------
+
+crop() {
+    local in=$1 out=$2 geometry=$3
+    if [ -z "$geometry" ] || [ "$geometry" = "full" ]; then
+        magick "$in" -strip "$out"
+    else
+        magick "$in" -crop "$geometry" +repage -strip "$out"
+    fi
+}
+
+cmd_shot() {
+    local out=$1 crop_geometry=${3:-full}
+    [ -n "$out" ] || die "shot needs an output path"
+    mkdir -p "$(dirname "$out")"
+    local raw=$out_dir/.raw.png
+    spectacle -b -n -f -o "$raw" >/dev/null 2>&1
+    [ -s "$raw" ] || die "spectacle produced no image"
+    crop "$raw" "$out" "$crop_geometry"
+    log "wrote $out"
+}
+
+cmd_click() {
+    [ $# -eq 2 ] || die "click needs X Y"
+    ydotool mousemove --absolute -x "$1" -y "$2" >/dev/null 2>&1
+    ydotool click 0xC0 >/dev/null 2>&1
+}
+
+cmd_type() { ydotool type "$1" >/dev/null 2>&1; }
+cmd_key() { ydotool key "$1" >/dev/null 2>&1; }
+
+cmd_kcm() {
+    local out= crop_geometry= clicks=()
+    while [ $# -gt 0 ]; do
+        case "$1" in
+            --crop) crop_geometry=$2; shift 2 ;;
+            --click) clicks+=("$2"); shift 2 ;;
+            -*) die "unknown option $1" ;;
+            *) out=$1; shift ;;
+        esac
+    done
+    [ -n "$out" ] || die "kcm needs an output path"
+
+    QT_PLUGIN_PATH="$kcm_plugin_path" setsid kcmshell6 kcm_uke_plasma_keyboard_custom \
+        >"$out_dir/kcm.log" 2>&1 </dev/null &
+    sleep 9
+    local point
+    for point in "${clicks[@]}"; do
+        cmd_click "${point%%,*}" "${point##*,}"
+        sleep 1
+    done
+    cmd_shot "$out" --crop "${crop_geometry:-full}"
+    pkill -f 'kcmshell6 kcm_uke_plasma_keyboard_custom' >/dev/null 2>&1 || true
+}
+
+usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }
+
+main() {
+    local command=${1:-}
+    [ $# -gt 0 ] && shift
+    case "$command" in
+        backup) cmd_backup ;;
+        restore) cmd_restore ;;
+        set) cmd_set "$@" ;;
+        restart) cmd_restart ;;
+        wait) cmd_wait "$@" ;;
+        shot) cmd_shot "$@" ;;
+        click) cmd_click "$@" ;;
+        type) cmd_type "$@" ;;
+        key) cmd_key "$@" ;;
+        kcm) cmd_kcm "$@" ;;
+        ''|-h|--help|help) usage ;;
+        *) die "unknown command $command" ;;
+    esac
+}
+
+main "$@"
diff --git a/tools/uke-plasma-keyboard-lock-switcher b/tools/uke-plasma-keyboard-lock-switcher
new file mode 100755
index 0000000000000000000000000000000000000000..ce59fd888ae4037478b8f1006c24926b3b1e829c
--- /dev/null
+++ b/tools/uke-plasma-keyboard-lock-switcher
@@ -0,0 +1,61 @@
+#!/usr/bin/bash
+# SPDX-FileCopyrightText: 2026 Plasma Keyboard contributors
+# SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+set -u
+
+session_keyboard=${1:?missing session keyboard desktop file}
+lock_keyboard=${2:?missing lock-screen keyboard desktop file}
+
+set_keyboard()
+{
+    local desktop_file=$1
+    local configured enabled
+
+    enabled=$(kreadconfig6 --file kwinrc --group Wayland --key VirtualKeyboardEnabled --default true)
+    if [[ $enabled != "true" ]]; then
+        return
+    fi
+
+    configured=$(kreadconfig6 --file kwinrc --group Wayland --key InputMethod)
+    # Never undo the user's choice of None or another input method. Only
+    # switch between the two keyboards managed by this service.
+    if [[ $configured != "$session_keyboard" && $configured != "$lock_keyboard" ]]; then
+        return
+    fi
+    if [[ $configured == "$desktop_file" ]]; then
+        return
+    fi
+
+    kwriteconfig6 --notify --file kwinrc --group Wayland --key InputMethod "$desktop_file"
+}
+
+apply_current_state()
+{
+    local active
+
+    active=$(gdbus call --session \
+        --dest org.freedesktop.ScreenSaver \
+        --object-path /ScreenSaver \
+        --method org.freedesktop.ScreenSaver.GetActive)
+    if [[ $active == "(true,)" ]]; then
+        set_keyboard "$lock_keyboard"
+    else
+        set_keyboard "$session_keyboard"
+    fi
+}
+
+apply_current_state
+
+while IFS= read -r event; do
+    case $event in
+        *"org.freedesktop.ScreenSaver.ActiveChanged (true,)"*)
+            set_keyboard "$lock_keyboard"
+            ;;
+        *"org.freedesktop.ScreenSaver.ActiveChanged (false,)"*)
+            set_keyboard "$session_keyboard"
+            ;;
+    esac
+done < <(gdbus monitor --session \
+    --dest org.freedesktop.ScreenSaver \
+    --object-path /ScreenSaver)
