+    void parakeetTranscribes()
+    {
+        const QString model = modelFromEnvironment("PLASMA_KEYBOARD_STT_TEST_MODEL");
+        if (model.isEmpty()) {
+            QSKIP("PLASMA_KEYBOARD_STT_TEST_MODEL is not set to a Parakeet GGUF model");
+        }
