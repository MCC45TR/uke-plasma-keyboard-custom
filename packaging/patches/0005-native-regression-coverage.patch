--- /dev/null
+++ b/autotests/asyncpredictortest.cpp
@@ -0,0 +1,156 @@
+/*
+    SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "asyncpredictor.h"
+#include "predictivedictionary.h"
+#include "wordpredictor.h"
+
+#include <QElapsedTimer>
+#include <QSemaphore>
+#include <QSignalSpy>
+#include <QTest>
+#include <QThread>
+#include <QTimer>
+#include <atomic>
+#include <memory>
+
+class AsyncPredictorTest : public QObject
+{
+    Q_OBJECT
+    struct WorkState {
+        QSemaphore gate;
+        std::atomic_int calls = 0;
+        std::atomic_bool workerThread = false;
+        std::atomic<QThread *> worker = nullptr;
+    };
+private Q_SLOTS:
+    void responsiveAndCoalesced()
+    {
+        auto state = std::make_shared<WorkState>();
+        AsyncPredictor predictor([state, mainThread = thread()](const AsyncPredictor::Request &request) {
+            state->workerThread = QThread::currentThread() != mainThread;
+            if (++state->calls == 1) {
+                state->gate.tryAcquire(1, 3000);
+            }
+            return AsyncPredictor::Result{{request.prefix + request.locale}, QStringLiteral("complete")};
+        });
+        predictor.request(QStringLiteral("old"), {}, QStringLiteral("en_US"), 5, 2, true, true);
+        QTRY_COMPARE(state->calls.load(), 1);
+        QVERIFY(state->workerThread.load());
+
+        int ticks = 0;
+        QTimer timer;
+        connect(&timer, &QTimer::timeout, this, [&] {
+            ++ticks;
+        });
+        timer.start(1);
+        for (int i = 0; i < 100; ++i) {
+            predictor.request(QStringLiteral("discard%1").arg(i), {}, QStringLiteral("en_US"), 5, 2, true, true);
+        }
+        predictor.request(QStringLiteral("latest"), {}, QStringLiteral("uk_UA"), 5, 2, true, true);
+        QTest::qWait(30);
+        QVERIFY(ticks > 0);
+        QCOMPARE(state->calls.load(), 1);
+        QVERIFY(predictor.predictions().isEmpty());
+        QSignalSpy results(&predictor, &AsyncPredictor::predictionsChanged);
+        state->gate.release();
+        QTRY_COMPARE(predictor.predictions().size(), 1);
+        QCOMPARE(state->calls.load(), 2);
+        QCOMPARE(results.count(), 1); // The old locale/prefix was never published.
+        const auto item = predictor.predictions().first().toMap();
+        QCOMPARE(item.value(QStringLiteral("text")).toString(), QStringLiteral("latestuk_UA"));
+        QCOMPARE(item.value(QStringLiteral("completion")).toInt(), 5);
+    }
+
+    void cancelDropsPendingAndResult()
+    {
+        auto state = std::make_shared<WorkState>();
+        AsyncPredictor predictor([state](const AsyncPredictor::Request &) {
+            ++state->calls;
+            state->gate.tryAcquire(1, 3000);
+            return AsyncPredictor::Result{{QStringLiteral("obsolete")}, QStringLiteral("correct")};
+        });
+        predictor.request(QStringLiteral("old"), {}, QStringLiteral("en_US"), 5, 2, true, true);
+        QTRY_COMPARE(state->calls.load(), 1);
+        predictor.request(QStringLiteral("pending"), {}, QStringLiteral("en_US"), 5, 2, true, true);
+        predictor.cancel(); // Hidden panel, disabled setting or lost focus.
+        QSignalSpy results(&predictor, &AsyncPredictor::predictionsChanged);
+        state->gate.release();
+        QTest::qWait(100);
+        QCOMPARE(state->calls.load(), 1);
+        QCOMPARE(results.count(), 0);
+        QVERIFY(predictor.predictions().isEmpty());
+        // The facade can be reused after cancellation.
+        state->gate.release();
+        predictor.request(QStringLiteral("new"), {}, QStringLiteral("uk_UA"), 5, 2, true, true);
+        QTRY_COMPARE(predictor.predictions().size(), 1);
+    }
+
+    void destructionDoesNotWait()
+    {
+        auto state = std::make_shared<WorkState>();
+        auto predictor = std::make_unique<AsyncPredictor>([state](const AsyncPredictor::Request &) {
+            state->worker = QThread::currentThread();
+            state->gate.tryAcquire(1, 3000);
+            return AsyncPredictor::Result{};
+        });
+        predictor->request(QStringLiteral("slow"), {}, QStringLiteral("en_US"), 5, 2, true, true);
+        QTRY_VERIFY(state->worker.load());
+        QSignalSpy finished(state->worker.load(), &QThread::finished);
+        QElapsedTimer elapsed;
+        elapsed.start();
+        predictor.reset();
+        QVERIFY(elapsed.elapsed() < 250);
+        state->gate.release();
+        QTRY_COMPARE(finished.count(), 1);
+    }
+
+    void noWorkBelowThreshold()
+    {
+        auto state = std::make_shared<WorkState>();
+        AsyncPredictor predictor([state](const AsyncPredictor::Request &) {
+            ++state->calls;
+            return AsyncPredictor::Result{};
+        });
+        predictor.request(QStringLiteral("a"), {}, QStringLiteral("en_US"), 5, 2, true, true);
+        predictor.request({}, {}, QStringLiteral("en_US"), 5, 2, true, false);
+        predictor.request(QStringLiteral("valid"), {}, QStringLiteral("en_US"), 0, 2, true, true);
+        QTest::qWait(30);
+        QCOMPARE(state->calls.load(), 0);
+    }
+
+    void realBackend()
+    {
+        // Synthetic test inputs only; no live input, clipboard or desktop bus.
+        PredictiveDictionary dictionary;
+        WordPredictor nextWord;
+        AsyncPredictor predictor;
+        QSignalSpy results(&predictor, &AsyncPredictor::predictionsChanged);
+        const auto check = [&](const QString &prefix, const QString &context, const QStringList &expected, const QString &kind) {
+            predictor.request(prefix, context, QStringLiteral("en_US"), 5, 2, true, true);
+            const int before = results.count();
+            QTRY_VERIFY(results.count() > before);
+            QStringList actual;
+            for (const auto &item : predictor.predictions()) {
+                actual.append(item.toMap().value(QStringLiteral("text")).toString());
+                QCOMPARE(item.toMap().value(QStringLiteral("kind")).toString(), kind);
+            }
+            QCOMPARE(actual, expected);
+        };
+        check(QStringLiteral("hel"), {}, dictionary.complete(QStringLiteral("hel"), 5, QStringLiteral("en_US")), QStringLiteral("complete"));
+        // A trailing extra character ensures no completion masks correction.
+        QVERIFY(dictionary.complete(QStringLiteral("hello!"), 5, QStringLiteral("en_US")).isEmpty());
+        const auto corrections = dictionary.correct(QStringLiteral("hello!"), 5, QStringLiteral("en_US"));
+        QVERIFY(!corrections.isEmpty());
+        check(QStringLiteral("hello!"), {}, corrections, QStringLiteral("correct"));
+        const auto next = nextWord.predict(QStringLiteral("thank"), 5, QStringLiteral("en_US"));
+        QVERIFY(!next.isEmpty());
+        check({}, QStringLiteral("thank"), next, QStringLiteral("next"));
+        predictor.cancel();
+        QVERIFY(predictor.predictions().isEmpty());
+    }
+};
+
+QTEST_GUILESS_MAIN(AsyncPredictorTest)
+#include "asyncpredictortest.moc"
diff --git a/autotests/clipboardhistorytest.cpp b/autotests/clipboardhistorytest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e6c45dcd468fec7fec6fd6a92bf8d7daaa409017
--- /dev/null
+++ b/autotests/clipboardhistorytest.cpp
@@ -0,0 +1,271 @@
+/*
+    SPDX-FileCopyrightText: 2026 uke-plasma-keyboard-custom contributors
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "clipboardhistory.h"
+#include "plasmakeyboardsettings.h"
+#include "sessionlockstate.h"
+
+#include <QAbstractItemModelTester>
+#include <QDBusMessage>
+#include <QDBusVirtualObject>
+#include <QTest>
+#include <QTimer>
+#include <QTemporaryDir>
+#include <QSignalSpy>
+#include <memory>
+
+class FakeService : public QDBusVirtualObject
+{
+public:
+    bool locked = false;
+    int reads = 0;
+    int clears = 0;
+    int delay = 0;
+    QStringList entries;
+    QString introspect(const QString &) const override
+    {
+        return {};
+    }
+    bool handleMessage(const QDBusMessage &message, const QDBusConnection &bus) override
+    {
+        QVariantList values;
+        int replyDelay = 0;
+        if (message.member() == QLatin1String("GetActive")) {
+            values << locked;
+        } else if (message.member() == QLatin1String("getClipboardHistoryItem")) {
+            ++reads;
+            values << entries.value(message.arguments().first().toInt());
+            replyDelay = delay;
+        } else if (message.member() == QLatin1String("clearClipboardHistory")) {
+            ++clears;
+            entries.clear();
+        } else {
+            return false;
+        }
+        QTimer::singleShot(replyDelay, this, [message, bus, values] {
+            bus.send(message.createReply(values));
+        });
+        return true;
+    }
+};
+
+class ClipboardHistoryTest : public QObject
+{
+    Q_OBJECT
+    std::unique_ptr<QDBusConnection> m_serviceBus;
+    std::unique_ptr<FakeService> m_service;
+    QTemporaryDir m_privateConfig;
+
+    void lock(bool active)
+    {
+        m_service->locked = active;
+        auto signal =
+            QDBusMessage::createSignal(QStringLiteral("/ScreenSaver"), QStringLiteral("org.freedesktop.ScreenSaver"), QStringLiteral("ActiveChanged"));
+        signal << active;
+        QVERIFY(m_serviceBus->send(signal));
+    }
+    void historySignal()
+    {
+        QVERIFY(m_serviceBus->send(
+            QDBusMessage::createSignal(QStringLiteral("/klipper"), QStringLiteral("org.kde.klipper.klipper"), QStringLiteral("clipboardHistoryUpdated"))));
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        if (qgetenv("PLASMA_KEYBOARD_TEST_ISOLATED_BUS") != "1") {
+            QSKIP("Private dbus-run-session required; NEVER fake Klipper or ScreenSaver on a real desktop bus");
+        }
+        QVERIFY(m_privateConfig.isValid());
+        qputenv("XDG_CONFIG_HOME",m_privateConfig.path().toUtf8());
+        m_serviceBus = std::make_unique<QDBusConnection>(QDBusConnection::connectToBus(QDBusConnection::SessionBus, QStringLiteral("clipboard-test-service")));
+        QVERIFY(m_serviceBus->isConnected());
+        m_service = std::make_unique<FakeService>();
+        QVERIFY(m_serviceBus->registerVirtualObject(QStringLiteral("/ScreenSaver"), m_service.get()));
+        QVERIFY(m_serviceBus->registerVirtualObject(QStringLiteral("/klipper"), m_service.get()));
+        QVERIFY(m_serviceBus->registerService(QStringLiteral("org.freedesktop.ScreenSaver")));
+        QVERIFY(m_serviceBus->registerService(QStringLiteral("org.kde.klipper")));
+    }
+
+    void init()
+    {
+        m_service->locked = false;
+        m_service->reads = 0;
+        m_service->clears = 0;
+        m_service->delay = 0;
+        m_service->entries = {QStringLiteral("fixture-a"), QStringLiteral("fixture-b")};
+        PlasmaKeyboardSettings::self()->setClipboardEnabled(true);
+    }
+
+    void startupUnknownAndLockedNeverRead()
+    {
+        m_service->locked = true;
+        SessionLockState state;
+        ClipboardHistory model(&state);
+        model.setAccessAllowed(true);
+        QVERIFY(!model.isAvailable());
+        QTRY_VERIFY(state.isKnown());
+        QVERIFY(state.isLocked());
+        historySignal();
+        QVERIFY(QMetaObject::invokeMethod(&model, "refresh", Qt::DirectConnection));
+        model.clear();
+        QTest::qWait(2100); // A whole polling interval must not access Klipper.
+        QCOMPARE(m_service->reads, 0);
+        QCOMPARE(m_service->clears, 0);
+        QVERIFY(model.textAt(0).isEmpty());
+        QCOMPARE(model.count(), 0);
+    }
+
+    void lockPurgesLocalCacheWithoutClearingDesktop()
+    {
+        SessionLockState state;
+        ClipboardHistory model(&state);
+        QAbstractItemModelTester tester(&model, QAbstractItemModelTester::FailureReportingMode::QtTest);
+        QTRY_VERIFY(state.allowsPredictions());
+        QCOMPARE(m_service->reads, 0); // No field has granted access yet.
+        model.setAccessAllowed(true);
+        QTRY_COMPARE(model.count(), 2);
+        QCOMPARE(model.textAt(0), QStringLiteral("fixture-a"));
+        const auto oldIndex = model.index(0);
+        lock(true);
+        QTRY_VERIFY(state.isLocked());
+        QCOMPARE(model.rowCount(), 0);
+        QVERIFY(model.textAt(0).isEmpty());
+        QVERIFY(!model.data(oldIndex, ClipboardHistory::TextRole).isValid());
+        model.clear();
+        historySignal();
+        const int reads = m_service->reads;
+        QTest::qWait(50);
+        QCOMPARE(m_service->reads, reads);
+        QCOMPARE(m_service->clears, 0);
+        QCOMPARE(m_service->entries.size(), 2); // Never erase the user's history.
+    }
+
+    void disabledSignalCannotBypassGuard()
+    {
+        PlasmaKeyboardSettings::self()->setClipboardEnabled(false);
+        SessionLockState state;
+        ClipboardHistory model(&state);
+        QTRY_VERIFY(state.allowsPredictions());
+        model.setAccessAllowed(true);
+        historySignal();
+        QVERIFY(QMetaObject::invokeMethod(&model, "refresh", Qt::DirectConnection));
+        model.clear();
+        QTest::qWait(50);
+        QCOMPARE(m_service->reads, 0);
+        QCOMPARE(m_service->clears, 0);
+    }
+
+    void pendingReplyAfterLockIsDiscarded()
+    {
+        m_service->delay = 180;
+        SessionLockState state;
+        ClipboardHistory model(&state);
+        QTRY_VERIFY(state.allowsPredictions());
+        model.setAccessAllowed(true);
+        QTRY_COMPARE(m_service->reads, 1);
+        bool eventLoopResponsive = false;
+        QTimer::singleShot(0, this, [&] {
+            eventLoopResponsive = true;
+        });
+        QTRY_VERIFY(eventLoopResponsive);
+        lock(true);
+        QTRY_VERIFY(state.isLocked());
+        QTest::qWait(220);
+        QCOMPARE(m_service->reads, 1); // No request for index 1 after the lock.
+        QCOMPARE(model.count(), 0);
+        QVERIFY(model.textAt(0).isEmpty());
+        m_service->delay = 0;
+        m_service->entries = {QStringLiteral("new-fixture")};
+        lock(false);
+        QTRY_COMPARE(model.count(), 1);
+        QCOMPARE(model.textAt(0), QStringLiteral("new-fixture"));
+    }
+
+    void protectedFieldAndRapidChangesCoalesce()
+    {
+        m_service->delay = 100;
+        SessionLockState state;
+        ClipboardHistory model(&state);
+        QTRY_VERIFY(state.allowsPredictions());
+        model.setAccessAllowed(true);
+        QTRY_COMPARE(m_service->reads, 1);
+        for (int i = 0; i < 20; ++i) {
+            model.setAccessAllowed(false);
+            historySignal();
+            model.setAccessAllowed(true);
+        }
+        QCOMPARE(m_service->reads, 1); // Still just one outstanding D-Bus read.
+        m_service->delay = 0;
+        m_service->entries = {QStringLiteral("latest-fixture")};
+        QTRY_COMPARE(model.count(), 1);
+        QCOMPARE(model.textAt(0), QStringLiteral("latest-fixture"));
+        QCOMPARE(m_service->reads, 3); // Old request + latest index 0 and terminator.
+        model.setAccessAllowed(false);
+        QVERIFY(!model.isAvailable());
+        QCOMPARE(model.count(), 0);
+        QVERIFY(model.textAt(0).isEmpty());
+    }
+
+    void destroyWithPendingReply()
+    {
+        m_service->delay = 150;
+        SessionLockState state;
+        auto model = std::make_unique<ClipboardHistory>(&state);
+        QTRY_VERIFY(state.allowsPredictions());
+        model->setAccessAllowed(true);
+        QTRY_COMPARE(m_service->reads, 1);
+        model.reset();
+        QTest::qWait(200);
+        QCOMPARE(m_service->reads, 1);
+    }
+
+    void lockStateLifetimeIsFailClosed()
+    {
+        auto state = std::make_unique<SessionLockState>();
+        ClipboardHistory model(state.get());
+        QTRY_VERIFY(state->allowsPredictions());
+        model.setAccessAllowed(true);
+        QTRY_COMPARE(model.count(), 2);
+        state.reset();
+        QVERIFY(!model.isAvailable());
+        QCOMPARE(model.count(), 0);
+        QCOMPARE(model.rowCount(), 0);
+        model.clear();
+        QVERIFY(model.textAt(0).isEmpty());
+        QCOMPARE(m_service->clears, 0);
+    }
+
+    void pinsRespectFieldLockAndSetting()
+    {
+        SessionLockState state;
+        ClipboardHistory model(&state);
+        QTRY_VERIFY(state.allowsPredictions());model.setAccessAllowed(true);QTRY_COMPARE(model.count(),2);
+        model.pin(0);model.pin(0);
+        QCOMPARE(model.pinnedTexts(),QStringList{QStringLiteral("fixture-a")});
+        QSignalSpy changed(&model,&ClipboardHistory::pinsChanged);
+        model.setAccessAllowed(false);QVERIFY(model.pinnedTexts().isEmpty());model.unpin(0);model.pin(1);
+        QVERIFY(!changed.isEmpty());
+        model.setAccessAllowed(true);QTRY_COMPARE(model.count(),2);
+        QCOMPARE(model.pinnedTexts(),QStringList{QStringLiteral("fixture-a")});
+        lock(true);QTRY_VERIFY(state.isLocked());QVERIFY(model.pinnedTexts().isEmpty());model.unpin(0);model.pin(1);
+        lock(false);QTRY_VERIFY(state.allowsPredictions());
+        QCOMPARE(model.pinnedTexts(),QStringList{QStringLiteral("fixture-a")});
+        PlasmaKeyboardSettings::self()->setClipboardEnabled(false);QVERIFY(model.pinnedTexts().isEmpty());model.unpin(0);
+        PlasmaKeyboardSettings::self()->setClipboardEnabled(true);
+        QCOMPARE(model.pinnedTexts(),QStringList{QStringLiteral("fixture-a")});
+        model.unpin(0);QVERIFY(model.pinnedTexts().isEmpty());QCOMPARE(m_service->clears,0);
+        m_service->entries={QString(65537,QChar(u'a'))};historySignal();QTRY_COMPARE(model.count(),1);
+        model.pin(0);QVERIFY(model.pinnedTexts().isEmpty());
+    }
+
+    void cleanupTestCase()
+    {
+        m_serviceBus.reset();
+        QDBusConnection::disconnectFromBus(QStringLiteral("clipboard-test-service"));
+    }
+};
+
+QTEST_GUILESS_MAIN(ClipboardHistoryTest)
+#include "clipboardhistorytest.moc"
