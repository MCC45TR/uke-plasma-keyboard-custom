+void LaptopController::setRawKey(uint code,bool pressed){backendInput(QStringLiteral("Key"),{code,pressed});if(m_state)xkb_state_update_key(m_state.get(),code+8,pressed?XKB_KEY_DOWN:XKB_KEY_UP);}
+void LaptopController::key(uint code,bool pressed){
+ if(!m_ready||m_locked)return;
+ const auto time=m_clock.elapsed();
+ if(pressed){
+  if(m_held.contains(code))return;m_held.insert(code);m_pressTimes[code]=time;
+  if(modifier(code)){
+   if(m_lockedKeys.remove(code)){m_latched.remove(code);m_cancelLatch.insert(code);setRawKey(code,false);}
+   else if(!m_latched.contains(code))setRawKey(code,true);
+  }else{for(uint k:m_held)if(modifier(k))m_modifierUsed.insert(k);setRawKey(code,true);markTyping();}
+ }else{
+  if(!m_held.remove(code))return;
+  if(modifier(code)){
+   if(m_cancelLatch.remove(code)){}
+   else if(m_modifierUsed.remove(code)||time-m_pressTimes.value(code)>250){m_latched.remove(code);m_lockedKeys.remove(code);setRawKey(code,false);}
+   else if(m_latched.contains(code)&&time-m_tapTimes.value(code)<400){m_lockedKeys.insert(code);}
+   else if(m_latched.remove(code)){setRawKey(code,false);}
+   else{m_latched.insert(code);m_tapTimes[code]=time;}
+  }else{setRawKey(code,false);consumeLatched();}
+ }
+ ++m_revision;Q_EMIT keyStateChanged();
+}
+void LaptopController::tap(uint code){key(code,true);key(code,false);}
+void LaptopController::markTyping(){if(!m_typing){m_typing=true;Q_EMIT typingChanged();}m_typingTimer.start();}
+void LaptopController::moveCursor(int steps){for(int n=0;n<std::min(64,std::abs(steps));n++)tap(steps<0?KEY_LEFT:KEY_RIGHT);}
+bool LaptopController::consumeLatched(){bool changed=false;const auto latched=m_latched;for(uint k:latched)if(!m_lockedKeys.contains(k)&&!m_held.contains(k)){setRawKey(k,false);m_latched.remove(k);changed=true;}return changed;}
+void LaptopController::deleteWords(int count){if(!nativeInputAllowed()||count<=0)return;const bool temporary=!m_held.contains(KEY_LEFTCTRL)&&!m_latched.contains(KEY_LEFTCTRL);if(temporary)setRawKey(KEY_LEFTCTRL,true);for(int n=0;n<std::min(32,count);n++){setRawKey(KEY_BACKSPACE,true);setRawKey(KEY_BACKSPACE,false);}if(temporary)setRawKey(KEY_LEFTCTRL,false);consumeLatched();markTyping();++m_revision;Q_EMIT keyStateChanged();}
+void LaptopController::releaseAll(){backendInput(QStringLiteral("ReleaseAll"));m_pointerButtons.clear();resetPadMotion();m_held.clear();m_latched.clear();m_lockedKeys.clear();m_modifierUsed.clear();m_cancelLatch.clear();if(m_keymap)m_state.reset(xkb_state_new(m_keymap.get()));applyLocks();++m_revision;Q_EMIT keyStateChanged();Q_EMIT layoutChanged();}
+void LaptopController::motion(double x,double y){const double speed=m_options.value("pointerSpeed").toDouble();backendInput(QStringLiteral("Motion"),{x*speed,y*speed});}
+void LaptopController::resetPadMotion(){m_padMotion.reset(m_clock.nsecsElapsed()/1000);}
+void LaptopController::padMotion(double x,double y){
+ if(!nativeInputAllowed())return;
+ const auto delta=m_padMotion.map(QPointF(x,y),m_clock.nsecsElapsed()/1000,m_options.value("pointerAcceleration").toBool());
+ if(!delta.isNull())motion(delta.x(),delta.y());
+}
+void LaptopController::setTouchActive(bool active){m_touchActive=active;updatePixelShiftBusy();}
+void LaptopController::syncPixelShift(){
+ const bool enabled=!m_preferencesOnly&&staticActive()&&m_options.value("pixelShift").toBool();
+ if(m_pixelShift.setActive(enabled))Q_EMIT pixelShiftChanged();
+ updatePixelShiftBusy();
+ if(!enabled)m_pixelShiftTimer.stop();
+ else if(!m_pixelShift.pending()&&!m_pixelShiftTimer.isActive())m_pixelShiftTimer.start();
+}
+void LaptopController::updatePixelShiftBusy(){
+ if(m_pixelShift.setBusy(m_touchActive||m_typing||!m_held.isEmpty()||!m_pointerButtons.isEmpty())){
+  Q_EMIT pixelShiftChanged();if(m_pixelShift.active())m_pixelShiftTimer.start();
+ }
+}
+void LaptopController::advancePixelShift(){
+ m_pixelShiftTimer.stop();
+ if(m_pixelShift.step())Q_EMIT pixelShiftChanged();
+ if(m_pixelShift.active()&&!m_pixelShift.pending())m_pixelShiftTimer.start();
+}
+void LaptopController::button(uint code,bool pressed){if(code<BTN_LEFT||code>BTN_MIDDLE||(pressed&&!nativeInputAllowed()))return;if(pressed)m_pointerButtons.insert(code);else m_pointerButtons.remove(code);updatePixelShiftBusy();backendInput(QStringLiteral("Button"),{code,pressed});if(!pressed&&consumeLatched()){++m_revision;Q_EMIT keyStateChanged();}}
+void LaptopController::scroll(double x,double y){const double sign=m_options.value("naturalScroll").toBool()?-1:1;backendInput(QStringLiteral("Scroll"),{x*sign,y*sign});}
+void LaptopController::swipe(int fingers,int phase,double x,double y){backendInput(QStringLiteral("Swipe"),{fingers,phase,x,y});}
+void LaptopController::pinch(int phase,double scale,double angle,double x,double y){backendInput(QStringLiteral("Pinch"),{phase,scale,angle,x,y});}
+void LaptopController::openPreferences(){Q_EMIT preferencesRequested();}
+QString LaptopController::toolLabel(const QString&name)const{
+ const QHash<QString,QString> labels{{"volume",i18nd("uke-plasma-keyboard-custom", "Volume")},{"brightness",i18nd("uke-plasma-keyboard-custom", "Brightness")},{"media",i18nd("uke-plasma-keyboard-custom", "Media")},{"volume-down",i18nd("uke-plasma-keyboard-custom", "Volume down")},{"volume-up",i18nd("uke-plasma-keyboard-custom", "Volume up")},{"mute",i18nd("uke-plasma-keyboard-custom", "Mute")},{"brightness-down",i18nd("uke-plasma-keyboard-custom", "Decrease brightness")},{"brightness-up",i18nd("uke-plasma-keyboard-custom", "Increase brightness")},{"previous",i18nd("uke-plasma-keyboard-custom", "Previous track")},{"play",i18nd("uke-plasma-keyboard-custom", "Play or pause")},{"next",i18nd("uke-plasma-keyboard-custom", "Next track")},{"clipboard",i18nd("uke-plasma-keyboard-custom", "Clipboard")},{"emoji",i18nd("uke-plasma-keyboard-custom", "Emoji")},{"language",i18nd("uke-plasma-keyboard-custom", "Input language")},{"settings",i18nd("uke-plasma-keyboard-custom", "Keyboard settings")}};
+ return labels.value(name,name);
+}
+void LaptopController::tool(const QString&name){
+ const QHash<QString,uint> keys{{"volume-down",KEY_VOLUMEDOWN},{"volume-up",KEY_VOLUMEUP},{"mute",KEY_MUTE},{"brightness-down",KEY_BRIGHTNESSDOWN},{"brightness-up",KEY_BRIGHTNESSUP},{"play",KEY_PLAYPAUSE},{"previous",KEY_PREVIOUSSONG},{"next",KEY_NEXTSONG}};
+ if(keys.contains(name)){tap(keys.value(name));return;}
+ if(name==QLatin1String("settings"))openPreferences();else if(name==QLatin1String("language"))nextLayout();
+}
+void LaptopController::refreshProfile(bool restore){if(!restore&&staticActive())backendCall(QStringLiteral("Profile"),{m_options.value("refreshProfile").toString()});}
+void LaptopController::profileError(const QString&reason){m_reason=reason;Q_EMIT stateChanged();}
+
+QString LaptopController::keyLabel(uint code,const QString&fallback)const{
+ if(!fallback.isEmpty())return fallback;
+ if(code==KEY_SPACE)return layoutName();
+ char text[128]{};if(m_state&&xkb_keysym_to_utf8(xkb_state_key_get_one_sym(m_state.get(),code+8),text,sizeof(text))>1)return QString::fromUtf8(text);return QStringLiteral("·");
+}
+QStringList LaptopController::alternatives(const QString&text)const{
+ static const QHash<QString,QString> values{{"a","áàâäãåæā"},{"e","éèêëē"},{"i","ıíìîïī"},{"ı","iíìîï"},{"o","öóòôõøœō"},{"u","üúùûū"},{"c","çćč"},{"g","ğǧ"},{"s","şßśš"},{"n","ñń"},{"y","ýÿ"},{"z","źžż"}};
+ const QString variants=values.value(text.toLower());QStringList result;for(QChar c:variants)result.append(text==text.toUpper()?QString(c).toUpper():QString(c));return result;
+}
+QVariantMap LaptopController::status()const{return {{"active",active()},{"dynamic",dynamicActive()},{"available",available()},{"canRequest",canRequest()},{"entryPending",entryPending()},{"postureKnown",m_posture.known()},{"postureAllowed",m_posture.allowed()},{"inclination",m_posture.angle().value_or(0.0)},{"postureRequested",m_postureMonitor&&m_postureMonitor->requested()},{"ready",m_ready},{"reason",m_reason},{"density",pixelsPerMm()},{"usbKeyboardKnown",m_usbKeyboardKnown},{"usbKeyboardPresent",m_usbKeyboardPresent},{"presentation",m_options.value(QStringLiteral("presentation"))},{"staticAutoShow",m_options.value(QStringLiteral("staticAutoShow"))},{"pointerAcceleration",m_options.value(QStringLiteral("pointerAcceleration"))},{"pixelShiftEnabled",m_pixelShift.active()},{"pixelShiftX",m_pixelShift.offset().x()},{"pixelShiftY",m_pixelShift.offset().y()}};}
+void LaptopController::refreshRemote(){
+ auto*w=new QDBusPendingCallWatcher(m_bus.asyncCall(QDBusMessage::createMethodCall(QStringLiteral("org.uke.plasma.keyboard"),QStringLiteral("/Laptop"),QStringLiteral("org.uke.PlasmaKeyboard.Control1"),QStringLiteral("status"))),this);
+ connect(w,&QDBusPendingCallWatcher::finished,this,[this](auto*call){QDBusPendingReply<QVariantMap>r=*call;if(!r.isError()){const auto p=r.value();m_active=p.value("active").toBool();m_dynamic=p.value("dynamic").toBool();m_ready=p.value("ready").toBool();m_remoteAvailable=p.value("available").toBool();m_remotePending=p.value("entryPending").toBool();m_remoteCanRequest=p.value("canRequest",m_remoteAvailable).toBool();m_available=m_remoteCanRequest;m_usbKeyboardKnown=p.value("usbKeyboardKnown").toBool();m_usbKeyboardPresent=p.value("usbKeyboardPresent").toBool();m_locked=false;m_lidClosed=false;m_reason=p.value("reason").toString();m_remoteDensity=p.value("density").toDouble();}else m_reason=i18nd("uke-plasma-keyboard-custom", "Select and start Uke Plasma Keyboard to control laptop mode. Layout and appearance settings can be changed now.");Q_EMIT stateChanged();call->deleteLater();});
+}
+QVariantList LaptopController::emojiMatches(const QString&query)const{
+ struct Entry{QString emoji,name;};
+ static QList<Entry> entries;
+ static QHash<QString,QString> turkish;
+ if(entries.isEmpty()){
+  QFile annotations(QStandardPaths::locate(QStandardPaths::GenericDataLocation,QStringLiteral("uke-plasma-keyboard-custom/emoji/tr.xml")));
+  if(annotations.open(QIODevice::ReadOnly)){QXmlStreamReader xml(&annotations);while(!xml.atEnd()){xml.readNext();if(xml.isStartElement()&&xml.name()==QLatin1String("annotation")){const QString cp=xml.attributes().value(QLatin1String("cp")).toString();turkish[cp]+=QStringLiteral(" ")+xml.readElementText();}}}
+  QFile file(QStandardPaths::locate(QStandardPaths::GenericDataLocation,QStringLiteral("uke-plasma-keyboard-custom/emoji/emoji-test.txt")));
+  if(file.open(QIODevice::ReadOnly|QIODevice::Text))while(!file.atEnd()){
+   const QString line=QString::fromUtf8(file.readLine());
+   if(!line.contains(QLatin1String("; fully-qualified")))continue;
+   const QString metadata=line.section('#',1).trimmed();const int space=metadata.indexOf(' ');if(space<0)continue;
+   const QString emoji=metadata.left(space);const QString name=metadata.mid(space+1).section(' ',1).trimmed();
+   entries.append({emoji,name});
+  }
+ }
+ QVariantList result;const QString needle=query.trimmed().toCaseFolded();
+ for(const auto&e:entries)if(needle.isEmpty()||e.name.toCaseFolded().contains(needle)||turkish.value(e.emoji).toCaseFolded().contains(needle)||e.emoji==needle){result.append(QVariantMap{{"emoji",e.emoji},{"name",e.name}});if(result.size()>=120)break;}
+ return result;
+}
