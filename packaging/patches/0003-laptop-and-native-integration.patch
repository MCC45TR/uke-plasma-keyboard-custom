--- /dev/null
+++ b/src/laptop/tabletposture.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cmath>
+#include <optional>
+
+namespace UkeKeyboard {
+// Session policy for a fresh, screen-relative gravity observation. In-plane
+// display rotation never changes the angle between the screen and horizontal.
+class TabletPosture {
+public:
+    bool known() const { return m_angle.has_value(); }
+    bool allowed() const { return known() && m_allowed; }
+    std::optional<double> angle() const { return m_angle; }
+    void reset() { m_angle.reset(); m_allowed = false; m_waitForFlat = false; }
+
+    bool update(std::optional<double> angle) {
+        const bool wasKnown = known(), wasAllowed = allowed();
+        if (!angle || !std::isfinite(*angle) || *angle < 0 || *angle > 180) {
+            m_angle.reset(); m_allowed = false;
+        } else {
+            m_angle = angle;
+            if (*angle > 45) m_waitForFlat = true;
+            else if (*angle < 40) m_waitForFlat = false;
+            m_allowed = !m_waitForFlat && *angle <= 45;
+        }
+        return known() != wasKnown || allowed() != wasAllowed;
+    }
+
+private:
+    std::optional<double> m_angle;
+    bool m_allowed = false, m_waitForFlat = false;
+};
+}
diff --git a/src/laptop/tabletposturemonitor.cpp b/src/laptop/tabletposturemonitor.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c77537ee90645ce1e25c663806aec19de1c670a8
--- /dev/null
+++ b/src/laptop/tabletposturemonitor.cpp
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "tabletposturemonitor.h"
+
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusServiceWatcher>
+#include <QLoggingCategory>
+#include <QUuid>
+#include <algorithm>
+#include <cmath>
+#include <ctime>
+
+namespace {
+Q_LOGGING_CATEGORY(postureLog, "uke.keyboard.posture", QtWarningMsg)
+constexpr auto service = "org.senemos.Uke.Motion1";
+constexpr auto path = "/org/senemos/Uke/Motion1";
+constexpr auto interface = "org.senemos.Uke.Motion1";
+constexpr qulonglong maximumDeliveryAgeUsec = 2000000;
+
+qulonglong boottimeUsec() {
+    timespec time{};
+    if (clock_gettime(CLOCK_BOOTTIME, &time) != 0) return 0;
+    return qulonglong(time.tv_sec) * 1000000 + qulonglong(time.tv_nsec) / 1000;
+}
+
+bool freshTimestamp(qulonglong timestamp) {
+    const auto now = boottimeUsec();
+    return timestamp > 0 && now >= timestamp && now - timestamp <= maximumDeliveryAgeUsec;
+}
+
+QDBusMessage request(const QString &owner, const QString &method) {
+    auto message = QDBusMessage::createMethodCall(owner, QLatin1String(path), QLatin1String(interface), method);
+    message.setAutoStartService(false);
+    return message;
+}
+}
+
+// Each lease gets its own receiver and unique bus connection. Queued signals
+// and late replies from a released lease cannot be mistaken for a new claim.
+class PostureSignals final : public QObject {
+    Q_OBJECT
+public:
+    using QObject::QObject;
+public Q_SLOTS:
+    void changed(bool known, double angle, qulonglong timestamp, const QDBusMessage &message) {
+        Q_EMIT received(known, angle, timestamp, message.service());
+    }
+Q_SIGNALS:
+    void received(bool known, double angle, qulonglong timestamp, const QString &owner);
+};
+
+TabletPostureMonitor::TabletPostureMonitor(QObject *parent)
+    : QObject(parent), m_watchBus(QDBusConnection::systemBus()) {
+    auto *watcher = new QDBusServiceWatcher(QLatin1String(service), m_watchBus,
+                                           QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(watcher, &QDBusServiceWatcher::serviceOwnerChanged, this,
+            [this](const QString &, const QString &, const QString &owner) {
+        qCDebug(postureLog) << "Provider changed" << "requested" << m_requested << "owner present" << !owner.isEmpty();
+        if (!m_requested) return;
+        closeConnection();
+        if (!owner.isEmpty()) openConnection(owner);
+    });
+    m_watchBus.connect(QStringLiteral("org.freedesktop.login1"), QStringLiteral("/org/freedesktop/login1"),
+                       QStringLiteral("org.freedesktop.login1.Manager"), QStringLiteral("PrepareForSleep"),
+                       this, SLOT(preparingSleep(bool)));
+}
+
+TabletPostureMonitor::~TabletPostureMonitor() { closeConnection(); }
+
+void TabletPostureMonitor::setRequested(bool requested) {
+    if (m_requested == requested) return;
+    m_requested = requested;
+    if (requested) openConnection();
+    else closeConnection();
+}
+
+void TabletPostureMonitor::retry() {
+    if (m_requested && !m_claimBus) openConnection();
+}
+
+void TabletPostureMonitor::preparingSleep(bool sleeping) {
+    if (m_sleeping == sleeping) return;
+    m_sleeping = sleeping;
+    if (sleeping) closeConnection();
+    else if (m_requested) openConnection();
+}
+
+void TabletPostureMonitor::invalidate() {
+    if (!m_known) return;
+    m_known = false;
+    Q_EMIT observation(false, 0);
+}
+
+void TabletPostureMonitor::closeConnection() {
+    qCDebug(postureLog) << "Closing lease" << "claimed" << m_claimed << "known" << m_known;
+    ++m_generation;
+    m_claimed = false;
+    m_pendingSample.reset();
+    m_lastTimestamp = m_pendingTimestamp = 0;
+    if (m_signalReceiver) { m_signalReceiver->disconnect(this); m_signalReceiver->deleteLater(); }
+    m_signalReceiver = nullptr;
+    // Remove watchers before dropping their connection references. The ordered
+    // Release is best effort; NameOwnerChanged is the provider's crash fallback.
+    const auto calls = findChildren<QDBusPendingCallWatcher *>(QString(), Qt::FindDirectChildrenOnly);
+    for (auto *call : calls) { call->disconnect(this); call->deleteLater(); }
+    if (m_claimBus) {
+        if (!m_owner.isEmpty()) m_claimBus->send(request(m_owner, QStringLiteral("Release")));
+        QDBusConnection::disconnectFromBus(m_connectionName);
+        m_claimBus.reset();
+    }
+    m_connectionName.clear();
+    m_owner.clear();
+    invalidate();
+}
+
+void TabletPostureMonitor::openConnection(const QString &owner) {
+    if (!m_requested || m_sleeping || m_claimBus) return;
+    const auto generation = ++m_generation;
+    m_connectionName = QStringLiteral("uke-keyboard-posture-") + QUuid::createUuid().toString(QUuid::Id128);
+    m_claimBus = std::make_unique<QDBusConnection>(QDBusConnection::connectToBus(QDBusConnection::SystemBus, m_connectionName));
+    if (!m_claimBus->isConnected()) { closeConnection(); return; }
+    if (owner.isEmpty()) resolveOwner(generation, true);
+    else claim(owner, generation);
+}
+
+void TabletPostureMonitor::resolveOwner(quint64 generation, bool activate) {
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.DBus"), QStringLiteral("/org/freedesktop/DBus"),
+                                                  QStringLiteral("org.freedesktop.DBus"), QStringLiteral("GetNameOwner"));
+    message << QString::fromLatin1(service);
+    auto *call = new QDBusPendingCallWatcher(m_claimBus->asyncCall(message, 2000), this);
+    connect(call, &QDBusPendingCallWatcher::finished, this, [this, generation, activate](auto *finished) {
+        const auto reply = finished->reply();
+        finished->deleteLater();
+        if (generation != m_generation) return;
+        qCDebug(postureLog) << "Owner query" << reply.type() << reply.signature() << reply.errorName();
+        if (reply.type() == QDBusMessage::ReplyMessage && reply.signature() == QLatin1String("s")) {
+            claim(reply.arguments().first().toString(), generation);
+        } else if (activate && reply.errorName() == QLatin1String("org.freedesktop.DBus.Error.NameHasNoOwner")) {
+            auto start = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.DBus"), QStringLiteral("/org/freedesktop/DBus"),
+                                                        QStringLiteral("org.freedesktop.DBus"), QStringLiteral("StartServiceByName"));
+            start << QString::fromLatin1(service) << uint(0);
+            auto *pending = new QDBusPendingCallWatcher(m_claimBus->asyncCall(start, 2000), this);
+            connect(pending, &QDBusPendingCallWatcher::finished, this, [this, generation](auto *started) {
+                const bool success = started->reply().type() == QDBusMessage::ReplyMessage;
+                started->deleteLater();
+                if (generation != m_generation) return;
+                if (success) resolveOwner(generation, false);
+                else closeConnection();
+            });
+        } else closeConnection();
+    });
+}
+
+void TabletPostureMonitor::claim(const QString &owner, quint64 generation) {
+    if (generation != m_generation || !owner.startsWith(QLatin1Char(':'))) return;
+    m_owner = owner;
+    auto *receiver = new PostureSignals(this);
+    m_signalReceiver = receiver;
+    connect(receiver, &PostureSignals::received, this, [this, generation](bool known, double angle, qulonglong timestamp, const QString &sender) {
+        if (generation != m_generation || sender != m_owner) return;
+        const Sample sample{known, angle, timestamp};
+        if (!m_claimed) {
+            const bool fresh = freshTimestamp(timestamp);
+            if (!known || !fresh || !std::isfinite(angle) || angle < 0 || angle > 180) {
+                // Unknown may have no sample timestamp. It still revokes an
+                // initial snapshot, without erasing the replay barrier.
+                m_pendingSample = Sample{false, 0, timestamp};
+                if (fresh) m_pendingTimestamp = std::max(m_pendingTimestamp, timestamp);
+            } else if (timestamp > m_pendingTimestamp) {
+                m_pendingSample = sample;
+                m_pendingTimestamp = timestamp;
+            }
+        }
+        else accept(sample);
+    });
+    if (!m_claimBus->connect(owner, QLatin1String(path), QLatin1String(interface), QStringLiteral("PostureChanged"),
+                            QStringLiteral("bdt"), receiver, SLOT(changed(bool,double,qulonglong,QDBusMessage)))) {
+        closeConnection(); return;
+    }
+    auto *call = new QDBusPendingCallWatcher(m_claimBus->asyncCall(request(owner, QStringLiteral("Claim")), 2000), this);
+    connect(call, &QDBusPendingCallWatcher::finished, this, [this, generation](auto *finished) {
+        const auto reply = finished->reply();
+        finished->deleteLater();
+        qCDebug(postureLog) << "Claim reply" << reply.type() << reply.signature() << "current generation" << (generation == m_generation) << reply.errorName();
+        if (generation != m_generation) return;
+        // Qt deliberately returns an empty service() for replies. The pending
+        // call is addressed to the pinned unique peer; system-bus requested-
+        // reply policy and this ownership generation bind its response. Signal
+        // messages do expose the sender and keep their explicit owner check.
+        if (reply.type() != QDBusMessage::ReplyMessage || reply.signature() != QLatin1String("bdt")) {
+            closeConnection(); return;
+        }
+        m_claimed = true;
+        // A signal sent after subscription supersedes the initial snapshot,
+        // including an unknown/revocation edge that overtook its delayed reply.
+        const auto args = reply.arguments();
+        const Sample sample = m_pendingSample.value_or(Sample{args[0].toBool(), args[1].toDouble(), args[2].toULongLong()});
+        m_pendingSample.reset();
+        const auto barrier = m_pendingTimestamp;
+        m_pendingTimestamp = 0;
+        accept(sample, barrier);
+    });
+}
+
+void TabletPostureMonitor::accept(const Sample &sample, qulonglong replayBarrier) {
+    const auto previousTimestamp = m_lastTimestamp;
+    m_lastTimestamp = std::max(m_lastTimestamp, replayBarrier);
+    const bool fresh = freshTimestamp(sample.timestamp);
+    qCDebug(postureLog) << "Observation" << sample.known << "fresh" << fresh
+                        << "valid angle" << (std::isfinite(sample.angle) && sample.angle >= 0 && sample.angle <= 180)
+                        << "new sample" << (sample.timestamp > previousTimestamp);
+    if (!sample.known) {
+        if (fresh) m_lastTimestamp = std::max(m_lastTimestamp, sample.timestamp);
+        invalidate(); return;
+    }
+    if (!fresh) {
+        invalidate(); return;
+    }
+    if (sample.timestamp <= previousTimestamp) return;
+    m_lastTimestamp = std::max(m_lastTimestamp, sample.timestamp);
+    if (!std::isfinite(sample.angle) || sample.angle < 0 || sample.angle > 180) { invalidate(); return; }
+    m_known = true;
+    Q_EMIT observation(true, sample.angle);
+}
+
+#include "tabletposturemonitor.moc"
diff --git a/src/laptop/tabletposturemonitor.h b/src/laptop/tabletposturemonitor.h
new file mode 100644
index 0000000000000000000000000000000000000000..1f82f50894b496b83046d9ec69b5fa8938501f30
--- /dev/null
+++ b/src/laptop/tabletposturemonitor.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QDBusConnection>
+#include <QObject>
+#include <memory>
+#include <optional>
+
+class QDBusMessage;
+class QDBusServiceWatcher;
+
+// A demand-leased, unprivileged client. Hardware ownership and sample freshness
+// belong to the existing Control provider; there is no device access or poller.
+class TabletPostureMonitor final : public QObject {
+    Q_OBJECT
+public:
+    explicit TabletPostureMonitor(QObject *parent = nullptr);
+    ~TabletPostureMonitor() override;
+    void setRequested(bool requested);
+    void retry(); // Explicit user action after refusal; never an idle retry loop.
+    bool requested() const { return m_requested; }
+
+Q_SIGNALS:
+    void observation(bool known, double inclination);
+
+private Q_SLOTS:
+    void preparingSleep(bool sleeping);
+
+private:
+    struct Sample { bool known; double angle; qulonglong timestamp; };
+    void openConnection(const QString &owner = {});
+    void closeConnection();
+    void resolveOwner(quint64 generation, bool activate);
+    void claim(const QString &owner, quint64 generation);
+    void accept(const Sample &sample, qulonglong replayBarrier = 0);
+    void invalidate();
+    QDBusConnection m_watchBus;
+    std::unique_ptr<QDBusConnection> m_claimBus;
+    QObject *m_signalReceiver = nullptr;
+    QString m_connectionName, m_owner;
+    std::optional<Sample> m_pendingSample;
+    quint64 m_generation = 0;
+    qulonglong m_lastTimestamp = 0, m_pendingTimestamp = 0;
+    bool m_requested = false, m_claimed = false, m_known = false, m_sleeping = false;
+};
diff --git a/src/laptop/touchpadmotion.h b/src/laptop/touchpadmotion.h
new file mode 100644
index 0000000000000000000000000000000000000000..f79ea48f3cdcc21f53735d4b0ae201bf65ca3d36
--- /dev/null
+++ b/src/laptop/touchpadmotion.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QPointF>
+#include <QtGlobal>
+#include <algorithm>
+#include <cmath>
+
+namespace UkeKeyboard {
+class TouchpadMotion {
+public:
+    void reset(qint64 timestampUs=-1) {m_last=timestampUs;m_velocity=0;m_direction={};}
+    QPointF map(QPointF millimetres,qint64 timestampUs,bool accelerated=true) {
+        if(!std::isfinite(millimetres.x())||!std::isfinite(millimetres.y())){reset(timestampUs);return {};}
+        const auto elapsed=m_last>=0?timestampUs-m_last:8333;
+        const double seconds=std::clamp(double(elapsed)/1000000.0,0.001,0.25);
+        if(elapsed<=0||elapsed>120000||QPointF::dotProduct(millimetres,m_direction)<0)m_velocity=0;
+        m_last=timestampUs;
+        const double speed=std::hypot(millimetres.x(),millimetres.y())/seconds;
+        if(speed<m_velocity*0.25)m_velocity=speed;
+        else m_velocity+=(speed-m_velocity)*(1-std::exp(-seconds/0.025));
+        if(!millimetres.isNull())m_direction=millimetres;
+        const double t=std::clamp((m_velocity-12.0)/130.0,0.0,1.0);
+        // Preserve the existing precision gain; fast swipes smoothly gain up
+        // to five times that distance. Never round or introduce a dead zone.
+        const double gain=8.0+(accelerated?32.0*t*t*(3.0-2.0*t):0.0);
+        return millimetres*gain;
+    }
+private:
+    qint64 m_last=-1;
+    double m_velocity=0;
+    QPointF m_direction;
+};
+}
