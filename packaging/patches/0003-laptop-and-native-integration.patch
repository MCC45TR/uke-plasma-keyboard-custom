+ connect(&m_files,&QFileSystemWatcher::directoryChanged,this,[this](const QString &path){reload();loadLayouts();if(path==QLatin1String("/usr/share/hunspell"))Q_EMIT layoutChanged();});
+ m_bus.connect(QStringLiteral("org.kde.keyboard"),QStringLiteral("/Layouts"),QStringLiteral("org.kde.KeyboardLayouts"),QStringLiteral("layoutChanged"),this,SLOT(systemLayout(uint)));
+ auto *lock=SessionLockState::instance();
+ connect(lock,&SessionLockState::stateChanged,this,[this,lock]{m_locked=!lock->isKnown()||lock->isLocked()||lock->isPreparingLock();if(m_locked){leave(false);releaseAll();}else if(!m_ready&&!m_preferencesOnly&&!qEnvironmentVariableIsSet("PLASMA_KEYBOARD_TEST_MODE"))connectBackend();updateEligibility();});
+ m_locked=!lock->isKnown()||lock->isLocked();
+ m_preferencesOnly=QCoreApplication::arguments().contains(QStringLiteral("--preferences"));
+ if(m_preferencesOnly){
+  m_bus.connect(QStringLiteral("org.uke.plasma.keyboard"),QStringLiteral("/Laptop"),QStringLiteral("org.uke.PlasmaKeyboard.Control1"),QStringLiteral("stateChanged"),this,SLOT(refreshRemote()));
+  refreshRemote();return;
+ }
+ if(qEnvironmentVariableIsSet("PLASMA_KEYBOARD_TEST_MODE"))return;
+ m_postureMonitor=std::make_unique<TabletPostureMonitor>();
+ connect(m_postureMonitor.get(),&TabletPostureMonitor::observation,this,&LaptopController::postureObserved);
+ m_bus.registerService(QStringLiteral("org.uke.plasma.keyboard"));
+ auto *adaptor=new KeyboardControlAdaptor(this,[this]{return status();},[this]{toggle();});
+ connect(this,&LaptopController::stateChanged,adaptor,&KeyboardControlAdaptor::stateChanged);
+ adaptor->publish(m_bus,QStringLiteral("/Laptop"));
+ auto system=QDBusConnection::systemBus();
+ system.connect(QStringLiteral("org.freedesktop.UPower"),QStringLiteral("/org/freedesktop/UPower"),QStringLiteral("org.freedesktop.DBus.Properties"),QStringLiteral("PropertiesChanged"),this,SLOT(propertiesChanged(QString,QVariantMap,QStringList)));
+ auto *powerWatcher=new QDBusServiceWatcher(QStringLiteral("org.freedesktop.UPower"),system,QDBusServiceWatcher::WatchForOwnerChange,this);
+ connect(powerWatcher,&QDBusServiceWatcher::serviceOwnerChanged,this,[this](const auto&,const auto&,const QString&owner){++m_lidGeneration;m_lidClosed=true;updateTopology();if(!owner.isEmpty())queryLid();});
+ queryLid();
+ m_bus.connect(QLatin1String(UkeKeyboard::service),QLatin1String(UkeKeyboard::path),QLatin1String(UkeKeyboard::interface),QStringLiteral("StaticChanged"),this,SLOT(backendStatic(bool)));
+ m_bus.connect(QLatin1String(UkeKeyboard::service),QLatin1String(UkeKeyboard::path),QLatin1String(UkeKeyboard::interface),QStringLiteral("DynamicChanged"),this,SLOT(backendDynamic(bool)));
+ m_bus.connect(QLatin1String(UkeKeyboard::service),QLatin1String(UkeKeyboard::path),QLatin1String(UkeKeyboard::interface),QStringLiteral("UsbKeyboardChanged"),this,SLOT(usbKeyboardChanged(bool)));
+ m_bus.connect(QLatin1String(UkeKeyboard::service),QLatin1String(UkeKeyboard::path),QLatin1String(UkeKeyboard::interface),QStringLiteral("ProfileError"),this,SLOT(profileError(QString)));
+ m_bus.connect(QLatin1String(UkeKeyboard::service),QLatin1String(UkeKeyboard::path),QLatin1String(UkeKeyboard::interface),QStringLiteral("Locks"),this,SLOT(syncLocks(bool,bool,bool)));
+ auto *watcher=new QDBusServiceWatcher(QLatin1String(UkeKeyboard::service),m_bus,QDBusServiceWatcher::WatchForOwnerChange,this);
+ connect(watcher,&QDBusServiceWatcher::serviceOwnerChanged,this,[this](const auto&,const auto&,const QString &owner){++m_backendGeneration;m_ready=false;m_backendOwner.clear();if(owner.isEmpty()){leave(false);m_reason=i18nd("uke-plasma-keyboard-custom", "The KWin integration is unavailable or needs rebuilding for this KWin version.");updateEligibility();}else connectBackend();});
+ loadBackend();
+ requestTopology();
+ connect(KScreen::ConfigMonitor::instance(),&KScreen::ConfigMonitor::configurationChanged,this,&LaptopController::updateTopology);
+ const auto watchScreen=[this](QScreen *screen){
+  connect(screen,&QScreen::geometryChanged,this,[this]{if(m_active)releaseAll();Q_EMIT stateChanged();});
+  connect(screen,&QScreen::physicalSizeChanged,this,[this]{Q_EMIT stateChanged();});
+ };
+ for(auto *screen:qGuiApp->screens())watchScreen(screen);
+ connect(qGuiApp,&QGuiApplication::screenAdded,this,[this,watchScreen](QScreen *screen){watchScreen(screen);updateTopology();});
+ connect(qGuiApp,&QGuiApplication::screenRemoved,this,[this]{updateTopology();});
+}
+LaptopController::~LaptopController(){if(m_postureMonitor){m_postureMonitor->disconnect(this);m_postureMonitor.reset();}leave(false);releaseAll();if(s_instance==this)s_instance=nullptr;}
+void LaptopController::queryLid(){
+ const auto generation=++m_lidGeneration;
+ auto request=QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.UPower"),QStringLiteral("/org/freedesktop/UPower"),QStringLiteral("org.freedesktop.DBus.Properties"),QStringLiteral("GetAll"));request<<QStringLiteral("org.freedesktop.UPower");
+ auto *watcher=new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(request),this);
+ connect(watcher,&QDBusPendingCallWatcher::finished,this,[this,generation](auto *call){
+  QDBusPendingReply<QVariantMap> reply=*call;call->deleteLater();if(generation!=m_lidGeneration||reply.isError())return;
+  const auto properties=reply.value();
+  if(!properties.contains("LidIsPresent")||!properties.contains("LidIsClosed"))return;
+  m_lidClosed=properties.value("LidIsPresent").toBool()&&properties.value("LidIsClosed").toBool();updateTopology();
+ });
+}
+void LaptopController::loadBackend(){
+ auto request=QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),QStringLiteral("/Plugins"),QStringLiteral("org.freedesktop.DBus.Properties"),QStringLiteral("Get"));request<<QStringLiteral("org.kde.KWin.Plugins")<<QStringLiteral("LoadedPlugins");
+ auto *reader=new QDBusPendingCallWatcher(m_bus.asyncCall(request),this);
+ connect(reader,&QDBusPendingCallWatcher::finished,this,[this](auto*w){
+  QDBusPendingReply<QDBusVariant> reply=*w;w->deleteLater();QStringList owned;
+  if(!reply.isError())for(const auto&id:qdbus_cast<QStringList>(reply.value().variant()))
+   if(id==QLatin1String("uke_keyboard_backend")||id.startsWith(QLatin1String("uke_keyboard_backend_")))owned.append(id);
+  replaceBackend(owned);
+ });
+}
+void LaptopController::replaceBackend(QStringList remaining){
+ if(!remaining.isEmpty()) {
+  auto request=QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),QStringLiteral("/Plugins"),QStringLiteral("org.kde.KWin.Plugins"),QStringLiteral("UnloadPlugin"));request<<remaining.takeFirst();
+  auto *unloader=new QDBusPendingCallWatcher(m_bus.asyncCall(request),this);
+  connect(unloader,&QDBusPendingCallWatcher::finished,this,[this,remaining](auto*w){w->deleteLater();replaceBackend(remaining);});
+  return;
+ }
+ auto request=QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),QStringLiteral("/Plugins"),QStringLiteral("org.kde.KWin.Plugins"),QStringLiteral("LoadPlugin"));request<<QLatin1String(UkeKeyboard::pluginId);
+ auto *loader=new QDBusPendingCallWatcher(m_bus.asyncCall(request),this);
+ connect(loader,&QDBusPendingCallWatcher::finished,this,[this](auto*w){w->deleteLater();connectBackend();});
+}
+void LaptopController::connectBackend(){
+ const auto generation=++m_backendGeneration;
+ m_ready=false;m_backendOwner.clear();m_usbKeyboardKnown=false;++m_usbKeyboardGeneration;
+ m_reason=i18nd("uke-plasma-keyboard-custom", "Select Uke Plasma Keyboard in System Settings. Its matching KWin integration must be installed.");
+ auto *bus=m_bus.interface();
+ if(!bus){updateTopology();return;}
+ const auto owner=bus->serviceOwner(QLatin1String(UkeKeyboard::service));
+ if(!owner.isValid()||owner.value().isEmpty()){updateTopology();return;}
+ const auto pid=bus->servicePid(owner.value());
+ if(!pid.isValid()||pid.value()!=uint(getppid())){updateTopology();return;}
+ m_backendOwner=owner.value();
+ auto *w=new QDBusPendingCallWatcher(backendCall(QStringLiteral("Attach")),this);
+ connect(w,&QDBusPendingCallWatcher::finished,this,[this,generation](auto*call){
+  QDBusPendingReply<bool> reply=*call;call->deleteLater();if(generation!=m_backendGeneration)return;
+  m_ready=!reply.isError()&&reply.value();
+  if(m_ready){
+   queryUsbKeyboard();
+   auto*locks=new QDBusPendingCallWatcher(backendCall(QStringLiteral("Locks")),this);
+   connect(locks,&QDBusPendingCallWatcher::finished,this,[this,generation](auto*w){
+    QDBusPendingReply<QVariantMap>r=*w;w->deleteLater();if(generation!=m_backendGeneration||r.isError())return;
+    const auto p=r.value();syncLocks(p.value("caps").toBool(),p.value("num").toBool(),p.value("scroll").toBool());
+   });
+  }
+  updateTopology();
+ });
+}
+void LaptopController::queryUsbKeyboard(){
+ const auto backend=m_backendGeneration;
+ const auto generation=++m_usbKeyboardGeneration;
+ auto*w=new QDBusPendingCallWatcher(backendCall(QStringLiteral("Capabilities")),this);
+ connect(w,&QDBusPendingCallWatcher::finished,this,[this,backend,generation](auto*call){
+  QDBusPendingReply<QVariantMap>reply=*call;call->deleteLater();
+  if(backend!=m_backendGeneration||generation!=m_usbKeyboardGeneration)return;
+  const auto properties=reply.isError()?QVariantMap():reply.value();
+  const auto present=properties.value(QStringLiteral("usbKeyboardPresent"));
+  m_usbKeyboardKnown=present.metaType()==QMetaType::fromType<bool>();
+  m_usbKeyboardPresent=m_usbKeyboardKnown&&present.toBool();if(m_config)updateTopology();else updateEligibility();
+ });
